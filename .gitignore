# --- Meta / env ---
.env
.env.*
!.env.example
*.local
docker-compose.override.yml
docker-compose.override.yaml

# --- Odoo runtime (never commit) ---
*.conf
!odoo.conf.example
!*.conf.example
*.log
*.filestore/
filestore/
sessions/
odoo-data/
data/
postgres-data/
backups/
*.dump
*.sql
*.sql.gz
*.zip

# --- Odoo dev artifacts ---
*.pyc
__pycache__/
*.pyo
*.pot
*.po~

# --- Python ---
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- custom_addons submodules: ignore pycache inside clones, gitlinks still tracked ---
custom_addons/*/__pycache__/
custom_addons/*/*.pyc

# --- Local Odoo checkout (not tracked by this repo) ---
/odoo/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs: ignore fully ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
