<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="view_ps_te_settlement_wizard" model="ir.ui.view">
    <field name="name">ps.te.settlement.wizard.form</field><field name="model">ps.te.settlement.wizard</field>
    <field name="arch" type="xml"><form string="Settlement Operation"><group>
        <field name="settlement_id"/><field name="expected_revision"/><field name="operation"/><field name="currency_id" invisible="1"/>
        <field name="amount" invisible="operation != 'record'" required="operation == 'record'"/>
        <field name="reference" invisible="operation not in ['none', 'start', 'not_executed', 'record']" required="operation in ['none', 'start', 'not_executed', 'record']"/>
        <field name="execution_date" invisible="operation != 'record'" required="operation == 'record'"/>
        <field name="reason" invisible="operation in ['submit', 'record']" required="operation not in ['submit', 'record']"/>
    </group><footer><button name="action_apply" type="object" string="Apply" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
</record></odoo>
