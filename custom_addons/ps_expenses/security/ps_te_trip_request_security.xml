        <field name="groups" eval="[(4, ref('group_ps_te_trip_employee'))]"/>
        <field name="domain_force">[('advance_id.owner_id', '=', user.id), ('advance_id.company_id', 'in', company_ids), ('advance_id.trip_id.employee_id.active', '=', True), ('advance_id.trip_id.employee_id.user_id', '=', user.id), ('advance_id.trip_id.employee_mapping_valid', '=', True)]</field>
    </record>
    <record id="rule_ps_te_advance_event_finance" model="ir.rule">
        <field name="name">PS T&amp;E advance history: finance reviewer</field>
        <field name="model_id" ref="model_ps_te_advance_event"/>
        <field name="groups" eval="[(4, ref('group_ps_te_finance'))]"/>
        <field name="domain_force">[('advance_id.finance_reviewer_id', '=', user.id), ('advance_id.finance_assignment_valid', '=', True), ('advance_id.company_id', 'in', company_ids), ('advance_id.trip_id.employee_id.active', '=', True), ('advance_id.trip_id.employee_mapping_valid', '=', True)]</field>
    </record>
    <record id="rule_ps_te_advance_event_cash" model="ir.rule">
        <field name="name">PS T&amp;E advance history: cash operator</field>
        <field name="model_id" ref="model_ps_te_advance_event"/>
        <field name="groups" eval="[(4, ref('group_ps_te_cash'))]"/>
        <field name="domain_force">[('advance_id.cash_operator_id', '=', user.id), ('advance_id.cash_assignment_valid', '=', True), ('advance_id.company_id', 'in', company_ids), ('advance_id.trip_id.employee_id.active', '=', True), ('advance_id.trip_id.employee_mapping_valid', '=', True)]</field>
