        <field name="groups" eval="[(4, ref('group_ps_te_finance'))]"/>
        <field name="domain_force">[('advance_id.finance_reviewer_id', '=', user.id), ('advance_id.finance_assignment_valid', '=', True), ('company_id', 'in', company_ids), ('employee_id.active', '=', True), ('employee_mapping_valid', '=', True)]</field>
        <field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_ps_te_trip_cash" model="ir.rule">
        <field name="name">PS T&amp;E trip: assigned advance cash operator</field>
        <field name="model_id" ref="model_ps_te_trip_request"/>
        <field name="groups" eval="[(4, ref('group_ps_te_cash'))]"/>
        <field name="domain_force">[('advance_id.cash_operator_id', '=', user.id), ('advance_id.cash_assignment_valid', '=', True), ('company_id', 'in', company_ids), ('employee_id.active', '=', True), ('employee_mapping_valid', '=', True)]</field>
        <field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
</odoo>
