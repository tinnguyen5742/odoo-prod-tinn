<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ps_theme_company_color_assets" inherit_id="web.layout">
        <xpath expr="//head" position="inside">
            <t t-if="env and env.company and env.company.theme_primary_color">
                <t t-set="primary_color" t-value="env.company.theme_primary_color"/>
                <style id="ps_theme_company_color_style">
                    <![CDATA[
                        /* Chỉ áp dụng các biến màu này khi ở trang quản trị (có class o_web_client trên body) */
                        body.o_web_client, 
                        body.o_web_client [data-bs-theme="light"] {
                            --o-brand-odoo: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --o-brand-primary: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --primary: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --o-color-1: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --o-cc4-bg: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --o-navbar-bg: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --o-navbar-entry-bg: transparent !important;
                            --NavBar-background-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --NavBar-entry-color--hover: #FFFFFF !important;
                            --link-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --link-hover-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                        }

                        /* Chỉ tác dụng lên thanh navbar của trang quản trị admin */
                        body.o_web_client .o_main_navbar, 
                        body.o_web_client header.o_navbar, 
                        body.o_web_client nav.o_main_navbar {
                            background-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                        }

                        body.o_web_client .o_main_navbar .o_menu_brand,
                        body.o_web_client .o_main_navbar .o_menu_sections,
                        body.o_web_client .o_main_navbar .o_menu_sections > a,
                        body.o_web_client .o_main_navbar .o_menu_sections .dropdown-toggle,
                        body.o_web_client .o_main_navbar .o_nav_entry,
                        body.o_web_client .o_main_navbar .o_navbar_apps_menu {
                            background-color: transparent !important;
                        }

                        body.o_web_client .o_main_navbar .o_menu_sections > a:hover,
                        body.o_web_client .o_main_navbar .o_menu_sections .show > a {
                            background-color: rgba(255, 255, 255, 0.15) !important;
                        }

                        /* Chỉ đổi màu các nút bấm .btn-primary bên trong trang quản trị */
                        body.o_web_client .btn-primary, 
                        body.o_web_client .btn-check:checked + .btn-outline-primary {
                            --btn-bg: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --btn-border-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --btn-hover-bg: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --btn-hover-border-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --btn-active-bg: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            --btn-active-border-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            background-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                            border-color: ]]> <t t-out="primary_color"/> <![CDATA[ !important;
                        }
                    ]]>
                </style>
            </t>
        </xpath>
    </template>
</odoo>