<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_theme" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='company_details_settings']" position="after">
                <setting id="theme_primary_color_setting" string="Theme Primary Color" help="Màu chủ đạo giao diện công ty này">
                    <div class="content-group mt16">
                        <div class="d-flex align-items-center gap-2">
                            <field name="theme_primary_color" widget="color"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>