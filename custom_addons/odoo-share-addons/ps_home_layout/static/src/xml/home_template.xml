<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ps_home_layout.HomeDashboard" owl="1">
        <div class="o_ps_home_container w-100 h-100">
            <!-- Loading indicator -->
            <t t-if="!state.apps || state.apps.length === 0">
                <div class="text-center text-muted fs-5">
                    <i class="fa fa-circle-o-notch fa-spin me-2"/> Đang tải danh sách ứng dụng...
                </div>
            </t>

            <!-- Grid Apps -->
            <div t-else="" class="o_ps_apps_grid">
                <t t-foreach="state.apps" t-as="app" t-key="app.id || app.xmlid">
                    <div class="o_ps_app_item"
                         t-att-style="'animation-delay: ' + (app_index * 0.03) + 's;'"
                         t-on-click="() => this.openApp(app)">
                        <div class="o_app_icon_wrapper">
                            <img t-if="app.webIconData" 
                                 t-att-src="app.webIconData" 
                                 t-att-alt="app.name" 
                                 class="o_app_icon"/>
                            <i t-else="" class="fa fa-th-large fa-2x text-primary"/>
                        </div>
                        <span class="o_app_name">
                            <t t-esc="app.label || app.name"/>
                        </span>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>