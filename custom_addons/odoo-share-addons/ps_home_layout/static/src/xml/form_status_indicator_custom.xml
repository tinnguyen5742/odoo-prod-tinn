<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.FormStatusIndicator" t-inherit-mode="extension">
        
        <!-- 1. Nút Lưu (Save): Giữ nguyên thẻ button gốc của Odoo, chỉ đổi class sang hình tròn và ẩn text bên trong -->
        <xpath expr="//button[contains(@class, 'o_form_button_save')]" position="attributes">
            <attribute name="class">o_form_button_save btn btn-primary rounded-circle d-inline-flex align-items-center justify-content-center p-0 shadow-sm</attribute>
            <attribute name="style">width: 36px; height: 36px; min-width: 36px;</attribute>
            <attribute name="title">Lưu</attribute>
        </xpath>

        <!-- 2. Nút Huỷ bỏ (Discard): Giữ nguyên thẻ button gốc, chuyển thành icon tròn -->
        <xpath expr="//button[contains(@class, 'o_form_button_cancel')]" position="attributes">
            <attribute name="class">o_form_button_cancel btn btn-light border text-secondary rounded-circle d-inline-flex align-items-center justify-content-center p-0 ms-2 shadow-sm</attribute>
            <attribute name="style">width: 36px; height: 36px; min-width: 36px; background-color: #f8f9fa;</attribute>
            <attribute name="title">Huỷ bỏ</attribute>
        </xpath>

    </t>
</templates>