<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_res_config_settings_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.ps</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']" position="inside">
                <block title="Vietnam Address Conversion Settings" name="vn_address_setting_container">
                    <setting string="API Key"
                             help="API key used to convert addresses according to the administrative merger decision.">
                        <field name="tinhthanhpho_api_key" placeholder="Enter API key"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>