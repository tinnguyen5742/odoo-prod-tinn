<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="course_sidebar_inherit_evaluation" inherit_id="website_slides.course_sidebar">
        <xpath expr="//div[hasclass('o_wslides_sidebar_top')]" position="after">
            <t t-if="channel.is_member and channel.is_mandatory_evaluation and channel.course_evaluation_survey_id and not channel.has_completed_evaluation">
                <div class="o_ps_evaluation_required d-none"/>
                <t t-if="channel.completion == 100">
                    <div class="alert alert-warning mt-3 mb-0 text-center" role="alert">
                         <h6 class="mb-2 text-danger fw-bold">Mandatory Requirement!</h6>
                        <p class="mb-2 small">Please complete the Course Survey to finish the course and receive your certificate.</p>
                        <a t-attf-href="/ps_elearning/evaluation/#{channel.id}" class="btn btn-primary text-white">
                            <i class="fa fa-pencil-square-o me-1"/><t>Take Survey</t>
                        </a>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>