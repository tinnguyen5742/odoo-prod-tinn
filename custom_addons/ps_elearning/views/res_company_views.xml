<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_company_view_form_inherit_ps_elearning" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.ps.elearning</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Thiết lập chứng nhận eLearning" name="ps_elearning_cert">
                    <group class="col-lg-12" col="2">
                        <group class="col-lg-6">
                            <field name="logo" widget="image" preview="180,80" style="width:100px"/>
                        </group>
                        <group class="col-lg-6">
                            <field name="cert_signature" widget="image" preview="220,140" style="width:80px"/>
                        </group>
                    </group>
                    <group class="col-lg-12" col="2">
                        <group class="col-lg-6">
                           <field name="cert_company_name" placeholder="VD: Công ty ABC"/>
                        </group>
                        <group class="col-lg-6">
                            <field name="cert_secondary_color" widget="color" style="width:100px !important"/>
                        </group>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
