<odoo>
    <record id="slide_channel_view_form_discuss" model="ir.ui.view">
        <field name="name">slide.channel.view.form.discuss</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">

            <!-- Thêm field ẩn để invisible hoạt động -->
            <xpath expr="//sheet" position="before">
                <field name="x_discuss_channel_id" invisible="1"/>
            </xpath>
            
            <xpath expr="//sheet/div[1]" position="before">
                <group>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                </group>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <widget name="ai_chat_button"/>
            </xpath>

            <!-- Thêm button vào header -->
            <xpath expr="//header" position="inside">
                <button
                        name="action_create_elearning_channel"
                        string="Create Elearning Chat"
                        type="object"
                        class="btn-primary"
                        invisible="x_discuss_channel_id != False"
                />
                <button
                        name="action_open_elearning_channel"
                        string="Open Chat "
                        type="object"
                        class="btn-secondary"
                        invisible="x_discuss_channel_id == False"
                />
            </xpath>

            <xpath expr="//field[@name='visibility']" position="after">
                <field name="is_mandatory_for_new_employee"/>
            </xpath>

            <xpath expr="//field[@name='enroll']" position="after">
                <field name="department_ids" widget="many2many_tags"/>
            </xpath>

            <xpath expr="//page[@name='options']" position="inside">
                <group string="Course Evaluation" name="course_evaluation">
                    <field name="course_evaluation_survey_id"/>
                    <!-- Chỉ hiển thị nút check bắt buộc nếu có chọn bài khảo sát -->
                    <field name="is_mandatory_evaluation" invisible="not course_evaluation_survey_id"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>