<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_inherit_mandatory_course" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.mandatory.course</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='recruitment_page']" position="after">
                <page name="training_courses" string="Training Courses">
                    <group>
                        <field name="mandatory_course_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>