<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Override form survey khi ĐANG LÀM BÀI (in_progress)
        - Thêm CSS variables màu brand lên form
        - Bọc mỗi câu hỏi trong card kính mờ (qua class + SCSS)
    -->

    <!-- 1. Thêm class + CSS variables màu brand lên form chính -->
    <template id="survey_fill_form_inherit_ps"
              name="Patsoft - Survey form wrapper"
              inherit_id="survey.survey_fill_form">

        <xpath expr="//form[hasclass('o_survey-fill-form')]" position="attributes">
            <attribute name="class">o_survey-fill-form o_ps_survey_form d-flex flex-grow-1 align-items-center</attribute>
            <attribute name="t-att-style">'--ps-primary: ' + (request.env.company.cert_primary_hex or '#006b2e') + '; --ps-secondary: ' + (request.env.company.cert_secondary_color or '#d4af37') + ';'</attribute>
        </xpath>

        <!-- Thêm class cho content wrapper -->
        <xpath expr="//div[hasclass('o_survey_form_content')]" position="attributes">
            <attribute name="class">o_survey_form_content o_ps_form_content w-100</attribute>
        </xpath>
    </template>

    <!-- 2. Thêm class card vào question_container
         (dùng contains @t-attf-class vì class là dynamic) -->
    <template id="question_container_inherit_ps"
              name="Patsoft - Question card"
              inherit_id="survey.question_container">

        <xpath expr="//div[contains(@t-attf-class, 'js_question-wrapper')]" position="attributes">
            <attribute name="t-attf-class">js_question-wrapper o_ps_question_card pb-4
                #{'d-none' if not display_question else ''}
                #{'me-2' if extra_right_margin else ''}</attribute>
        </xpath>
    </template>

    <!-- 3. Thêm class card vào section wrapper (one_page layout)
         (dùng contains @t-attf-class vì class là dynamic) -->
    <template id="survey_fill_form_in_progress_inherit_ps"
              name="Patsoft - Survey in progress sections"
              inherit_id="survey.survey_fill_form_in_progress">

        <xpath expr="//div[contains(@t-attf-class, 'js_section_wrapper')]" position="attributes">
            <attribute name="t-attf-class">js_section_wrapper o_ps_section_card #{'d-none' if not display_section else ''}</attribute>
        </xpath>
    </template>
</odoo>