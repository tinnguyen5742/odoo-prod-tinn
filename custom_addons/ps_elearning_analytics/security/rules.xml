<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_elearning_training_report_employee" model="ir.rule">
        <field name="name">Employees: own eLearning progress</field>
        <field name="model_id" ref="model_elearning_training_report"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_elearning_training_report_officer" model="ir.rule">
        <field name="name">eLearning Officers: courses they manage</field>
        <field name="model_id" ref="model_elearning_training_report"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('website_slides.group_website_slides_officer'))]"/>
    </record>
    <record id="rule_elearning_training_report_hr_manager" model="ir.rule">
        <field name="name">eLearning HR Managers: all progress</field>
        <field name="model_id" ref="model_elearning_training_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_elearning_hr_manager'))]"/>
    </record>
</odoo>
