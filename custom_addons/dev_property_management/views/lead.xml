<odoo>

	<record id="dev_crm_lead_list" model="ir.ui.view">
        <field name="name">dev.crm.lead.list.view</field>
        <field name="model">crm.lead</field>
         <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="before">
                      <field name="number"/>
              </xpath>           
        </field>
    </record>

    <record id="dev_crm_lead_form_inherit" model="ir.ui.view">
        <field name="name">dev.crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//div[@name='button_box']" position="inside">
                 <button name="action_view_booking" type="object" class="oe_stat_button" icon="fa-book" invisible="booking_count == 0">
                    <field name="booking_count" widget="statinfo" string="Bookings"/>
                </button>
             </xpath>
        </field>
    </record>
    
     <record id="action_dev_property_lead" model="ir.actions.act_window">
        <field name="name">Inquiry</field>
        <field name="domain">[('property_id', '!=', False),('type','=','lead')]</field>
        <field name="context">{'default_type':'lead','search_default_type': 'lead','search_default_to_process':1,}</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form,kanban,graph,pivot,activity</field>
        <field name="help" type="html">
            <p>
                Create a Lead
            </p>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="action_dev_opportunity">
            <field name="name">Opportunity</field>
            <field name="res_model">crm.lead</field>
            <field name="view_mode">kanban,list,graph,pivot,form,calendar,activity</field>
            <field name="domain">[('type','=','opportunity'),('property_id', '!=', False)]</field>
            <field name="context">{
                    'default_type': 'opportunity',
            }</field>
            <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        </record>
    
     <!--Menus-->
    <menuitem name="Inquiry"
              id="menu_inquiry_dev_property_management"
              parent="root_menu_inquiry_property"
              action="action_dev_property_lead"
              sequence="1"/>

	<menuitem name="opportunity"
              id="menu_dev_opportunity_management"
              parent="root_menu_inquiry_property"
              action="action_dev_opportunity"
              sequence="2"/>              

</odoo>
