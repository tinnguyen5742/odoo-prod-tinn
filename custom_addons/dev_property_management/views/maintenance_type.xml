<odoo>
    <!--tree-->
	<record id="tree_property_maintenance_type" model="ir.ui.view">
		<field name="name">tree_property_maintenance_type_name</field>
		<field name="model">property.maintenance.type</field>
		<field name="arch" type="xml">
		    <list string="Maintenance Type Tree" editable="bottom">
                <field name="name"/>
 		    </list>
		</field>
	</record>

	<!--Action-->
	<record id="action_property_maintenance_type" model="ir.actions.act_window">
        <field name="name">Maintenance Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">property.maintenance.type</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="tree_property_maintenance_type"/>
    </record>

    <!--Menus-->
 	<menuitem name="Maintenance Type"
              id="menu_property_maintenance_type"
			  parent="confing_root_for_tenancy"
              action="action_property_maintenance_type"
              sequence="9"/>
</odoo>