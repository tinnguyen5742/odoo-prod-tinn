<odoo>
    <!--form-->
    <record id="form_nearby_connectivity" model="ir.ui.view">
        <field name="name">form_nearby_connectivity_name</field>
        <field name="model">nearby.connectivity</field>
        <field name="arch" type="xml">
            <form string="Nearby Connectivity Form">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!--kanban-->
    <record id="kanban_nearby_connectivity" model="ir.ui.view">
        <field name="name">kanban_nearby_connectivity_name</field>
        <field name="model">nearby.connectivity</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="image"/>
                <field name="id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex align-items-center justify-content-between p-3 shadow-sm rounded border-0 mb-2 bg-white">
                            <!-- Left Side: Name and Details -->
                            <div class="d-flex flex-column flex-grow-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span>
                                        <t t-esc="record.name.value"/>
                                    </span>
                                    
                                </div>
                            </div>
                            <!-- Right Side: Image -->
                            <div class="ms-3">
                                <field name="image" widget="image" preview_image="image" class="o_image_64_cover rounded-circle border shadow-sm" alt="Field Image"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--tree-->
    <record id="tree_nearby_connectivity" model="ir.ui.view">
        <field name="name">tree_nearby_connectivity_name</field>
        <field name="model">nearby.connectivity</field>
        <field name="arch" type="xml">
            <list string="Nearby Connectivity Tree">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!--Action-->
    <record id="action_nearby_connectivity" model="ir.actions.act_window">
        <field name="name">Nearby Connectivity</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">nearby.connectivity</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!--Menus-->
    <menuitem name="Nearby Connectivity"
              id="menu_nearby_connectivity"
              parent="confing_root_for_property"
              action="action_nearby_connectivity"
              sequence="3"/>
</odoo>