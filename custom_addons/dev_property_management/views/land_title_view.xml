<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="land_title_tree" model="ir.ui.view">
        <field name="name">land_title.list</field>
        <field name="model">land.title</field>
        <field name="arch" type="xml">
            <list string="Land Title" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                
            </list>
        </field>
    </record>
    
    <record id="model_land_title_action" model="ir.actions.act_window">
        <field name="name">Land Title</field>
        <field name="res_model">land.title</field>
        <field name="view_mode">list</field>
        
    </record>

    <menuitem
        id="land_title_menu"
        name="Land Title"
        action="model_land_title_action"
        parent="confing_root_for_property"
        sequence="1"/>
    

</odoo>
