<odoo>
    <!--form-->
    <record id="form_property_tenancy" model="ir.ui.view">
        <field name="name">form_property_tenancy_name</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <form string="Property Tenancy Form">
                <header>
                    <button name="generate_rent_schedule"
                            type="object"
                            string="&#160;Generate Rent Schedule"
                            class="oe_highlight"
                            icon="fa-calendar"
                            invisible="state != 'confirm'" />
                    <button name="confirm_tenancy"
                            type="object"
                            string="Confirm"
                            class="oe_highlight"
                            invisible="state != 'draft'" />
                    
                    <button name="%(dev_property_management.action_agreement_window_dev_property_management_tenancy)d"
                            type="action"
                            string="&#160;Generate Rent Agreement"
                            icon="fa-file-text-o"
                            class="oe_highlight"
                            invisible="state != 'running'"
                            />
<!--                    <button name="%(action_maintenance_invoice)d"-->
<!--                            type="action"-->
<!--                            string="&#160;Generate Maintenance Invoice"-->
<!--                            class="oe_highlight"-->
<!--                            icon="fa-money"-->
<!--                            invisible="state != 'running'"-->
<!--                            />-->
                    <button name="refund_deposite" type="object" string="&#160;Refund Deposit" icon="fa-credit-card" class="oe_highlight" invisible="state not in ('cancelled','closed') or deposit_refunded == True"/>
                    <button name="cancel_tenancy"
                            type="object"
                            string="Cancel"
                            invisible="state not in ('draft')"
                            />
                    
                    <button name="set_to_new"
                            type="object"
                            string="Set to New"
                            invisible="state not in ('closed','cancelled')"
                            />
                  <button name="create_commission" type="object" string="Create Commission" class="oe_highlight" invisible="state in ('closed','cancelled','draft')" />
                   
                  <button name="create_maintenance" type="object" string="Generate  Maintenance" class="oe_highlight" invisible="state != 'running'" />
                   <button name="close_tenancy"
                            type="object"
                            string="Close"
                            invisible="state != 'running'"
                            />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="view_agreements"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="agreement_count == 0"
                                >
                            <field string="Agreement" name="agreement_count" widget="statinfo"/>
                        </button>
                        <button type="object"
                                name="view_maintenance_invoices"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="invoice_count == 0"
                                >
                            <field string="Maintenance Invoice" name="invoice_count" widget="statinfo"/>
                        </button>
                        
                        
                         <button type="object"
                                name="view_maintenance"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="maintenance_count == 0"
                                >
                            <field string="Views Maintenance" name="maintenance_count" widget="statinfo"/>
                        </button>
                        
                        <button name="action_view_commission_agent" type="object" class="oe_stat_button" icon="fa-book" invisible="not rent_agent_id">
                            <field string="Agent Commission" name="count_commission_agent" widget="statinfo"/>
                        </button>
                        
                         <button name="action_view_lead" string="Lead" type="object" class="oe_stat_button" icon="fa-book" invisible="not lead_id" />
                    </div>
                    <div class="oe_title">
                        <h3>
                            <field name="name" readonly="1" force_save="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="property_type" readonly="state != 'draft'" />
                            <field name="deposit_refunded" invisible="1"/>
                            <field name="property_id" domain="[('property_purpose', '=', 'rent'),
                            ('state', '=', 'draft'), ('property_type', '=', property_type)]" readonly="state != 'draft'"/>
                            <field name="owner_partner_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="partner_id" domain="[('is_tenant', '=', True)]" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'" />
                            <field name="confirmation_date" required="state == 'running'" invisible="state == 'draft'" readonly="state != 'draft'" />
                            <field name="lead_id" invisible="1" />
                        </group>
                    </group>
                    <group>
                        <group string="Tenancy Details">
                            <field name="rent_type_id" readonly="state != 'draft'" />
                            <field name="rent_amount"  readonly="state != 'draft'" />
                            <label for="deposit_amount" invisible="deposit_payment_id != False"  />
                            <div class="o_address_format" invisible="deposit_payment_id != False" >
                                <field name="deposit_amount"  readonly="state != 'draft'" />
                                <label for="deposit_amount" style="width: 10px;" string="&#160;"/>
                                <button name="generate_deposit_payment"
                                        type="object"
                                        icon="fa-money"
                                        string="&#160;Receive Deposit"
                                        class="oe_highlight" 
                                        invisible="deposit_payment_id != False or state != 'running'"/>
                                        
                            </div>
                            <field name="deposit_payment_id" invisible="deposit_payment_id == False"
                                   readonly="1" force_save="1"/>
                                   
                        </group>
                        <group string="&#160;">
                            <field name="start_date" readonly="state != 'draft'" />
                            
                            <label for="duration"/>
                            <div>
                                <field name="duration" class="oe_inline"  readonly="state != 'draft'"/>
                                <label for="duration" string="&#160;" style="margin-right: 2px;"/>
                                <field name="interval_type" class="oe_inline"  readonly="state != 'draft'"/>
                            </div>
                            <field name="end_date"  readonly="state != 'draft'"/>
                            <field name="rent_agent_id" readonly="state != 'draft'" />
                            
                        </group>
                        
                    </group>
                    <notebook>
                        <page string="Rent Schedule" name="rent_schedule">
                            <field name="rent_schedule_ids" readonly="1">
                                <list decoration-success="state=='paid'">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="rent_amount" sum="Rent Amount"/>
                                    <field name="state"/>
<!--                                    <field name="payment_id"/>-->
                                    <field name="invoice_id" />
                                    
                                    <field name="is_posted" column_invisible="1"/>
                                    <button name="generate_payment"
                                            type="object"
                                            string="&#160;Receive Rent"
                                            icon="fa-money"
                                            invisible="invoice_id != False or parent.state != 'running'"
                                            />
                                    <button name="view_payment"
                                            type="object"
                                            string="&#160;View Invoice"
                                            icon="fa-money"
                                            invisible="invoice_id == False or parent.state != 'running'"
                                            />
                                            <!-- attrs="{'invisible': ['|', ('payment_id', '=', False), ('parent.state', '!=', 'running')]}" -->
                                    <!-- <button name="post_payment"
                                            type="object"
                                            string="&#160;Post Payment"
                                            icon="fa-check-circle"
                                            invisible="is_posted == True or parent.state != 'running'" /> -->
                                            <!-- attrs="{'invisible': ['|', ('is_posted', '=', True), ('parent.state', '!=', 'running')]}" -->
                                    <button name="payment_by_deposit" type="object" icon="fa-money" class="oe_highlight" string="Payment by deposit amount" invisible="invoice_id != False"/>
                                </list>
                            </field>
                        </page>
                        <page string="Maintenance" name="maintenance" invisible="1">
                            <field name="maintenance_ids">
                                <list editable="bottom">
                                    <field name="maintenance_type_id"/>
                                    <field name="maintenance_amount" sum="Maintenance Amount"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="maintenance_type_id"/>
                                        </group>
                                        <group>
                                            <field name="maintenance_amount"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <separator string="Description"/>
                    <field name="description" placeholder="description . . ." readonly="state != 'draft'"/>
                    <!-- attrs="{'readonly': [('state', '!=', 'draft')]}" -->
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--tree-->
    <record id="tree_property_tenancy" model="ir.ui.view">
        <field name="name">tree_property_tenancy_name</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <list string="Property Tenancy Tree" decoration-success="state == 'running'" decoration-muted="state in ('closed','cancelled')">
                <field name="name"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="rent_type_id"/>
                <field name="rent_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!--kanban-->
    <record id="kanban_property_tenancy" model="ir.ui.view">
        <field name="name">kanban_property_tenancy_name</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="rent_amount"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <!-- <div class="row mb4">
                                <div class="col-6 o_kanban_record_headings">
                                    <strong>
                                        <h5>
                                            <field name="name"/>
                                        </h5>
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <span class="float-right">
                                        <field name="state" widget="label_selection"
                                               options="{'classes': {'draft': 'default',
                                               'running': 'success', 'closed': 'danger', 'cancelled': 'danger'}}"/>
                                    </span>
                                </div>
                            </div> -->
                            <div class="oe_kanban_global_click d-flex align-items-center justify-content-between p-3 shadow-sm rounded border-0 mb-2 bg-white">
                                <!-- Left Side: Name and Details -->
                                <div class="d-flex flex-column flex-grow-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <h5>
                                            <field name="name"/>
                                        </h5>
                                        
                                    </div>
                                </div>
                                <!-- Right Side: Image -->
                                <div class="ms-3">
                                    <field name="state" widget="label_selection"
                                               options="{'classes': {'draft': 'default',
                                               'running': 'success', 'closed': 'danger', 'cancelled': 'danger'}}"/>
                                </div>
                            </div>

                            <div class="row" style="margin-top: 10px;">
                                <div class="col-12">
                                    <div>
                                        <b>Property :</b>
                                        <field name="property_id"/>
                                    </div>
                                    <div>
                                        <b>Tenant :</b>
                                        <field name="partner_id"/>
                                    </div>
                                    <div>
                                        <b>Monthly Rent :</b>
                                        <field name="rent_amount"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!--search-->
    <record id="search_property_tenancy" model="ir.ui.view">
        <field name="name">Property Tenancy - Search</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <search string="Property Tenancy Search">
                <field name="name"/>
                <field name="property_id"/>
                <field name="owner_partner_id"/>
                <field name="agent_partner_id"/>
                <field name="partner_id"/>
                <filter name='state_draft' string="Draft" domain="[('state','=','draft')]"/>
                <filter name='state_running' string="Running" domain="[('state','=','running')]"/>
                <filter name='state_closed' string="Closed" domain="[('state','=','closed')]"/>
                <filter name='state_cancelled' string="Cancelled" domain="[('state','=','cancelled')]"/>
                    <filter name="property_id" string="Property" context="{'group_by':'property_id'}"/>
                    <filter name="owner_partner_id" string="Owner" context="{'group_by':'partner_id'}"/>
                    <filter name="partner_id" string="Tenant" context="{'group_by':'partner_id'}"/>
                    <filter name="agent_partner_id" string="Agent" context="{'group_by':'agent_partner_id'}"/>
                    <filter name="rent_type_id" string="Rent Type" context="{'group_by':'rent_type_id'}"/>
                    <separator/>
                    <filter name="state" string="Status" context="{'group_by':'state'}"/>
                <searchpanel>
                    <field name="state" icon="fa-users"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!--Action-->
    <record id="action_property_tenancy" model="ir.actions.act_window">
        <field name="name">Tenancy</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">property.tenancy</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!--Menus-->
    <menuitem name="Tenancy"
              id="menu_property_tenancy"
              parent="root_menu_property_tenancy"
              action="action_property_tenancy"
              sequence="1"/>
</odoo>
