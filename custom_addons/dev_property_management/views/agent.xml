<odoo>

    <record id="view_dev_res_partner_property_agent_commission_form" model="ir.ui.view">
         <field name="name">view.dev.res.partner.property.agent.commission.form</field>
         <field name="model">res.partner</field>
         <field name="inherit_id" ref="base.view_partner_form"/>
         <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <!-- <field name="is_agent"/> -->
                <field name="blacklisted" invisible="is_agent != True"/>
                <field name="blacklisted_reason" invisible="blacklisted != True"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_commission_agent" type="object" class="oe_stat_button" icon="fa-book" 
                invisible="not is_agent" >
                    <field string="View Commission" name="count_commission_agent" widget="statinfo"/>
                </button>
            </xpath>
         </field>
      </record>

    <!--Action-->
    <record id="action_agent_contact_dev_property_management" model="ir.actions.act_window">
        <field name="name">Agent</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('is_agent', '=', True)]</field>
        <field name="context">{'default_is_agent': 1}</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!--Menus-->
    <menuitem name="Agent"
              id="menu_agent_contact_dev_property_management"
              parent="root_menu_property_contacts"
              action="action_agent_contact_dev_property_management"
              sequence="3"/>
</odoo>