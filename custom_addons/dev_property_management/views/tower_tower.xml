<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tower_tower_tree_view" model="ir.ui.view">
        <field name="name">tower.tree.view</field>
        <field name="model">tower.tower</field>
        <field name="arch" type="xml">
            <list string="Tower" editable="bottom">
                <field name="name"/>
                <field name="no_of_floor"/>
                
            </list>
        </field>
    </record>
    
    <record id="tower_property_action" model="ir.actions.act_window">
        <field name="name">Tower</field>
        <field name="res_model">tower.tower</field>
        <field name="view_mode">list</field>
        
    </record>

    <menuitem
        id="tower_menu"
        name="Tower"
        action="tower_property_action"
        parent="confing_root_for_property"
        sequence="1"/>
    

</odoo>
