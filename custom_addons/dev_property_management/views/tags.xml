<odoo>
    <!--tree-->
	<record id="tree_property_tags" model="ir.ui.view">
		<field name="name">tree_property_tags_name</field>
		<field name="model">property.tags</field>
		<field name="arch" type="xml">
		    <list string="Tags Tree" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
 		    </list>
		</field>
	</record>

	<!--Action-->
	<record id="action_property_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">property.tags</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="tree_property_tags"/>
    </record>

    <!--Menus-->
 	<menuitem name="Tags"
              id="menu_property_tags"
              parent="confing_root_for_property"
              action="action_property_tags"
              sequence="1"/>
</odoo>