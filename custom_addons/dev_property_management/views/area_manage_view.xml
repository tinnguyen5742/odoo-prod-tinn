<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="area_manage_tree" model="ir.ui.view">
        <field name="name">area.manage.list</field>
        <field name="model">area.manage</field>
        <field name="arch" type="xml">
            <list string="Area Management" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                
            </list>
        </field>
    </record>
    
    <record id="model_area_manage_action" model="ir.actions.act_window">
        <field name="name">Area Management</field>
        <field name="res_model">area.manage</field>
        <field name="view_mode">list</field>
        
    </record>

    <menuitem
        id="property_area_manage_menu"
        name="Area Management"
        action="model_area_manage_action"
        parent="confing_root_for_property"
        sequence="1"/>
    

</odoo>
