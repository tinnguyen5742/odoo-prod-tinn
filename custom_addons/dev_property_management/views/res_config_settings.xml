<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="form_config_dev_property_management" model="ir.ui.view">
        <field name="name">form_config_dev_property_management_name</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Property" string="Property" name="dev_property_management">
                    <block title="Agreement Expiry Reminder" name="property_block_1">
                        <!-- <setting id="property_setting_1" title="Property" string="Property"> -->
                            <div class="content-group" name="Property_setting1_div1">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="send_aggr_exp_email"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label for="send_aggr_exp_email"  string="Send Email Before Expiry Date"/>
                                        <div class="text-muted">
                                            Send Agreement Expiry Reminder Emails before specific days
                                        </div>
                                        <div class="content-group" invisible="send_aggr_exp_email == False" >
                                            <!-- attrs="{'invisible': [('send_aggr_exp_email', '=', False)]}" -->
                                            <div class="mt16">
                                                <label for="aggr_exp_reminder_days" string="Send email before"/>
                                                <field name="aggr_exp_reminder_days" style="width: 50px;"/>
                                                <label style="font-weight: normal;" for="aggr_exp_reminder_days" string="&#160;Days of expiry date"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6 o_setting_box"  invisible="send_aggr_exp_email == False" >
                                        <!-- attrs="{'invisible': [('send_aggr_exp_email', '=', False)]}" -->
                                        <div class="o_setting_left_pane">
                                            <field name="send_aggr_exp_mail_same_day"/>
                                        </div>
                                        <div class="o_setting_right_pane">
                                            <label for="send_aggr_exp_mail_same_day" string="Send Email on Same Day of Expiry Date"/>
                                            <div class="text-muted">
                                                Send Agreement Expiry Reminder Emails on the same day of agreement expiry date
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <!-- </setting> -->
                    </block>
                    <block title="Rent Reminder" name="property_block_2">
                            
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="send_rent_email"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="send_rent_email"  string="Send Email Before Rent Date"/>
                                <div class="text-muted">
                                    Send Rent Reminder Emails before specific days
                                </div>
                                <div class="content-group" invisible="send_rent_email == False">
                                    <!-- attrs="{'invisible': [('send_rent_email', '=', False)]}" -->
                                    <div class="mt16">
                                        <label for="rent_reminder_days" string="Send email before"/>
                                        <field name="rent_reminder_days" style="width: 50px;"/>
                                        <label style="font-weight: normal;" for="rent_reminder_days" string="&#160;Days of rent date"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box"  invisible="send_rent_email == False">
                                <!-- attrs="{'invisible': [('send_rent_email', '=', False)]}" -->
                                <div class="o_setting_left_pane">
                                    <field name="send_rent_same_day"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="send_rent_same_day" string="Send Email on Same Day of Rent Date"/>
                                    <div class="text-muted">
                                        Send Rent Reminder Emails on the same day of rent date
                                    </div>
                                </div>
                            </div>
                        </div>
                    </block>
                    <block title="Rent Invoice Generate Before Days" name="rent_invoice_before_day">
                        <div class="row mt16 o_settings_container" name="rent_invoice_before_day">
                            <div class="col-12 o_setting_box">
                                <group>
                                    <group>
                                        <field name="rent_invoice_auto_day"/>
                                    </group>
                                    <group></group>
                                </group>
                            </div>
                        </div>
                    </block>
                    <block title="Maintenance Product" name="property_block_3">
                        <div class="row mt16 o_settings_container" name="maintenance_product_property">
                            <div class="col-12 o_setting_box">
                                <group>
                                    <group>
                                        <field name="maintenance_product_id"/>
                                    </group>
                                    <group></group>
                                </group>
                            </div>
                        </div>
                    </block>
                    
                    <block title="Rent Product" name="property_block_3">
                        <div class="row mt16 o_settings_container" name="rent_product_property">
                            <div class="col-12 o_setting_box">
                                <group>
                                    <group>
                                        <field name="rent_product_id"/>
                                    </group>
                                    <group></group>
                                </group>
                            </div>
                        </div>
                    </block>
                    <block title="Deposit Product" name="property_block_3">
                        <div class="row mt16 o_settings_container" name="deposit_product_property">
                            <div class="col-12 o_setting_box">
                                <group>
                                    <group>
                                        <field name="deposit_product_id"/>
                                    </group>
                                    <group></group>
                                </group>
                            </div>
                        </div>
                    </block>
                    <block title="Agent Commission Product" name="property_block_3">
                        <div class="row mt16 o_settings_container" name="agent_product_property">
                            <div class="col-12 o_setting_box">
                                <group>
                                    <group>
                                        <field name="agent_commission_product_id"/>
                                    </group>
                                    <group></group>
                                </group>
                            </div>
                        </div>
                        
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_config_dev_property_management" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <!-- <field name="target">inline</field> -->
        <field name="context">{'module' : 'dev_property_management', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_config_dev_property_management"
        name="Settings"
        parent="root_menu_property_configuration"
        sequence="0"
        action="action_config_dev_property_management"/>
</odoo>

