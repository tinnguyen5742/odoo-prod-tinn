<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="city_tree" model="ir.ui.view">
        <field name="name">city.list</field>
        <field name="model">property.city</field>
        <field name="arch" type="xml">
            <list string="City" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                
            </list>
        </field>
    </record>
    
    <record id="model_city_manage_action" model="ir.actions.act_window">
        <field name="name">City</field>
        <field name="res_model">property.city</field>
        <field name="view_mode">list</field>
        
    </record>

    <menuitem
        id="property_city_manage_menu"
        name="City"
        action="model_city_manage_action"
        parent="confing_root_for_property"
        sequence="7"/>
    

</odoo>
