<odoo>
    <!--tree-->
	<record id="tree_flat_type" model="ir.ui.view">
		<field name="name">tree_flat_type_name</field>
		<field name="model">flat.type</field>
		<field name="arch" type="xml">
		    <list string="Flat Type Tree" editable="bottom">
                <field name="name"/>
 		    </list>
		</field>
	</record>

	<!--Action-->
	<record id="action_flat_type" model="ir.actions.act_window">
        <field name="name">Type of Flat</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">flat.type</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="tree_flat_type"/>
    </record>

    <!--Menus-->
 	<menuitem name="Type of Flat"
              id="menu_flat_type"
              parent="confing_root_for_property"
              action="action_flat_type"
              sequence="8"/>
</odoo>