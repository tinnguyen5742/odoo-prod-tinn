<odoo>
    <!--tree-->
	<record id="tree_industrial_type" model="ir.ui.view">
		<field name="name">tree_industrial_type_name</field>
		<field name="model">industrial.type</field>
		<field name="arch" type="xml">
		    <list string="Industrial Type Tree" editable="bottom">
                <field name="name"/>
 		    </list>
		</field>
	</record>

	<!--Action-->
	<record id="action_industrial_type" model="ir.actions.act_window">
        <field name="name">Type of Industrial</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">industrial.type</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="tree_industrial_type"/>
    </record>

    <!--Menus-->
 	<menuitem name="Type of Industrial"
              id="menu_industrial_type"
              parent="confing_root_for_property"
              action="action_industrial_type"
              sequence="6"/>
</odoo>