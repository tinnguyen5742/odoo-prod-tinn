<odoo>
    <!--form-->
    <record id="form_agreement_template" model="ir.ui.view">
        <field name="name">form_agreement_template_name</field>
        <field name="model">agreement.template</field>
        <field name="arch" type="xml">
            <form string="Agreement Template Form">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <separator string="Agreement Details"/>
                    <field name="description" />
                </sheet>
            </form>
        </field>
    </record>

    <!--tree-->
    <record id="tree_agreement_template" model="ir.ui.view">
        <field name="name">tree_agreement_template_name</field>
        <field name="model">agreement.template</field>
        <field name="arch" type="xml">
            <list string="Agreement Template Tree">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!--Action-->
    <record id="action_agreement_template" model="ir.actions.act_window">
        <field name="name">Agreement Template</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agreement.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--Menus-->
    <menuitem name="Agreement Template"
              id="menu_agreement_template"
              parent="confing_root_for_agreement"
              action="action_agreement_template"
              sequence="7"/>
</odoo>