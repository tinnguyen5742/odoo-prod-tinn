<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="parking_space_tree" model="ir.ui.view">
        <field name="name">parking_space.list</field>
        <field name="model">parking.space</field>
        <field name="arch" type="xml">
            <list string="Parking Space" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                
            </list>
        </field>
    </record>
    
    <record id="model_parking_space_action" model="ir.actions.act_window">
        <field name="name">Parking Space</field>
        <field name="res_model">parking.space</field>
        <field name="view_mode">list</field>
        
    </record>

    <menuitem
        id="parking_space_menu"
        name="Parking Space"
        action="model_parking_space_action"
        parent="confing_root_for_property"
        sequence="1"/>
    

</odoo>
