<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="property_facing_tree" model="ir.ui.view">
        <field name="name">property.facing.list</field>
        <field name="model">property.facing</field>
        <field name="arch" type="xml">
            <list string="Parking Space" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                
            </list>
        </field>
    </record>
    
    <record id="model_facing_action" model="ir.actions.act_window">
        <field name="name">Facing</field>
        <field name="res_model">property.facing</field>
        <field name="view_mode">list</field>
        
    </record>

    <menuitem
        id="property_facing_menu"
        name="Facing"
        action="model_facing_action"
        parent="confing_root_for_property"
        sequence="1"/>
    

</odoo>
