            </div>
            
            <!-- Search Tab Script -->
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    const searchTabs = document.querySelectorAll('.search-tab');
                    const purposeInput = document.getElementById('searchPurpose');
                    
                    searchTabs.forEach(function(tab) {
                        tab.addEventListener('click', function() {
                            searchTabs.forEach(function(t) { t.classList.remove('active'); });
                            this.classList.add('active');
                            purposeInput.value = this.getAttribute('data-purpose');
                        });
                    });
                });
            </script>
        </t>
    </template>

    <!-- Property Card Template (Reusable) -->
    <template id="website_property_card" name="Property Card">
        <div class="property-card">
            <a t-attf-href="/properties/detail/#{property.id}">
                <div class="property-card-image">
                    <t t-if="property.photo">
                        <img t-attf-src="/properties/image/#{property.id}" 
                             t-att-alt="property.name"/>
                    </t>
                    <t t-else="">
                        <img src="/dev_property_management/static/src/img/no-image.svg" 
                             alt="No Image Available"/>
                    </t>
                    
                    <div class="property-card-badges">
                        <t t-if="property.property_purpose == 'sell'">
                            <span class="property-badge badge-sale">For Sale</span>
                        </t>
                        <t t-elif="property.property_purpose == 'rent'">
                            <span class="property-badge badge-rent">For Rent</span>
                        </t>
                        
                        <t t-if="property.property_type">
                            <span class="property-badge badge-featured" style="background: #6c757d; color: white;">
                                <t t-esc="property.property_type.capitalize()"/>
                            </span>
                        </t>
                    </div>
                </div>
                
                <div class="property-card-content">
                    <div class="property-card-price">
                        <t t-if="property.property_purpose == 'sell' and property.price_amount">
                            ₹<t t-esc="'{:,.0f}'.format(property.price_amount)"/>
                        </t>
                        <t t-elif="property.property_purpose == 'rent' and property.rent_amount">
                            ₹<t t-esc="'{:,.0f}'.format(property.rent_amount)"/>
                            <span>/month</span>
                        </t>
                        <t t-else="">
                            Contact for Price
                        </t>
                    </div>
                    
                    <h3 class="property-card-title" t-esc="property.name"/>
                    
                    <div class="property-card-location">
                        <i class="fa fa-map-marker"></i>
                        <span>
                            <t t-if="property.street" t-esc="property.street"/>
                            <t t-if="property.city_id">, <t t-esc="property.city_id.name"/></t>
                            <t t-if="property.state_id">, <t t-esc="property.state_id.name"/></t>
                        </span>
                    </div>
                    
                    <div class="property-card-features">
                        <t t-if="property.bedroom">
                            <div class="property-feature">
                                <i class="fa fa-bed"></i>
                                <span><t t-esc="property.bedroom"/> Beds</span>
                            </div>
                        </t>
                        <t t-if="property.bathroom">
                            <div class="property-feature">
                                <i class="fa fa-bath"></i>
                                <span><t t-esc="property.bathroom"/> Baths</span>
                            </div>
                        </t>
                        <t t-if="property.floor">
                            <div class="property-feature">
                                <i class="fa fa-clone"></i>
                                <span><t t-esc="property.floor"/> Floor</span>
                            </div>
                        </t>
                    </div>
                </div>
            </a>
        </div>
    </template>
</odoo>
