<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website Property Homepage Template -->
    <template id="website_property_home" name="Property Website Home">
        <t t-call="website.layout">
            <t t-set="additional_title">Properties</t>
            
            <div class="property-website">
                <!-- Hero Section -->
                <section class="hero-section" style="background-image: url('/dev_property_management/static/src/img/modern-luxury-apartments-reflect-futuristic-urban-growth-generated-by-ai.jpg');">
                    <div class="hero-content">
                        <h1 class="hero-title">Find Your Dream Property</h1>
                        <p class="hero-subtitle">Discover the perfect home, commercial space, or investment property</p>
                        
                        <!-- Search Box -->
                        <div class="search-container">
                            <div class="search-tabs">
                                <button type="button" class="search-tab active" data-purpose="all">All</button>
                                <button type="button" class="search-tab" data-purpose="sell">Buy</button>
                                <button type="button" class="search-tab" data-purpose="rent">Rent</button>
                            </div>
                            
                            <form action="/properties/search" method="get" class="search-box">
                                <input type="hidden" name="purpose" id="searchPurpose" value="all"/>
                                
                                <div class="search-input-group">
                                    <i class="fa fa-map-marker"></i>
                                    <select name="city_id" class="form-control">
                                        <option value="">Select City</option>
                                        <t t-foreach="cities" t-as="city">
                                            <option t-att-value="city.id">
                                                <t t-esc="city.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="search-input-group">
                                    <i class="fa fa-building"></i>
                                    <select name="property_type" class="form-control">
                                        <option value="">Property Type</option>
                                        <option value="residential">Residential</option>
                                        <option value="commercial">Commercial</option>
                                        <option value="industrial">Industrial</option>
                                        <option value="land">Land/Plot</option>
                                    </select>
                                </div>
                                <div class="search-input-group">
                                    <i class="fa fa-search"></i>
                                    <input type="text" name="search" 
                                           placeholder="Search by name, location..." 
                                           class="form-control"/>
                                </div>
                                
                                <button type="submit" class="search-btn">
                                    <i class="fa fa-search"></i> Search
                                </button>
                            </form>
                        </div>
                    </div>
                </section>

                <!-- Featured Properties Section -->
                <section class="properties-section">
                    <div class="container">
                        <div class="section-title">
                            <h2>Featured Properties</h2>
                            <p>Explore our handpicked selection of premium properties</p>
                        </div>
                        
                        <div class="property-grid">
                            <t t-foreach="featured_properties" t-as="property">
                                <t t-call="dev_property_management.website_property_card"/>
                            </t>
                        </div>
                        
                        <div class="text-center mt-4">
                            <a href="/properties/all" class="btn-property btn-property-primary btn-property-lg">
                                View All Properties <i class="fa fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Property Categories Section -->
                <section class="categories-section">
                    <div class="container">
                        <div class="section-title">
                            <h2>Browse by Property Type</h2>
                            <p>Find properties based on type</p>
                        </div>
                        
                        <div class="category-grid">
                            <a href="/properties/all?property_type_filter=residential" class="category-card">
                                <div class="category-icon">
                                    <i class="fa fa-building"></i>
                                </div>
                                <h4 class="category-name">Residential</h4>
                                <p class="category-count"><t t-esc="property_counts.get('residential', 0)"/> Properties</p>
                            </a>
                            
                            <a href="/properties/all?property_type_filter=commercial" class="category-card">
                                <div class="category-icon">
                                    <i class="fa fa-briefcase"></i>
                                </div>
                                <h4 class="category-name">Commercial</h4>
                                <p class="category-count"><t t-esc="property_counts.get('commercial', 0)"/> Properties</p>
                            </a>
                            
                            <a href="/properties/all?property_type_filter=industrial" class="category-card">
                                <div class="category-icon">
                                    <i class="fa fa-industry"></i>
                                </div>
                                <h4 class="category-name">Industrial</h4>
                                <p class="category-count"><t t-esc="property_counts.get('industrial', 0)"/> Properties</p>
                            </a>
                            
                            <a href="/properties/all?property_type_filter=land" class="category-card">
                                <div class="category-icon">
                                    <i class="fa fa-map"></i>
                                </div>
                                <h4 class="category-name">Land/Plot</h4>
                                <p class="category-count"><t t-esc="property_counts.get('land', 0)"/> Properties</p>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Properties for Sale Section -->
                <t t-if="sell_properties">
                    <section class="properties-section" style="background: var(--bg-light);">
                        <div class="container">
                            <div class="section-title">
                                <h2>Properties for Sale</h2>
                                <p>Find your perfect property to buy</p>
                            </div>
                            
                            <div class="property-grid">
                                <t t-foreach="sell_properties" t-as="property">
                                    <t t-call="dev_property_management.website_property_card"/>
                                </t>
                            </div>
                            
                            <div class="text-center mt-4">
                                <a href="/properties/all?purpose=sell" class="btn-property btn-property-outline">
                                    View All for Sale <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </section>
                </t>

                <!-- Properties for Rent Section -->
                <t t-if="rent_properties">
                    <section class="properties-section">
                        <div class="container">
                            <div class="section-title">
                                <h2>Properties for Rent</h2>
                                <p>Discover rental properties in your area</p>
                            </div>
                            
                            <div class="property-grid">
                                <t t-foreach="rent_properties" t-as="property">
                                    <t t-call="dev_property_management.website_property_card"/>
                                </t>
                            </div>
                            
                            <div class="text-center mt-4">
                                <a href="/properties/all?purpose=rent" class="btn-property btn-property-outline">
                                    View All for Rent <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </section>
                </t>

                <!-- Why Choose Us Section -->
                <section class="categories-section">
                    <div class="container">
                        <div class="section-title">
                            <h2>Why Choose Us</h2>
                            <p>Your trusted partner in finding the perfect property</p>
                        </div>
                        
                        <div class="category-grid">
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa fa-check-circle"></i>
                                </div>
                                <h4 class="category-name">Verified Properties</h4>
                                <p class="category-count">All listings are verified</p>
                            </div>
                            
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa fa-shield"></i>
                                </div>
                                <h4 class="category-name">Secure Transactions</h4>
                                <p class="category-count">Safe and secure process</p>
                            </div>
                            
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa fa-headphones"></i>
                                </div>
                                <h4 class="category-name">24/7 Support</h4>
                                <p class="category-count">Always here to help</p>
                            </div>
                            
                            <div class="category-card">
                                <div class="category-icon">
                                    <i class="fa fa-star"></i>
                                </div>
                                <h4 class="category-name">Best Deals</h4>
                                <p class="category-count">Competitive pricing</p>
                            </div>
                        </div>
                    </div>
                </section>

