<odoo>
    <!--form-->
    <record id="form_property_rent_schedule" model="ir.ui.view">
        <field name="name">form_property_rent_schedule</field>
        <field name="model">rent.schedule</field>
        <field name="arch" type="xml">
            <form string="Rent Schedule Form" delete="false" duplicate="false" create="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h3>
                            <field name="name" readonly="1" force_save="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="property_id" readonly="1"/>
                            <field name="tenancy_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="payment_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="rent_amount" readonly="1"/>
                            <!-- <field name="cheque_number"/> -->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--tree-->
    <record id="tree_property_rent_schedule" model="ir.ui.view">
        <field name="name">tree_property_rent_schedule_name</field>
        <field name="model">rent.schedule</field>
        <field name="arch" type="xml">
            <list string="Rent Schedule Tree" create="false" delete="false" decoration-danger="state == 'unpaid'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenancy_id"/>
                <field name="partner_id"/>
                <field name="payment_id"/>
                <field name="date"/>
                <field name="rent_amount"/>
                <!-- <field name="cheque_number"/> -->
                <field name="state"/>
            </list>
        </field>
    </record>

    <!--Calendar-->
    <record id="calendar_property_rent_schedule" model="ir.ui.view">
        <field name="name">calendar_property_rent_schedule_name</field>
        <field name="model">rent.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Rent Schedule Calendar" date_start="date" date_stop="date">
                <field name="property_id"/>
                <field name="tenancy_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="rent_amount"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="search_rent_schedule" model="ir.ui.view">
        <field name="name">Rent Schedule - Search</field>
        <field name="model">rent.schedule</field>
        <field name="arch" type="xml">
            <search string="Rent Schedule Search">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenancy_id"/>
                <field name="partner_id"/>
                    <filter name="tenancy_id" string="Tenancy" context="{'group_by':'tenancy_id'}"/>
                    <separator/>
            </search>
        </field>
    </record>

    <!--Action-->
    <record id="action_property_rent_schedule" model="ir.actions.act_window">
        <field name="name">Rent Schedule</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rent.schedule</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <!--Menus-->
    <menuitem name="Rent Schedule"
              id="menu_property_rent_schedule"
              parent="root_menu_property_tenancy"
              action="action_property_rent_schedule"
              sequence="2"/>
</odoo>