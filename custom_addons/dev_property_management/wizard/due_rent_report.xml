<odoo>
    <record id="form_due_rent_popup" model="ir.ui.view">
        <field name="name">form_due_rent_popup_name</field>
        <field name="model">due.rent.popup</field>
        <field name="arch" type="xml">
            <form string="Due Rent Report">
                <group>
                    <group>
                        <field name="property_type"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                    <button string="&#160;Print PDF" icon="fa-print" name="print_pdf" type="object" class="oe_highlight"/>&#160;&#160;or&#160;&#160;
                    <button string="Close Window" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

	<record id="action_due_rent_popup" model="ir.actions.act_window">
        <field name="name">Due Rent Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">due.rent.popup</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="form_due_rent_popup"/>
        <field name="target">new</field>
    </record>

        <menuitem name="Due Rent Report"
              id="menu_due_rent_popup"
              parent="root_menu_property_reporting"
              action="action_due_rent_popup"
              sequence="3"/>
</odoo>