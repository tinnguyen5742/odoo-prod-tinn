<odoo>
    <record id="popup_add_agreement_documents" model="ir.ui.view">
        <field name="name">popup_add_agreement_documents_name</field>
        <field name="model">add.agreement.documents</field>
        <field name="arch" type="xml">
            <form string="Add Documents">
                <field name="attachment_ids" widget="many2many_binary"/>
                <footer>
                    <button string="Add" name="add_documents" type="object" class="oe_highlight"/>&#160;&#160;or&#160;&#160;
                    <button string="Close Window" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
	<record id="action_add_agreement_documents" model="ir.actions.act_window">
        <field name="name">Add Documents</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">add.agreement.documents</field>
        <field name="context">{'default_agreement_id': active_id}</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="popup_add_agreement_documents"/>
        <field name="target">new</field>
    </record>
</odoo>