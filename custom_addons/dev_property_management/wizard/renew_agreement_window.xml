<odoo>
    <record id="popup_renew_agreement_window_dev_property_management" model="ir.ui.view">
        <field name="name">popup_renew_agreement_window_dev_property_management_name</field>
        <field name="model">renew.agreement.window</field>
        <field name="arch" type="xml">
            <form string="Renew Agreement Form">
                <group>
                    <group>
                        <field name="agreement_id" readonly="1" force_save="1"/>
                        <field name="old_expiry_date"/>
                    </group>
                    <group>
                        <field name="agreement_date"/>
                        <label for="duration"/>
                        <div>
                            <field name="duration" class="oe_inline"/>
                            <label for="duration" string="&#160;" style="margin-right: 2px;"/>
                            <field name="interval_type" class="oe_inline"/>
                        </div>
                        <field name="expiry_date"/>
                    </group>
                </group>
                <footer>
                    <button string="&#160;Renew" name="renew_agreement" type="object" icon="fa-refresh"
                            class="oe_highlight"/>&#160;&#160;or&#160;&#160;
                    <button string="Close Window" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_renew_agreement_window_dev_property_management" model="ir.actions.act_window">
        <field name="name">Renew Rent Agreement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">renew.agreement.window</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_agreement_id': active_id}</field>
        <field name="view_id" ref="popup_renew_agreement_window_dev_property_management"/>
        <field name="target">new</field>
    </record>
</odoo>