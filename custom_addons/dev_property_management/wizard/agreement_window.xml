<odoo>
    <record id="popup_agreement_window_dev_property_management" model="ir.ui.view">
        <field name="name">popup_agreement_window_dev_property_management_name</field>
        <field name="model">agreement.window</field>
        <field name="arch" type="xml">
            <form string="Agreement Form">
                <separator string="Agreement Details"/>
                <group>
                    <group>
                        <field name="partner_id" readonly="1" force_save="1" string="Contact" invisible="type != 'sell'"/>
                        <field name="partner_id" readonly="1" force_save="1" string="Tenant" invisible="type != 'rent'" />
                        <field name="property_id" readonly="1" force_save="1"/>
                        <field name="owner_partner_id" readonly="1" force_save="1"/>
                        <field name="rent_amount" readonly="1" force_save="1"  invisible="type != 'rent'" />
                        <field name="booking_id" invisible="1"/>
                        <field name="tenancy_id" invisible="1"/>
                        <field name="type" invisible="1"/>
                    </group>
                    <group>
                        <field name="agreement_date"/>
                        <label for="duration"  invisible="type == 'sell'" />
                        
                        <div invisible="type == 'sell'" >
                            <field name="duration" class="oe_inline"/>
                            <label for="duration" string="&#160;" style="margin-right: 2px;"/>
                            <field name="interval_type" class="oe_inline"/>
                        </div>
                        <field name="expiry_date" invisible="type == 'sell'" />
                        
                    </group>
                </group>
                <notebook>
                    <page string="Agreement Details">
                        <group>
                            <group>
                                <field name="agreement_template_id"/>
                            </group>
                            <group></group>
                        </group>
                        <field name="description" widget="html"/>
                    </page>
                    <page string="Documents">
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </page>
                </notebook>
                <footer>
                    <button string="Generate    " name="generate_rent_agreement" type="object"
                            class="oe_highlight"/>&#160;&#160;or&#160;&#160;
                    <button string="Close Window" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_agreement_window_dev_property_management" model="ir.actions.act_window">
        <field name="name">Generate Sell Agreement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agreement.window</field>
        <field name="context">{'default_booking_id': active_id, 'default_type': 'sell'}</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="popup_agreement_window_dev_property_management"/>
        <field name="target">new</field>
    </record>

    <record id="action_agreement_window_dev_property_management_tenancy" model="ir.actions.act_window">
        <field name="name">Generate Rent Agreement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agreement.window</field>
        <field name="context">{'default_tenancy_id': active_id, 'default_type': 'rent'}</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="popup_agreement_window_dev_property_management"/>
        <field name="target">new</field>
    </record>
</odoo>