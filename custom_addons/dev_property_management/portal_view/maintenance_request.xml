		                            <input type="text" class="form-control" name="name" id="name" readonly="1" t-att-value="tenancy_id.owner_partner_id.name"/>
	                            </div>
	                            <div class="col-md-4">
		                            <label for="ticket_name" class="form-label fw-bold">Owner Number</label>
		                            <input type="text" class="form-control" name="name" id="name" readonly="1" t-att-value="tenancy_id.owner_partner_id.phone"/>
	                            </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="email" class="form-label fw-bold">Customer Email</label>
                                    <input type="text" class="form-control" name="email" 
                                           t-att-value="tenancy_id.partner_id.email or ''" />
                                </div>
                                <div class="col-md-6">
                                    <label for="phone" class="form-label fw-bold">Customer Phone</label>
                                    <input type="text" class="form-control" name="phone" required="True"
                                           t-att-value="tenancy_id.partner_id.phone or ''" />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="subject_id" class="form-label fw-bold">Maintenance Subject</label>
                                    <input type="text" name="subject" class="form-control" placeholder= "Light Problem"  required="True"/>
                                </div>
                                 <div class="col-md-6">
                                    <label for="user_name" class="form-label fw-bold">Priority</label>
									<select class="form-control" name="priority_name" id="priority_name" required="True" >
									    <t t-foreach="priority or []" t-as="prio">
									        <option t-att-value="prio"><t t-esc="prio"/></option>
									    </t>
									 </select>
                                </div>
                                
                                
                                
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label for="subject_id" class="form-label fw-bold">Details</label>
                                     <textarea class="form-control"
									  id="issue_details"
									  name="issue_details"
									  rows="4"
									  placeholder="Enter issue details..."
									  required="true"></textarea>
                                </div>
                            </div>
                            <div  class="row mb-3">
                            	<center>
		                            <button id="submitBtn" type="submit" class="btn btn-primary" style="width:1030px;">
		                                   
		                                Submit
		                            </button>
                                </center>
                            </div>
