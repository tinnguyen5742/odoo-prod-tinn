                            <div class="row mb-3" >
                            	<div class="col-md-4">
		                            <label for="ticket_name" class="form-label fw-bold">Property</label>
		                            <input type="text" class="form-control" name="property_id"  readonly="1" t-att-value="tenancy_id.property_id.name"/>
