    <template id="portal_breadcrumb_owner_property" name="Owner Property Breadcrumb" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
        <li t-if="page_name == 'property_details_tree' or owner_property_sudo" t-attf-class="breadcrumb-item #{'active ' if not owner_property_sudo else ''}">
        <a t-if="owner_property_sudo" t-attf-href="/my/Owner_property_details?{{ keep_query() }}"> Owner Property </a>
        <t t-else="">Owner Property</t>
        </li>
        <li t-if="owner_property_sudo" class="breadcrumb-item active">
        <t t-esc="owner_property_sudo.number"/>
        </li>
        </xpath>
    </template>

    <template id="portal_owner_properties_details" name="Owner Property Details">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Property Details</t>
            </t>
            <t t-if="not property_details">
                <p>There are currently no Property for your account.</p>
            </t>
            <t t-if="property_details" t-call="portal.portal_table">
              <t t-foreach="grouped_property" t-as="property_group">
                <thead>
                    <tr t-attf-class="{{'thead-light' if not groupby == 'none' else ''}}" >
                        <th t-if="groupby == 'none'">Reference #</th>
                        <th t-else="">
                                <t t-if="groupby == 'state'">
                                    <em class="font-weight-normal text-muted">Status :</em>
                                    <span t-field="property_group[0].sudo().state"/>
                                </t>
                                <t t-if="groupby == 'property_purpose'">
                                    <em class="font-weight-normal text-muted">Property Purpose :</em>
                                    <span t-field="property_group[0].sudo().property_purpose"/>
                                </t>
                                <t t-if="groupby == 'property_type'">
                                    <em class="font-weight-normal text-muted">Property Type :</em>
                                    <span t-field="property_group[0].sudo().property_type"/>
                                </t>
                        </th>
                        <th>Property Purpose</th>
                        <th>Parent Property</th>
                        <th>Property Type</th>
                        <th>Owner</th>
                        <th>Construction year</th>
                        <th class="text-center">State</th>
                    </tr>
                </thead>
                <tbody>
                <t t-foreach="property_group" t-as="l">
                    <tr>
                        <td>
                            <a t-att-href="l.get_portal_url()">
                                <t t-esc="l.number" />
                            </a>
                        </td>
                        <td>
                            <span t-field="l.property_purpose" />
                        </td>
                        <td>
                            <span t-field="l.parent_id" />
                        </td>
                        <td>
                            <span t-field="l.property_type" />
                        </td>
                        <td>
                            <span t-field="l.owner_partner_id.name" />
                        </td>
                        <td>
                            <span t-field="l.construct_year" />
                        </td>
                        <td style="text-align:center;">
                            <t t-if="l.state == 'draft'" name="status_draft">
                                <span class="badge rounded-pill text-bg-info" t-field="l.state"/>
                            </t>
                            <t t-else=" " name="status_on_rent">
                                <span class="badge rounded-pill text-bg-success" t-field="l.state"/>
                            </t>
                        </td>
                    </tr>
       	  </t>
                </tbody>
               </t>
            </t>
            <br/>
        </t>
    </template>


    <template id="portal_owner_property_detail_form" name="Owner Detail Portal Template"
        inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <div class="row mt16">
<!--              Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-auto d-print-none'" />
                    <t t-set="title">
                        <h2 class="mb-0">
                            <span t-field="owner_property_sudo.number" />
                        </h2>
                    </t>
                    <t t-set="entries">
                        <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">
                            <li class="list-group-item flex-grow-1">
                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">
                                    <div class="btn-group flex-grow-1 mr-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_download_btn" t-att-href="owner_property_sudo.get_portal_url(report_type='pdf', download=True)" title="Download"><i class="fa fa-download"/> Download</a>
                                    </div>
                                    <div class="btn-group flex-grow-1 mb-1" style="margin-left:15px;">
                                        <a class="btn btn-secondary btn-block o_print_btn o_portal_invoice_print" t-att-href="owner_property_sudo.get_portal_url(report_type='pdf')" id="print_Owner_property_report" title="Print" target="_blank"><i class="fa fa-print"/> Print</a>
                                    </div>
                                </div>
                            </li>
                            <li class="navspy list-group-item pl-0 flex-grow-1" t-ignore="true"
                                role="complementary">
                                <ul class="nav flex-column bs-sidenav"></ul>
                            </li>
                            <li t-if="owner_property_sudo.owner_partner_id" class="list-group-item flex-grow-1">
                                <div class="small mb-1">
                                    <strong class="text-muted">Your Contact</strong>
                                </div>
                                <div class="row flex-nowrap">
                                    <div class="o_portal_contact_details d-flex flex-column gap-2">
                                        <div class="d-flex justify-content-start align-items-center gap-2">
                                            <img class="o_avatar o_portal_contact_img rounded" t-att-src="image_data_uri(owner_property_sudo.owner_partner_id.avatar_1024)" alt="Contact"/>
                                            <div>
                                                <span t-field="owner_property_sudo.owner_partner_id"
                                                 t-options='{"widget": "contact", "fields": ["name", "mobile"], "no_marker": True}'/>
                                                <a href="#discussion" class="d-flex align-items-center gap-2 small fw-bold"><i class="fa fa-comment"></i>
                                                Send message
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </t>
                </t>
                <div id="booking_detail_content" class="col-12 col-lg justify-content-end">
                    <div t-attf-class="card #{'pb-5' if report_type == 'html' else ''}">
                        <t t-call="dev_property_management.owner_property_detail_portal_content" />
                    </div>
                    <div id="booking_detail_communication" class="mt-3">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="owner_property_sudo" />
                        </t>
                    </div>
                </div>
                <hr />
            </div>
        </xpath>
    </template>

