    <template id="portal_owner_property" name="Show Members" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="placeholder_count" t-value="'owner_property_count'"/>
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'" />
                <t t-set="title">Owner Property</t>
                <t t-set="url" t-value="'/my/Owner_property_details'"/>
                <t t-set="text">Follow, view or print your Property</t>
            </t>
        </div>
    </template>
