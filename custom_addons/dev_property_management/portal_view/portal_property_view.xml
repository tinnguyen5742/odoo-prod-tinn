      <section class="property-section container">
        
        <!-- Filter Section -->
        <div class="filter-section">
          <form action="/my/property_search" method="POST" style="margin-block-end: 0em;">
          <div class="row">

            <div class="col-md-2 pt-3">
              <div class="filter-group">
                <select class="form-select" name="property_type">
                  <option value="" t-att-selected="'selected' if not selected_values.get('property_type') else None" disabled="">Select Type</option>
                  <option value="sell" t-att-selected="'selected' if selected_values.get('property_type') == 'sell' else None">Buy</option>
                  <option value="rent" t-att-selected="'selected' if selected_values.get('property_type') == 'rent' else None">Rent</option>
                </select>
              </div>
            </div>
            <div class="col-md-3 pt-3">
              <div class="filter-group">
                <select class="form-select" name="select_city" id="select_city" required="1">
                      <option value="" t-att-selected="'selected' if not selected_values.get('city_id') else None" disabled="">Select City</option>
                      <t t-foreach="city_ids" t-as="city">
                        <option t-att-value="city.id" t-att-selected="'selected' if str(city.id) == str(selected_values.get('city_id')) else None">
                          <t t-esc="city.name"/>
                        </option>
                      </t>
                </select>
              </div>
            </div>
            <div class="col-md-2 pt-3">
              <div class="filter-group">
                <select class="form-select" name="search_query" id="project_select">
                      <option value="" t-att-selected="'selected' if not selected_values.get('search_query') else None" disabled="">Select Project</option>
                      <t t-foreach="property_ids" t-as="project">
                        <option t-att-value="project.id" t-att-data-brand="project.city_id.id" t-att-selected="'selected' if str(project.id) == str(selected_values.get('search_query')) else None">
                          <t t-esc="project.name"/>
                        </option>
                      </t>
                </select>  
              </div>
            </div>
            <div class="col-md-2 pt-3">
              <div class="filter-group">
                <select class="form-select" name="type" required="1">
                      <option value="" t-att-selected="'selected' if not selected_values.get('category_type') else None" disabled="" >Any Type</option>
                      <option value="residential" t-att-selected="'selected' if selected_values.get('category_type') == 'residential' else None">Residential</option>
                      <option value="commercial" t-att-selected="'selected' if selected_values.get('category_type') == 'commercial' else None">Commercial</option>
                      <option value="industrial" t-att-selected="'selected' if selected_values.get('category_type') == 'industrial' else None">Industrial</option>
                      <option value="land" t-att-selected="'selected' if selected_values.get('category_type') == 'land' else None">Land</option>
                </select>
              </div>
            </div>
            <div class="col-md-3 pt-3">
              <div class="filter-group">
                
                <button  type="submit" class="btn btn-primary-custom w-100"><i class="fa fa-search"></i> Find Property</button>
              </div>
            </div>
          </div>
        </form>
        </div>


        <t t-if="properties">
        
          <div class="row g-4">
            <t t-foreach="properties" t-as="property_id">

              <div class="col-12 col-md-6">
                <form id="confirm" method="POST" t-attf-action="/my/property_details/#{property_id.id}/view" style="flex: 1; padding: 1rem;">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  
                  <div class="card property-card d-flex flex-row">
                  
                    <!-- Left Side: Image -->
                    <div class="property-image-wrapper" style="flex: 1; max-width: 50%;">
                      <img t-if="property_id.photo" t-att-src="image_data_uri(property_id.photo)" class="img-fluid h-100 w-100 object-fit-cover" alt="" />
                      <img t-if="not property_id.photo" src="/web/static/src/img/placeholder.png" class="img-fluid h-100 w-100 object-fit-cover" alt="" />
                      <span class="property-badge position-absolute top-0 start-0 m-2" style="width:fit-content;">Premium</span>
                    </div>

                    <!-- Right Side: Content -->
                  
                    
                    <div class="property-body">
                      <h5 class="property-title">
                        <t t-esc="property_id.name"/>
                      </h5>
                      <div class="property-location">
                        <i class="fa fa-map-marker"></i>
                        <t t-esc="property_id.street"/>, <t t-esc="property_id.city_id.name"/>
                      </div>

                      <!-- Price Formatting -->
                      <t t-set="price" t-value="property_id.price_amount"/>
                      <t t-if="price >= 10000000">
                        <t t-set="formatted_price" t-value="'%.2f' % (price / 10000000.0)"/>
                        <t t-set="formatted_price_str" t-value="'%s Cr' % formatted_price"/>
                      </t>
                      <t t-elif="price >= 100000">
                        <t t-set="formatted_price" t-value="'%.2f' % (price / 100000.0)"/>
                        <t t-set="formatted_price_str" t-value="'%s Lakhs' % formatted_price"/>
                      </t>
                      <t t-else="">
                        <t t-set="formatted_price_str" t-value="'%s' % ('%.2f' % price)"/>
                      </t>

                      <div class="property-price">
                        <t t-esc="request.env.company.currency_id.symbol"/>
                        <t t-esc="formatted_price_str"/>
                        <span>onwards</span>
                      </div>

                      <!-- Details -->
                      <div class="property-details">
                        <div class="property-detail">
                          <i class="fa fa-building"></i>
                          <strong>Developer:</strong>
                          <t t-esc="property_id.owner_partner_id.name"/>
                        </div>
                        <div class="property-detail">
                          <i class="fa fa-calendar-o"></i>
                          <strong>Construction Year:</strong>
                          <t t-esc="property_id.construct_year"/>
                        </div>
                        <t t-if="property_id.property_type == 'residential'">
                          <div class="property-detail">
                            <i class="fa fa-home"></i>
                            <strong>Configuration:</strong>
                            <t t-esc="property_id.flat_type_id.name"/>
                          </div>
                        </t>
                        
                        <div class="property-detail">
                          <i class="fa fa-home"></i>
                          <strong>Status:</strong>
                          <t t-esc="property_id.property_status"/>
                        </div>
                        <div class="property-detail">
                          <i class="fa fa-arrows-alt"></i>
                          <strong>Built-Up Area:</strong> From <t t-esc="property_id.total_square_foot"/> Sq.ft.
                        </div>
                      </div>

                      <div class="property-actions mt-3">
                        <button class="btn btn-primary-custom">View Details</button>
                      </div>
                    </div>
                  
                  </div>
                </form>
              </div>
            </t>
          </div>

      </t>
      <t t-else="">
          <div class="no-properties-message">
              <div class="text-center py-5">
                  <i class="fa fa-home fa-3x text-muted mb-3"></i>
                  <h3 class="text-muted">No Properties Available</h3>
                  <p class="text-muted">We're sorry, but there are currently no properties matching your criteria.</p>
                  <p class="text-muted">Please check back later for new property listings.</p>
              </div>
          </div>
      </t>

      <script>
        document.addEventListener("DOMContentLoaded", function () {
          document.querySelectorAll(".property-card").forEach(function (card) {
            card.addEventListener("click", function (e) {
              // Prevent click if it originated from the button
              if (e.target.closest("button")) return;

              const form = card.closest("form");
              if (form) {
                form.submit();
              }
            });
          });
        });
      </script>



      </section>

    </t>
  </template>



</odoo>
