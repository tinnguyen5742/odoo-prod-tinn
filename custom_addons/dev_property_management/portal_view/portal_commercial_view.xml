                    <form method="get" action="/my/property_Commercial_details" id="filterForm" style="background-color: white; padding: 20px; border-radius: 0 0 20px 20px; box-shadow: 1px 1px 5px rgba(0, 0, 0, 0.1);">
                        <div style="display: flex; align-items: center; gap: 20px;">

