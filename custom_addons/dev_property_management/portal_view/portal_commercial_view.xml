            <li t-if="page_name == 'package_details_tree'" t-attf-class="breadcrumb-item #{'active' if not property_details else ''}">
                Package Commercial Details
            </li>
        </xpath>
    </template>
    <template id="portal_Commercial_property_details" name="My Property Details">
        <style>
            <!--        .container {-->
            <!--            display: flex;-->
            <!--            justify-content: space-between;-->
            <!--            margin: 20px auto;-->
            <!--        }-->
    .outer-div {
        box-sizing: border-box;
    }
    .inner-div {
        background-color: #fff;
                                            <!-- border: 1px solid #ccc; -->
        border-radius: 5px;
        padding: 5px;
        box-sizing: border-box;
        
    }
    button {
        border: 1px solid gray;
        padding: 10px;
        cursor: pointer;
        transition: transform 0.3s ease;
    }
    button:hover {
        transform: scale(1.02);
    }

                            <!-- search -->
    .lists{
        margin-left: 65px;
        font-size: large;
        list-style: none;
        margin-top: 8px;
    }
    .height{
    height: 100vh;
   

   .search{
   position: relative;
               <!-- box-shadow: 0 0 40px rgba(51, 51, 51, .1); -->
     
   }

   .search input{

    height: 60px;
    text-indent: 25px;
    border: 2px solid #d6d4d4;


   }


   .search input:focus{

    box-shadow: none;
    border: 2px solid blue;


   }

   .search .fa-search{

    position: absolute;
    top: 20px;
    left: 16px;

   }

   .search button{

    position: absolute;
    top: 5px;
    right: 5px;
    height: 50px;
    width: 110px;
    background: blue;

   }

li, a {
    text-decoration: none;
    color : white;
    margin: 12px 0;
}

.navlink {
    /* Additional styling */
    color: white;
    font-family: Roboto;
    font-weight: bold;
    position: relative;
    outline: none !important;
    text-transform: uppercase;
    transition: 0.2s;
}

.navlink::after {
    content: "";
    background-color: white;
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0;
    transition: 0.2s;
}

.navlink:hover,
.navlink:focus {
    color: white;
}
sell
.navlink:hover::after,
.navlink:focus::after {
    background-color: white;
    width: 100%;
}


    
