                                        <t t-esc="city.name"/>
                                    </option>
                                </t>
                            </select>

                            <!-- Divider -->
                            <div style="border-left: 1px solid gray; height: 40px; opacity: 0.3;"></div>

                            <!-- Radio Buttons -->
                            <div style="display: flex; align-items: center; gap: 20px;">
