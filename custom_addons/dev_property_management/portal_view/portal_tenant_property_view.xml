    <template id="portal_tenant_property" name="Show Members" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="placeholder_count" t-value="'tenant_property_count'"/>
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'" />
                <t t-set="title">Tenant Property</t>
                <t t-set="url" t-value="'/my/tenant_property_details'"/>
                <t t-set="text">Follow, view or print your Property</t>
            </t>
        </div>
    </template>

    <template id="portal_breadcrumb_tenant_property" name="Tenant Property Breadcrumb" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
        <li t-if="page_name == 'tenant_property_tree' or tenant_property_sudo" t-attf-class="breadcrumb-item #{'active ' if not tenant_property_sudo else ''}">
        <a t-if="tenant_property_sudo" t-attf-href="/my/tenant_property_details?{{ keep_query() }}"> Tenant Property </a>
        <t t-else="">Tenant Property</t>
        </li>
        <li t-if="tenant_property_sudo" class="breadcrumb-item active">
        <t t-esc="tenant_property_sudo.name"/>
        </li>
        </xpath>
    </template>

    <template id="portal_tenant_properties_details" name="Tenant Property Details">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Tenant Property Details</t>
            </t>
            <t t-if="not grouped_property">
                <div class="alert alert-warning" role="alert">
                    There are no Property.
                </div>
            </t>
            <t t-if="grouped_property" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Reference #</th>
                        <th>Property</th>
                        <th t-if="groupby != 'property_type'">Property Type</th>
                        <th t-if="groupby != 'owner_partner_id'">Property Owner</th>
                        <th>Tenant</th>
                        <th>Confirmation Date</th>
                        <th t-if="groupby != 'state'" class="text-center">State</th>
                    </tr>
                </thead>
                <t t-foreach="grouped_property" t-as="property_group">
                    <tbody>
                        <tr t-if="groupby != 'none'" class="table-light">
                            <th t-if="groupby == 'owner_partner_id'" colspan="6">
                                <em class="font-weight-normal text-muted">Owner :</em>
                                <span t-field="property_group[0].sudo().owner_partner_id"/>
                            </th>
                            <th t-if="groupby == 'state'" colspan="6">
                                <em class="font-weight-normal text-muted">Status :</em>
                                <span t-field="property_group[0].sudo().state"/>
                            </th>
                            <th t-if="groupby == 'property_type'" colspan="6">
                                <em class="font-weight-normal text-muted">Property Type :</em>
                                <span t-field="property_group[0].sudo().property_type"/>
                            </th>
                        </tr>
                    </tbody>
                    <tbody>
                        <tr t-foreach="property_group" t-as="l">
                            <td>
                                <a t-att-href="l.get_portal_url()">
                                    <t t-esc="l.name" />
                                </a>
                            </td>
                            <td>
                                <span t-field="l.property_id" />
                            </td>
                            <td t-if="groupby != 'property_type'">
                                <span t-field="l.property_type" />
                            </td>
                            <td t-if="groupby != 'owner_partner_id'">
                                <span t-field="l.owner_partner_id" />
                            </td>
                            <td>
                                <span t-field="l.partner_id" />
                            </td>
                            <td>
                                <span t-field="l.confirmation_date" />
                            </td>
                            <td t-if="groupby != 'state'" class="text-center">
                                <t t-if="l.state == 'draft'" name="status_draft">
                                    <span class="badge rounded-pill text-bg-info" t-field="l.state"/>
                                </t>
                                <t t-elif="l.state in ('cancelled','closed')" name="status_cancelled">
                                    <span class="badge rounded-pill text-bg-danger" t-field="l.state"/>
                                </t>
                                <t t-else=" " name="status_on_rent">
                                    <span class="badge rounded-pill text-bg-success" t-field="l.state"/>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </t>
            </t>
            <br/>
        </t>
    </template>


    <template id="portal_tenant_property_detail_form" name="Tenant Detail Portal Template"
        inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <div class="row mt16 o_portal_sale_sidebar">
<!--              Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-auto d-print-none'" />
                    <t t-set="title">
                        <h2 class="mb-0">
                            <span t-field="tenant_property_sudo.name" />
                        </h2>
                    </t>
                    <t t-set="entries">
                        <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">
                            <li class="list-group-item flex-grow-1">
                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">
                                    <div class="btn-group flex-grow-1 mr-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_download_btn" t-att-href="tenant_property_sudo.get_portal_url(report_type='pdf', download=True)" title="Download"><i class="fa fa-download"/> Download</a>
                                    </div>
                                    <div class="btn-group flex-grow-1 mb-1" style="margin-left:15px;">
                                        <a class="btn btn-secondary btn-block o_print_btn o_portal_invoice_print" t-att-href="tenant_property_sudo.get_portal_url(report_type='pdf')" id="print_tenant_property_report" title="Print" target="_blank"><i class="fa fa-print"/> Print</a>
                                    </div>
                                </div>
                            </li>
                            <li class="navspy list-group-item pl-0 flex-grow-1" t-ignore="true"
                                role="complementary">
                                <ul class="nav flex-column bs-sidenav"></ul>
                            </li>
                            <li t-if="tenant_property_sudo.partner_id" class="list-group-item flex-grow-1">
                                <div class="small mb-1">
                                    <strong class="text-muted">Your Contact</strong>
                                </div>
                                <div class="row flex-nowrap">
                                    <div class="o_portal_contact_details d-flex flex-column gap-2">
                                        <div class="d-flex justify-content-start align-items-center gap-2">
                                            <img class="o_avatar o_portal_contact_img rounded" t-att-src="image_data_uri(tenant_property_sudo.partner_id.avatar_1024)" alt="Contact"/>
                                            <div>
                                                <span t-field="tenant_property_sudo.partner_id"
                                                 t-options='{"widget": "contact", "fields": ["name", "mobile"], "no_marker": True}'/>
                                                <a href="#discussion" class="d-flex align-items-center gap-2 small fw-bold"><i class="fa fa-comment"></i>
                                                Send message
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </t>
                </t>
                <div id="tenant_detail_content" class="col-12 col-lg justify-content-end">
                    <div t-attf-class="card #{'pb-5' if report_type == 'html' else ''}">
                        <t t-call="dev_property_management.tenant_property_detail_portal_content" />
                    </div>
                    <div id="tenant_detail_communication" class="mt-3">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="tenant_property_sudo" />
                        </t>
                    </div>
                </div>
                <hr />
            </div>
        </xpath>
    </template>

    <template id="tenant_property_detail_portal_content" name="Portal: Owner Property Detail">
        <div id="optional_placeholder"></div>
        <div class="card-header">
            <div class="row">
                <div class="col-lg-9">
                    <h4> Tenant Property #<span t-esc="tenant_property_sudo.name" />
                    </h4>
                </div>
                <div class="col-lg-3" style="background:#875A7B;border-radius:5px">
                    <h2 class="my-0 text-center" style="padding:3px;font-weight:bold">
                        <em style="text-transform: capitalize;color:#FFF" t-esc="tenant_property_sudo.state" />
                    </h2>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Property Type</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5 ">
                            <span t-field="tenant_property_sudo.property_type" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Tenant </div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5">
                            <span t-field="tenant_property_sudo.partner_id" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Property</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5 ">
                            <span t-field="tenant_property_sudo.property_id" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Date</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5">
                            <span t-field="tenant_property_sudo.date" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Property Owner</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5 ">
                            <span t-field="tenant_property_sudo.owner_partner_id" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Confirmation Date</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5">
                            <span t-field="tenant_property_sudo.confirmation_date" />
                        </div>
                    </div>
                </div>
            </div>
            <br></br>
            <span><h5>TENANCY DETAILS</h5></span>
            <hr></hr>
            <div class="row">
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Rent Type</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5 ">
                            <span t-field="tenant_property_sudo.rent_type_id" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Start Date</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5">
                            <span t-field="tenant_property_sudo.start_date" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Monthly Rent</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5 ">
                            <span t-field="tenant_property_sudo.rent_amount" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Duration</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5">
                            <span t-field="tenant_property_sudo.duration" />
                        </div>
                    </div>
                </div>
                
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Deposit Payment</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5">
                            <span t-field="tenant_property_sudo.deposit_amount" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">End Date</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5 ">
                            <span t-field="tenant_property_sudo.end_date" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-5">Agent</div>
                        <div class="col-lg-1 text-align-right">:</div>
                        <div class="col-lg-5">
                            <span t-field="tenant_property_sudo.rent_agent_id" />
                        </div>
                    </div>
                </div>
            </div>
            <br></br>
            
            
            <t t-if="tenant_property_sudo.rent_schedule_ids">
                    <p style="font-weight: bold;font-size: 17px;margin-bottom: 5px;margin-top: 20px;">
                       Rent Schedule
                    </p>
                    <table width="100%" style="table-layout: fixed;" class="table table-condensed">
                        <tr style="word-wrap: break-word;line-height: 10px;">
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Name</b></td>
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Date</b></td>
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Rent Amount</b></td>
                            <!-- <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Cheque Number</b></td> -->
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Status</b></td>
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Payment</b></td>
                        </tr>
                        <span t-set="total_rent" t-value="0"/>
                        <tr t-foreach="tenant_property_sudo.rent_schedule_ids" t-as="line" style="word-wrap: break-word;line-height: 8px;">
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td>
                                <span t-field="line.date" t-options='{"format": "dd/MM/yyyy"}'/>
                            </td>
                            <td>
                                <span t-esc="'{:,.2f}'.format(line.rent_amount)"/>
                                <span t-set="total_rent" t-value="total_rent+line.rent_amount"/>
                            </td>
                            <!-- <td>
                                <span t-field="line.cheque_number"/>
                            </td> -->
                            <td>
                                <span t-field="line.state"/>
                            </td>
                            <td>
                                <span t-field="line.payment_id"/>
                            </td>
                        </tr>
                        <tr style="word-wrap: break-word;line-height: 8px;">
                            <td colspan="2">
                                <center>Total Rent</center>
                            </td>
                            <td>
                                <span t-esc="'{:,.2f}'.format(total_rent)"/>
                            </td>
                            <td colspan="2">
                            </td>
                        </tr>
                    </table>
                </t>
                <t t-if="tenant_property_sudo.maintenance_ids">
                    <p style="font-weight: bold;font-size: 14px;margin-bottom: 5px;margin-top: 20px;">
                        Maintenance Details
                    </p>
                    <table width="100%" style="table-layout: fixed;" class="table table-condensed">
                        <tr style="word-wrap: break-word;line-height: 10px;">
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Maintenance Type</b></td>
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Maintenance Amount</b></td>
                        </tr>
                        <span t-set="total_maintenance" t-value="0"/>
                        <tr t-foreach="tenant_property_sudo.maintenance_ids" t-as="line" style="word-wrap: break-word;line-height: 8px;">
                            <td>
                                <span t-field="line.maintenance_type_id"/>
                            </td>
                            <td>
                                <span t-esc="'{:,.2f}'.format(line.maintenance_amount)"/>
                                <span t-set="total_maintenance" t-value="total_maintenance+line.maintenance_amount"/>
                            </td>
                        </tr>
                        <tr style="word-wrap: break-word;line-height: 8px;">
                            <td>Total Maintenance</td>
                            <td>
                                 <span t-esc="'{:,.2f}'.format(total_maintenance)"/>
                            </td>
                        </tr>
                    </table>
                </t>
                
        </div>
        <div class="oe_structure mb32" />
    </template>
</odoo>
