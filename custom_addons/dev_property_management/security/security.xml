<odoo>
    <!--category-->
    <record model="res.groups.privilege" id="category_property">
        <field name="name">Property</field>
        <field name="sequence">5</field>
    </record>

    <!-- groups-->
   <record id="group_property_tenant" model="res.groups">
       <field name="name">Tenant</field>
       <field name="privilege_id" ref="category_property"/>
   </record>
   <record id="group_property_owner" model="res.groups">
       <field name="name">Owner</field>
       <field name="privilege_id" ref="category_property"/>
       <field name="implied_ids" eval="[(4, ref('group_property_tenant'))]"/>
   </record>
    <record id="group_property_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="category_property"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>