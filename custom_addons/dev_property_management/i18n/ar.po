#. module: dev_property_management
#: model:mail.template,body_html:dev_property_management.template_property_agreement_send_by_mail
msgid ""
"<div style=\"background-color:#F3F5F6;color:#515166;font-family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"                <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                <br/>\n"
"                <t t-if=\"object.type == 'sell'\">\n"
"                    <p>Sell Agreement details are as below</p>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <p>Rent Agreement details are as below</p>\n"
"                </t>\n"
"                <br/>\n"
"                <p>\n"
"                    <span style=\"font-weight: bold;\">Property : </span> <t t-out=\"object.partner_id.name\"/><br/>\n"
"                    <span style=\"font-weight: bold;\">Agreement Date : </span> <t t-out=\"object.get_agreement_date()\"/><br/>\n"
"                    <t t-if=\"object.type == 'rent'\">\n"
"                        <span style=\"font-weight: bold;\">Expiry Date : </span> <t t-out=\"object.get_expiry_date()\"/><br/>\n"
"                    </t>\n"
"                </p>\n"
"                <br/>\n"
"                <p t-raw=\"object.description\"/>\n"
"                <br/>\n"
"                <br/>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"background-color:#F3F5F6;color:#515166;font-family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"                <p>مرحبًا <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                <br/>\n"
"                <t t-if=\"object.type == 'sell'\">\n"
"                    <p>تفاصيل اتفاقية البيع هي كما يلي</p>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <p>تفاصيل اتفاقية الإيجار هي كما يلي</p>\n"
"                </t>\n"
"                <br/>\n"
"                <p>\n"
"                    <span style=\"font-weight: bold;\">ملكية : </span> <t t-out=\"object.partner_id.name\"/><br/>\n"
"                    <span style=\"font-weight: bold;\">تاريخ الاتفاقية : </span> <t t-out=\"object.get_agreement_date()\"/><br/>\n"
"                    <t t-if=\"object.type == 'rent'\">\n"
"                        <span style=\"font-weight: bold;\">تاريخ انتهاء الصلاحية : </span> <t t-out=\"object.get_expiry_date()\"/><br/>\n"
"                    </t>\n"
"                </p>\n"
"                <br/>\n"
"                <p t-raw=\"object.description\"/>\n"
"                <br/>\n"
"                <br/>\n"
"            </div>\n"
"        "

