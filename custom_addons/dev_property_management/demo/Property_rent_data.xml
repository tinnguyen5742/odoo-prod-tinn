<odoo  noupdate="1" >


    <record id="property_owner_1" model="res.partner">
        <field name="name">Lumber Inc</field>
        <field name="is_owner">True</field>
    </record>

    <record id="property_tenant_1" model="res.partner">
        <field name="name">Rajat</field>
        <field name="is_tenant">True</field>
    </record>

    <record id="property_agent_1" model="res.partner">
        <field name="name">Karan</field>
        <field name="is_agent">True</field>
    </record>
    

    <record id="property_rent_with_notebook" model="property.property">
       
        <field name="name">Amazon Warehouse </field>
        <field name="property_type">industrial</field>
        <field  name="photo" type="base64" file="dev_property_management/static/src/img/amazon-fc.jpg"/>
        <field name="property_purpose">rent</field>
        <field name="owner_partner_id" ref="dev_property_management.property_owner_1"/>
        <field name="construct_year">2002</field>
        <field name="rent_amount">5000000</field>
        <field name="deposit_amount">1000000</field>
        <field name="facing_id" ref="dev_property_management.facing_1" /> 
        <field name="industrial_location">inside_city</field>
        <field name="property_number">501</field>
        <field name="industrial_type_id" ref="dev_property_management.warehouse_industrial_type" />
        <field name="street">Visat</field>
        <field name="street2">Motera</field>
        <field name="city_id" ref="dev_property_management.city_1"/>
        <field name="zip">360005</field>
        <field name="total_square_foot">2000</field>
        <field name="description"><![CDATA[This is a detailed description of the property.]]></field>
        <field name="amenity_ids" eval="[(6, 0, [ref('security_property_amenities'),ref('cctv_property_amenities'),ref('parking_safety_property_amenities'),ref('power_property_amenities'),ref('water_property_amenities')])]"/>
        <field name="nearby_connectivity_ids" eval="[(6, 0, [ref('bus_nearby_connectivity'),ref('fuel_nearby_connectivity'),ref('hospital_nearby_connectivity'),ref('school_nearby_connectivity'),ref('park_nearby_connectivity')])]"  />
        <field  name="brochure" type="base64" file="dev_property_management/static/src/img/Brochure (5)-1.png"/>
        <field name="proprty_document_ids" eval="[
            (0, 0, {'name':'Agreement'}),
            
        ]"/>
        <field name="area_measurement_ids" eval="[
            (0, 0, {'name':'Warehouse' ,'length': 200 ,'width':200 ,'height':200}),
            

        ]"/>

    </record>



    <record id="property_documents_demo" model="ir.attachment">
        <field name="name">Property Floor Plan</field>
        <field name="datas" type="base64" file="dev_property_management/static/src/img/download.jpeg"/>
        <field name="res_model">property.property</field>
        <field name="fp_property_id" ref="dev_property_management.property_rent_with_notebook"/>
        <field name="res_id" >1</field>
        <field name="type">binary</field>
    </record>

    <record id="property_documents_demos" model="ir.attachment">
        <field name="name">Property image 1</field>
        <field name="datas" type="base64" file="dev_property_management/static/src/img/amazon-fc.jpg"/>
        <field name="res_model">property.property</field>
        <field name="property_id" ref="dev_property_management.property_rent_with_notebook"/>
        <field name="res_id" >1</field>
        <field name="type">binary</field>
    </record>
    
    

</odoo>
