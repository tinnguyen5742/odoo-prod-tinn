<odoo noupdate="1" >


    <record id="property_owner_1" model="res.partner">
        <field name="name">Lumber Inc</field>
        <field name="is_owner">True</field>
    </record>


    <record id="property_commercial_sell_with_notebook" model="property.property">
       
        <field name="name">Nihar Business Center</field>
        <field name="property_type">commercial</field>
        <field  name="photo" type="base64" file="dev_property_management/static/src/img/nihar.jpeg"/>
        <field name="property_purpose">sell</field>
        <field name="owner_partner_id" ref="dev_property_management.property_owner_1"/>
        <field name="construct_year">2012</field>
        <field name="price_amount">3000000</field>
        <field name="property_status">new</field>
        <field name="facing_id" ref="dev_property_management.facing_2" /> 
        <field name="property_number">201</field>
        <field name="commercial_type_id" ref="dev_property_management.hotel_commercial_type" />
        <field name="street">Mavadi</field>
        <field name="street2">Mavadi</field>
        <field name="city_id" ref="dev_property_management.city_2"/>
        <field name="zip">360055</field>
        <field name="total_square_foot">3000</field>
        <field name="description"><![CDATA[This is a detailed description of the property.]]></field>
        <field name="amenity_ids" eval="[(6, 0, [ref('security_property_amenities'),ref('cctv_property_amenities'),ref('parking_safety_property_amenities'),ref('power_property_amenities'),ref('water_property_amenities')])]"/>
        <field name="nearby_connectivity_ids" eval="[(6, 0, [ref('bus_nearby_connectivity'),ref('fuel_nearby_connectivity'),ref('hospital_nearby_connectivity'),ref('school_nearby_connectivity'),ref('park_nearby_connectivity')])]"  />
        <field  name="brochure" type="base64" file="dev_property_management/static/src/img/Brochure (7)-1.png"/>
        <field name="proprty_document_ids" eval="[
            (0, 0, {'name':'Agreement'}),
            
        ]"/>
        <field name="area_measurement_ids" eval="[
            (0, 0, {'name':'Hotel Room' ,'length': 100 ,'width':100 ,'height':100}),
            

        ]"/>

    </record>



    <record id="property_commercial_sell_demos" model="ir.attachment">
        <field name="name">Property Floor Plan</field>
        <field name="datas" type="base64" file="dev_property_management/static/src/img/images.jpeg"/>
        <field name="res_model">property.property</field>
        <field name="fp_property_id" ref="dev_property_management.property_commercial_sell_with_notebook"/>
        <field name="res_id" >1</field>
        <field name="type">binary</field>
    </record>

    <record id="property_commercial_sell_demo" model="ir.attachment">
        <field name="name">Property image 1</field>
        <field name="datas" type="base64" file="dev_property_management/static/src/img/images (1).jpeg"/>
        <field name="res_model">property.property</field>
        <field name="property_id" ref="dev_property_management.property_commercial_sell_with_notebook"/>
        <field name="res_id" >1</field>
        <field name="type">binary</field>
    </record>
    
    

</odoo>
