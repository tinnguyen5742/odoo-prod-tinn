<odoo>
    <template id="main_booking_history_pdf_template">
        <t t-call="web.external_layout">
            <div class="page" style="font-size: 12px;">
                <span style="font-size: 18px;font-weight: bold;">
                    <center>Booking History</center>
                </span>
                <table width="100%" style="font-size: 14px;">
                    <td>
                        <b>Start Date</b>&#160;:&#160;
                        <span t-field="o.start_date" t-options='{"format": "dd/MM/yyyy"}'/>
                    </td>
                    <td style="text-align:right;">
                        <b>End Date</b>&#160;:&#160;
                        <span t-field="o.end_date" t-options='{"format": "dd/MM/yyyy"}'/>
                    </td>
                </table>
                <span t-set="booking_details" t-value="get_booking_details(o)"/>
                <table width="100%" style="table-layout: fixed;margin-top: 20px;" class="table table-condensed">
                    <tr style="word-wrap: break-word;line-height: 16px;">
                        <td width="13%" style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Booking</b></td>
                        <td width="15%" style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Property</b></td>
                        <td width="12%" style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Booking Date</b></td>
                        <td width="15%" style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Booked By</b></td>
                        <td width="15%" style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Contact</b></td>
                        <td width="10%" style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Sell Price</b></td>
                        <td width="10%" style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Ask Price</b></td>
                        <td width="10%" style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Status</b></td>
                    </tr>
                    <t t-if="booking_details">
                        <tr t-foreach="booking_details" t-as="line" style="word-wrap: break-word;line-height: 16px;">
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td>
                                <span t-esc="line.property_id and line.property_id.name or ''"/>
                            </td>
                            <td>
                                <span t-field="line.booking_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            </td>
                            <td>
                                <span t-field="line.create_uid"/>
                            </td>
                            <td>
                                <span t-field="line.partner_id"/>
                            </td>
                            <td>
                                <span t-esc="'{:,.2f}'.format(line.price_amount)"/>
                            </td>
                            <td>
                                <span t-esc="'{:,.2f}'.format(line.ask_price_amount)"/>
                            </td>
                            <td>
                                <span t-field="line.state"/>
                            </td>
                        </tr>
                    </t>
                </table>
            </div>
        </t>
    </template>

    <template id="booking_history_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="dev_property_management.main_booking_history_pdf_template"/>
            </t>
        </t>
    </template>
</odoo>