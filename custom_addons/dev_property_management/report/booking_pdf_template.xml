<odoo>
    <template id="main_booking_pdf_template">
        <t t-call="web.external_layout">
            <div class="page" style="font-size: 12px;">
                <span style="font-size: 18px;font-weight: bold;">
                    <center><span t-field="o.name"/></center>
                </span>
                <table width="100%" style="margin-top: 30px;">
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Property Type</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.property_type"/>
                        </td>
                        <td width="12%"><b>Booked By</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.create_uid"/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Property</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.property_id"/>
                        </td>
                        <td width="12%"><b>Date</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.booking_date" t-options='{"format": "dd/MM/yyyy"}'/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Last Owner</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.owner_partner_id"/>
                        </td>
                        <td width="12%"><b>Confirmation Date</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.confirmation_date" t-options='{"format": "dd/MM/yyyy"}'/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Selling Price</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-esc="'{:,.2f}'.format(o.price_amount)"/>
                        </td>
                        <td width="12%"></td>
                        <td width="5%"></td>
                        <td width="33%">
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Contact</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.partner_id"/>
                        </td>
                        <td width="12%"><b>Ask Price</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-esc="'{:,.2f}'.format(o.ask_price_amount)"/>
                        </td>
                    </tr>
                </table>
                <p style="font-weight: bold;font-size: 14px;margin-bottom: 5px;margin-top: 20px;">
                    Commission Details
                </p>
                <table width="100%">
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Commission Type</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.commission_type"/>
                        </td>
                        <td width="12%"><b>Agent</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.agent_partner_id"/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Commission</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-esc="'{:,.2f}'.format(o.commission_amount)"/>
                        </td>
                        <td width="12%"><b>Payment</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.commission_payment_id"/>
                        </td>
                    </tr>
                </table>
                <t t-if="o.description">
                    <p style="font-weight: bold;font-size: 14px;margin-bottom: 5px;margin-top: 20px;">
                        Description
                    </p>
                    <p>
                        <span t-raw="o.description"/>
                    </p>
                </t>
            </div>
        </t>
    </template>

    <template id="booking_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="dev_property_management.main_booking_pdf_template"/>
            </t>
        </t>
    </template>
</odoo>