<odoo>
    <template id="main_tenancy_pdf_template">
        <t t-call="web.external_layout">
            <div class="page" style="font-size: 12px;">
                <span style="font-size: 18px;font-weight: bold;">
                    <center><span t-field="o.name"/></center>
                </span>
                <table width="100%" style="margin-top: 30px;">
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Property Type</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.property_type"/>
                        </td>
                        <td width="12%"><b>Tenant</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.partner_id"/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Property</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.property_id"/>
                        </td>
                        <td width="12%"><b>Date</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.date" t-options='{"format": "dd/MM/yyyy"}'/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Property Owner</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.owner_partner_id"/>
                        </td>
                        <td width="12%"></td>
                        <td width="5%"></td>
                        <td width="33%">
                        </td>
                    </tr>
                </table>
                <p style="font-weight: bold;font-size: 14px;margin-bottom: 5px;margin-top: 20px;">
                    Tenancy Details
                </p>
                <table width="100%">
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Rent Type</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.rent_type_id"/>
                        </td>
                        <td width="12%"><b>Start Date</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.start_date" t-options='{"format": "dd/MM/yyyy"}'/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Monthly Rent</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-esc="'{:,.2f}'.format(o.rent_amount)"/>
                        </td>
                        <td width="12%"><b>Duration</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-esc="get_duration(o)"/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Security Deposit</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-esc="'{:,.2f}'.format(o.deposit_amount)"/>
                        </td>
                        <td width="12%"><b>End Date</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                             <span t-field="o.end_date" t-options='{"format": "dd/MM/yyyy"}'/>
                        </td>
                    </tr>
                    <tr style="line-height: 20px;">
                        <td width="12%"><b>Deposit Payment</b></td>
                        <td width="5%">:</td>
                        <td width="33%">
                            <span t-field="o.deposit_payment_id"/>
                        </td>
                        <td width="12%"></td>
                        <td width="5%"></td>
                        <td width="33%">
                        </td>
                    </tr>
                </table>

                <t t-if="o.rent_schedule_ids">
                    <p style="font-weight: bold;font-size: 14px;margin-bottom: 5px;margin-top: 20px;">
                        Rent Schedule
                    </p>
                    <table width="100%" style="table-layout: fixed;" class="table table-condensed">
                        <tr style="word-wrap: break-word;line-height: 10px;">
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Name</b></td>
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Date</b></td>
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Rent Amount</b></td>
                            <!-- <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Cheque Number</b></td> -->
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Status</b></td>
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Payment</b></td>
                        </tr>
                        <span t-set="total_rent" t-value="0"/>
                        <tr t-foreach="o.rent_schedule_ids" t-as="line" style="word-wrap: break-word;line-height: 8px;">
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td>
                                <span t-field="line.date" t-options='{"format": "dd/MM/yyyy"}'/>
                            </td>
                            <td>
                                <span t-esc="'{:,.2f}'.format(line.rent_amount)"/>
                                <span t-set="total_rent" t-value="total_rent+line.rent_amount"/>
                            </td>
                            <!-- <td>
                                <span t-field="line.cheque_number"/>
                            </td> -->
                            <td>
                                <span t-field="line.state"/>
                            </td>
                            <td>
                                <span t-field="line.payment_id"/>
                            </td>
                        </tr>
                        <tr style="word-wrap: break-word;line-height: 8px;">
                            <td colspan="2">
                                <center>Total Rent</center>
                            </td>
                            <td>
                                <span t-esc="'{:,.2f}'.format(total_rent)"/>
                            </td>
                            <td colspan="2">
                            </td>
                        </tr>
                    </table>
                </t>
                <t t-if="o.maintenance_ids">
                    <p style="font-weight: bold;font-size: 14px;margin-bottom: 5px;margin-top: 20px;">
                        Maintenance Details
                    </p>
                    <table width="100%" style="table-layout: fixed;" class="table table-condensed">
                        <tr style="word-wrap: break-word;line-height: 10px;">
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Maintenance Type</b></td>
                            <td style="border-bottom: 2px solid black;border-top: 1px solid white;"><b>Maintenance Amount</b></td>
                        </tr>
                        <span t-set="total_maintenance" t-value="0"/>
                        <tr t-foreach="o.maintenance_ids" t-as="line" style="word-wrap: break-word;line-height: 8px;">
                            <td>
                                <span t-field="line.maintenance_type_id"/>
                            </td>
                            <td>
                                <span t-esc="'{:,.2f}'.format(line.maintenance_amount)"/>
                                <span t-set="total_maintenance" t-value="total_maintenance+line.maintenance_amount"/>
                            </td>
                        </tr>
                        <tr style="word-wrap: break-word;line-height: 8px;">
                            <td>Total Maintenance</td>
                            <td>
                                 <span t-esc="'{:,.2f}'.format(total_maintenance)"/>
                            </td>
                        </tr>
                    </table>
                </t>
                <t t-if="o.description">
                    <p style="font-weight: bold;font-size: 14px;margin-bottom: 5px;margin-top: 20px;">
                        Description
                    </p>
                    <p>
                        <span t-field="o.description"/>
                    </p>
                </t>
            </div>
        </t>
    </template>

    <template id="tenancy_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="dev_property_management.main_tenancy_pdf_template"/>
            </t>
        </t>
    </template>
</odoo>