<odoo>
    <template id="main_due_rent_pdf_template">
        <t t-call="web.external_layout">
            <div class="page" style="font-size: 12px;">
                <span style="font-size: 18px;font-weight: bold;">
                    <center>Due Rent Report</center>
                </span>
                <table width="100%" style="font-size: 14px;">
                    <td>
                        <b>Start Date</b>&#160;:&#160;
                        <span t-field="o.start_date" t-options='{"format": "dd/MM/yyyy"}'/>
                    </td>
                    <td style="text-align:right;">
                        <b>End Date</b>&#160;:&#160;
                        <span t-field="o.end_date" t-options='{"format": "dd/MM/yyyy"}'/>
                    </td>
                </table>
                <span t-set="rent_details" t-value="get_rent_details(o)"/>
                <t t-if="rent_details">
                    <t t-foreach="rent_details" t-as="rent">
                        <table width="100%" style="table-layout: fixed;margin-top: 20px;">
                            <tr style="line-height:22px;word-wrap: break-word;page-break-inside: avoid;">
                                <td style="background: #DCDADA;border-top: 1px solid black;border-bottom: 1px solid black;">
                                    <b><span t-esc="rent"/></b>
                                </td>
                            </tr>
                        </table>
                        <table width="100%" style="table-layout: fixed;;margin-top: 5px;">
                            <tr style="word-wrap: break-word;page-break-inside: avoid;line-height:16px;">
                                <td width="15%">
                                    <b>Rent</b>
                                </td>
                                <td width="40%">
                                    <b>Property</b>
                                </td>
                                <td width="15%">
                                    <b>Rent Date</b>
                                </td>
                                <td width="15%">
                                    <b>Rent Amount</b>
                                </td>
                                <td width="15%">
                                   <b>Status</b>
                                </td>
                            </tr>
                            <tr t-foreach="rent_details[rent]" t-as="line"
                                style="word-wrap: break-word;page-break-inside: avoid;line-height:16px;">
                                <td style="border-bottom: 1px solid #E5E8E8;padding-top: 2px;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="border-bottom: 1px solid #E5E8E8;padding-top: 2px;">
                                    <span t-esc="line.property_id and line.property_id.name or ''"/>
                                </td>
                                <td style="border-bottom: 1px solid #E5E8E8;padding-top: 2px;">
                                    <span t-field="line.date" t-options='{"format": "dd/MM/yyyy"}'/>
                                </td>
                                <td style="border-bottom: 1px solid #E5E8E8;padding-top: 2px;">
                                    <t t-esc="'{0:,.2f}'.format(line.rent_amount)"/>
                                </td>
                                <td style="border-bottom: 1px solid #E5E8E8;padding-top: 2px;">
                                    <span t-field="line.state"/>
                                </td>
                            </tr>
                        </table>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <template id="due_rent_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="dev_property_management.main_due_rent_pdf_template"/>
            </t>
        </t>
    </template>
</odoo>