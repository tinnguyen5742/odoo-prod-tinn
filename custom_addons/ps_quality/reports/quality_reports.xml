<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_quality_inspection" model="ir.actions.report">
        <field name="name">Quality Inspection</field>
        <field name="model">ps.quality.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_quality.report_quality_inspection</field>
        <field name="report_file">ps_quality.report_quality_inspection</field>
        <field name="binding_model_id" ref="model_ps_quality_inspection"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_quality_ncr" model="ir.actions.report">
        <field name="name">Non-Conformance Report</field>
        <field name="model">ps.quality.ncr</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_quality.report_quality_ncr</field>
        <field name="report_file">ps_quality.report_quality_ncr</field>
        <field name="binding_model_id" ref="model_ps_quality_ncr"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_quality_capa" model="ir.actions.report">
        <field name="name">Corrective and Preventive Action</field>
        <field name="model">ps.quality.capa</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_quality.report_quality_capa</field>
        <field name="report_file">ps_quality.report_quality_capa</field>
        <field name="binding_model_id" ref="model_ps_quality_capa"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_quality_inspection">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Quality Inspection <span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6"><strong>Type:</strong> <span t-field="o.inspection_type"/></div>
                            <div class="col-6"><strong>Date:</strong> <span t-field="o.inspection_date"/></div>
                            <div class="col-6"><strong>Product:</strong> <span t-field="o.product_id"/></div>
                            <div class="col-6"><strong>Supplier / Customer:</strong> <span t-field="o.partner_id"/></div>
                            <div class="col-6"><strong>Standard:</strong> <span t-field="o.standard_id"/></div>
                            <div class="col-6"><strong>Inspector:</strong> <span t-field="o.inspector_id"/></div>
                            <div class="col-6"><strong>Result:</strong> <span t-field="o.result"/></div>
                            <div class="col-6"><strong>Status:</strong> <span t-field="o.state"/></div>
                        </div>
                        <table class="table table-sm mt-3">
                            <thead><tr><th>Criterion</th><th>Limits</th><th>Observed</th><th>Result</th><th>Remarks</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-if="line.has_minimum" t-field="line.min_value"/> <span t-if="line.has_minimum and line.has_maximum">–</span> <span t-if="line.has_maximum" t-field="line.max_value"/> <span t-field="line.unit"/></td>
                                    <td><span t-field="line.observed_value"/></td>
                                    <td><span t-field="line.result"/></td>
                                    <td><span t-field="line.remarks"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p><strong>Disposition:</strong> <span t-field="o.disposition"/></p>
                        <div t-if="o.description"><strong>Notes</strong><div t-field="o.description"/></div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_quality_ncr">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Non-Conformance Report <span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6"><strong>Title:</strong> <span t-field="o.title"/></div>
                            <div class="col-6"><strong>Severity:</strong> <span t-field="o.severity"/></div>
                            <div class="col-6"><strong>Source:</strong> <span t-field="o.source_type"/></div>
                            <div class="col-6"><strong>Status:</strong> <span t-field="o.state"/></div>
                            <div class="col-6"><strong>Product:</strong> <span t-field="o.product_id"/></div>
                            <div class="col-6"><strong>Supplier / Customer:</strong> <span t-field="o.partner_id"/></div>
                            <div class="col-6"><strong>Owner:</strong> <span t-field="o.assigned_id"/></div>
                            <div class="col-6"><strong>Due Date:</strong> <span t-field="o.due_date"/></div>
                        </div>
                        <h4 class="mt-3">Root cause</h4><div t-field="o.root_cause"/>
                        <h4 class="mt-3">Containment action</h4><div t-field="o.containment_action"/>
                        <p class="mt-3"><strong>Disposition:</strong> <span t-field="o.disposition"/></p>
                        <div t-if="o.description"><strong>Notes</strong><div t-field="o.description"/></div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_quality_capa">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Corrective and Preventive Action <span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6"><strong>NCR:</strong> <span t-field="o.ncr_id"/></div>
                            <div class="col-6"><strong>Type:</strong> <span t-field="o.action_type"/></div>
                            <div class="col-6"><strong>Owner:</strong> <span t-field="o.assigned_id"/></div>
                            <div class="col-6"><strong>Due Date:</strong> <span t-field="o.due_date"/></div>
                            <div class="col-6"><strong>Status:</strong> <span t-field="o.state"/></div>
                            <div class="col-6"><strong>Effectiveness:</strong> <span t-field="o.effectiveness_result"/></div>
                        </div>
                        <h4 class="mt-3">Root cause</h4><div t-field="o.root_cause"/>
                        <h4 class="mt-3">Corrective action</h4><div t-field="o.corrective_action"/>
                        <h4 class="mt-3">Preventive action</h4><div t-field="o.preventive_action"/>
                        <h4 class="mt-3">Effectiveness review</h4><div t-field="o.effectiveness_note"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
