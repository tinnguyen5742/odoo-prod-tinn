<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action Server Tối ưu tuyến đường theo khu vực -->
    <record id="action_server_optimize_route" model="ir.actions.server">
        <field name="name">Tối ưu tuyến đường theo khu vực</field>
        <field name="model_id" ref="model_field_service_order"/>
        <field name="binding_model_id" ref="model_field_service_order"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_optimize_route()</field>
    </record>

    <!-- Giao diện Danh sách -->
    <record id="view_field_service_order_tree" model="ir.ui.view">
        <field name="name">field.service.order.tree</field>
        <field name="model">field.service.order</field>
        <field name="arch" type="xml">
            <list string="Phiếu dịch vụ hiện trường" decoration-danger="is_sla_failed == True" decoration-warning="priority == '3'">
                <header>
                    <button name="%(action_server_optimize_route)d" type="action" string="Tối ưu tuyến đường" class="btn-primary"/>
                </header>

                <field name="name"/>
                <field name="customer_id"/>
                <field name="asset_id"/>
                <field name="area_id"/>
                <field name="technician_id"/>
                <field name="scheduled_date"/>
                <field name="sla_deadline"/>
                <field name="priority" widget="priority"/>
                <field name="total_expense" sum="Tổng chi phí"/>
                <field name="is_sla_failed" column_invisible="True"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('assigned', 'in_progress')" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Giao diện Kanban có màu sắc cảnh báo theo SLA & Sắp xếp theo hạn chót -->
    <record id="view_field_service_order_kanban" model="ir.ui.view">
        <field name="name">field.service.order.kanban</field>
        <field name="model">field.service.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="priority"/>
                <field name="is_sla_failed"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click flex-column #{record.is_sla_failed.raw_value ? 'border-danger bg-danger-subtle' : (record.priority.raw_value == '3' ? 'border-warning bg-warning-subtle' : '')}">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="o_kanban_record_title text-primary"><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-dark fw-bold mb-1"><field name="customer_id"/></div>
                            <div class="text-muted small mb-1">Máy: <field name="asset_id"/></div>
                            <div class="text-muted small mb-1">KT: <field name="technician_id"/></div>
                            
                            <!-- Nhãn cảnh báo nổi bật -->
                            <div t-if="record.is_sla_failed.raw_value" class="badge text-bg-danger mb-1 p-1">⚠️ Đã quá hạn SLA!</div>
                            
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top text-muted small">
                                <span><i class="fa fa-clock-o"/> Hẹn: <field name="scheduled_date"/></span>
                            </div>
                            <div class="text-danger small fw-bold" t-if="record.sla_deadline">
                                <i class="fa fa-hourglass-end"/> SLA: <field name="sla_deadline"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Giao diện Form Chi tiết -->
    <record id="view_field_service_order_form" model="ir.ui.view">
        <field name="name">field.service.order.form</field>
        <field name="model">field.service.order</field>
        <field name="arch" type="xml">
            <form string="Phiếu dịch vụ">
                <header>
                    <button name="action_assign" string="Phân công" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_in_progress" string="Bắt đầu thực hiện" type="object" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_done" string="Hoàn thành &amp; Nghiệm thu" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Hủy phiếu" type="object" class="btn-secondary" invisible="state in ('done', 'cancel')"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Khách hàng &amp; Thiết bị">
                            <field name="customer_id" options="{'no_create': True}"/>
                            <field name="asset_id" domain="[('partner_id', '=', customer_id)]" options="{'no_create': True}"/>
                            <field name="address" placeholder="Nhập địa điểm thực hiện..."/>
                        </group>
                        <group string="Lịch trình &amp; Phân công">
                            <field name="area_id" options="{'no_create': True}"/>
                            <field name="technician_id" options="{'no_create': True}"/>
                            <field name="scheduled_date"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Mô tả công việc">
                            <field name="description" placeholder="Yêu cầu dịch vụ từ khách hàng..."/>
                        </page>
                        <page string="Địa điểm &amp; Bản đồ">
                            <group string="Tọa độ GPS (Tùy chọn)">
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>

                            <!-- Nút bấm mở Google Maps dẫn đường -->
                            <div class="mt-3 mb-3">
                                <div invisible="not address">
                                    <button name="action_open_google_maps" type="object" class="btn btn-primary" icon="fa-map-marker">
                                        Mở Google Maps chỉ đường theo Địa chỉ
                                    </button>
                                    <span class="text-muted ms-2">(Hệ thống tự động tìm đường dựa trên địa chỉ đã nhập)</span>
                                </div>

                                <div invisible="address" class="text-muted fst-italic">
                                    Vui lòng nhập địa chỉ khách hàng để bật tính năng chỉ đường bản đồ.
                                </div>
                            </div>

                            <div class="text-muted mt-2">
                                <i>Kỹ thuật viên chỉ cần bấm nút, phần mềm sẽ tự động mở Google Maps dẫn đến đúng địa chỉ nhà khách hàng.</i>
                            </div>
                        </page>
                        <page string="Vật tư &amp; Linh kiện">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Chi phí phát sinh">
                            <field name="expense_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_expense" widget="monetary"/>
                            </group>
                        </page>
                        <page string="SLA &amp; Hiệu suất KPI">
                            <group>
                                <field name="sla_deadline"/>
                                <field name="is_sla_failed" readonly="1"/>
                                <field name="is_under_warranty"/>
                                <field name="first_time_fix"/>
                                <field name="processing_hours"/>
                            </group>
                        </page>
                        <page string="Nghiệm thu &amp; Chữ ký">
                            <group>
                                <field name="resolution_notes" placeholder="Ghi chú kết quả sửa chữa..."/>
                            </group>
                            <group string="Chữ ký xác nhận của khách hàng">
                                <field name="customer_signature" widget="signature" class="oe_avatar"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Menu Actions -->
    <record id="action_customer_asset" model="ir.actions.act_window">
        <field name="name">Thiết bị khách hàng</field>
        <field name="res_model">customer.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_field_service_order" model="ir.actions.act_window">
        <field name="name">Phiếu công tác (Work Orders)</field>
        <field name="res_model">field.service.order</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_field_service_root" name="Field Service" sequence="10"/>
    <menuitem id="menu_field_service_order" name="Phiếu công tác" parent="menu_field_service_root" action="action_field_service_order" sequence="10"/>
    <menuitem id="menu_customer_asset" name="Quản lý thiết bị" parent="menu_field_service_root" action="action_customer_asset" sequence="20"/>
</odoo>
