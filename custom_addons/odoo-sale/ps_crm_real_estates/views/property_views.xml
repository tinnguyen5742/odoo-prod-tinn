<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_view_form_inherit_commission" model="ir.ui.view">
        <field name="name">property.property.form.inherit.commission</field>
        <field name="model">property.property</field>
        <field name="inherit_id" ref="dev_property_management.form_property_dev_property_managementt"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="Agent Commission" name="agent_commission">
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="commission_type"/>
                        <field name="commission_fixed_amount" widget="monetary"
                               invisible="commission_type == 'percentage'"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="commission_percentage" invisible="commission_type == 'fixed'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="sub_property_view_form_inherit_commission" model="ir.ui.view">
        <field name="name">property.property.sub.form.inherit.commission</field>
        <field name="model">property.property</field>
        <field name="inherit_id" ref="dev_property_management.form_property_dev_property_management"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="Agent Commission" name="agent_commission">
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="commission_type"/>
                        <field name="commission_fixed_amount" widget="monetary"
                               invisible="commission_type == 'percentage'"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="commission_percentage" invisible="commission_type == 'fixed'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
