<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="consultation_call_dashboard_view_list" model="ir.ui.view">
        <field name="name">crm.lead.consultation.dashboard.list</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Consultation Calls Dashboard" create="0" edit="0" delete="0"
                  default_order="latest_consultation_start_date desc, id desc">
                <field name="name" string="Call Title"/>
                <field name="consultation_owner_id"/>
                <field name="latest_consultation_result_id"/>
                <field name="consultation_status" decoration-success="consultation_status == 'done'"/>
                <field name="latest_consultation_start_date"/>
                <field name="user_id" string="Performed By" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="consultation_call_dashboard_view_search" model="ir.ui.view">
        <field name="name">crm.lead.consultation.dashboard.search</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search string="Consultation Calls Dashboard">
                <field name="name" string="Call Title"/>
                <field name="consultation_owner_id"/>
                <field name="latest_consultation_result_id"/>
                <field name="user_id" string="Performed By"/>
                <filter name="my_calls" string="My Calls" domain="[('user_id', '=', uid)]"/>
                <filter name="start_date" string="Start Date" date="latest_consultation_start_date"/>
                <group>
                    <filter name="group_by_user" string="Performed By" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_start_date" string="Start Date"
                            context="{'group_by': 'latest_consultation_start_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_consultation_call_dashboard" model="ir.actions.act_window">
        <field name="name">Consultation Calls Dashboard</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="consultation_call_dashboard_view_list"/>
        <field name="search_view_id" ref="consultation_call_dashboard_view_search"/>
        <field name="domain">[('latest_consultation_call_id', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No consultation calls yet</p>
            <p>Add a consultation call with a start date and time to a CRM lead or opportunity.</p>
        </field>
    </record>

    <menuitem id="menu_consultation_call_dashboard"
              name="Consultation Calls Dashboard"
              parent="dev_property_management.property_menu_Dashboard"
              action="action_consultation_call_dashboard"
              groups="sales_team.group_sale_salesman"
              sequence="3"/>
</odoo>
