<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_consultation_calls" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.consultation.calls</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="consultation_calls" string="Consultation Calls">
                    <field name="consultation_call_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="start_date"/>
                            <field name="result_id"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
