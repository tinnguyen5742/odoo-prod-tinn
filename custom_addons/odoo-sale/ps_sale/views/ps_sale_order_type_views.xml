<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search view SO Order Type -->
    <record id="view_ps_sale_order_type_search" model="ir.ui.view">
        <field name="name">ps.sale.order.type.search</field>
        <field name="model">ps.sale.order.type</field>
        <field name="arch" type="xml">
            <search string="Search Order Types">
                <field name="code"/>
                <field name="name"/>
                <field name="template"/>
                <field name="behavior"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- List view SO Order Type -->
    <record id="view_ps_sale_order_type_tree" model="ir.ui.view">
        <field name="name">ps.sale.order.type.list</field>
        <field name="model">ps.sale.order.type</field>
        <field name="arch" type="xml">
            <list string="Order Types (Acumatica)">
                <header>
                    <button name="action_sync_from_acumatica"
                            string="Sync from Acumatica"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"/>
                </header>
                <field name="code"/>
                <field name="name"/>
                <field name="template" optional="show"/>
                <field name="behavior" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form view SO Order Type -->
    <record id="view_ps_sale_order_type_form" model="ir.ui.view">
        <field name="name">ps.sale.order.type.form</field>
        <field name="model">ps.sale.order.type</field>
        <field name="arch" type="xml">
            <form string="Order Type (Acumatica)">
                <header>
                    <button name="action_sync_from_acumatica"
                            string="Sync from Acumatica"
                            type="object"
                            class="btn-secondary"
                            icon="fa-refresh"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. SO, CT..."/>
                            <field name="name" placeholder="e.g. Sales Order, Counter Sale..."/>
                        </group>
                        <group>
                            <field name="template"/>
                            <field name="behavior"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window for Order Type -->
    <record id="action_ps_sale_order_type" model="ir.actions.act_window">
        <field name="name">Order Types (Acumatica)</field>
        <field name="res_model">ps.sale.order.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ps_sale_order_type_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Order Types found!
            </p>
            <p>
                Click "Sync from Acumatica" to fetch order types from Acumatica.
            </p>
        </field>
    </record>

    <!-- Menu Item in Sales -> Configuration -->
    <menuitem id="menu_ps_sale_order_type"
              name="Order Types (Acumatica)"
              parent="sale.menu_sale_config"
              action="action_ps_sale_order_type"
              sequence="40"/>
</odoo>
