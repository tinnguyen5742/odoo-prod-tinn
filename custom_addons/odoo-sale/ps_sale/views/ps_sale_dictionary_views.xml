<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== 1. INVENTORIES ==================== -->
    <record id="view_ps_sale_inventory_search" model="ir.ui.view">
        <field name="name">ps.sale.inventory.search</field>
        <field name="model">ps.sale.inventory</field>
        <field name="arch" type="xml">
            <search string="Search Inventories">
                <field name="inventory_cd"/>
                <field name="name"/>
                <field name="item_type"/>
                <field name="item_status"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_ps_sale_inventory_tree" model="ir.ui.view">
        <field name="name">ps.sale.inventory.list</field>
        <field name="model">ps.sale.inventory</field>
        <field name="arch" type="xml">
            <list string="Inventories (Acumatica)">
                <header>
                    <button name="action_sync_from_acumatica"
                            string="Sync from Acumatica"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"/>
                </header>
                <field name="inventory_cd"/>
                <field name="name"/>
                <field name="base_unit" optional="show"/>
                <field name="sales_unit" optional="show"/>
                <field name="base_price" optional="show"/>
                <field name="item_type" optional="hide"/>
                <field name="item_status" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ps_sale_inventory_form" model="ir.ui.view">
        <field name="name">ps.sale.inventory.form</field>
        <field name="model">ps.sale.inventory</field>
        <field name="arch" type="xml">
            <form string="Inventory (Acumatica)">
                <header>
                    <button name="action_sync_from_acumatica"
                            string="Sync from Acumatica"
                            type="object"
                            class="btn-secondary"
                            icon="fa-refresh"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="inventory_cd"/>
                            <field name="name"/>
                            <field name="base_price"/>
                        </group>
                        <group>
                            <field name="base_unit"/>
                            <field name="sales_unit"/>
                            <field name="item_type"/>
                            <field name="item_status"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ps_sale_inventory" model="ir.actions.act_window">
        <field name="name">Inventories (Acumatica)</field>
        <field name="res_model">ps.sale.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ps_sale_inventory_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <!-- ==================== 2. ITEM UNITS ==================== -->
    <record id="view_ps_sale_item_unit_search" model="ir.ui.view">
        <field name="name">ps.sale.item.unit.search</field>
        <field name="model">ps.sale.item.unit</field>
        <field name="arch" type="xml">
            <search string="Search Item Units">
                <field name="name"/>
                <field name="to_unit"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_ps_sale_item_unit_tree" model="ir.ui.view">
        <field name="name">ps.sale.item.unit.list</field>
        <field name="model">ps.sale.item.unit</field>
        <field name="arch" type="xml">
            <list string="Item Units (Acumatica)">
                <header>
                    <button name="action_sync_from_acumatica"
                            string="Sync from Acumatica"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"/>
                </header>
                <field name="name"/>
                <field name="to_unit" optional="show"/>
                <field name="unit_mult_div" optional="show"/>
                <field name="unit_rate" optional="show"/>
                <field name="price_adjustment_multiplier" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ps_sale_item_unit_form" model="ir.ui.view">
        <field name="name">ps.sale.item.unit.form</field>
        <field name="model">ps.sale.item.unit</field>
        <field name="arch" type="xml">
            <form string="Item Unit (Acumatica)">
                <header>
                    <button name="action_sync_from_acumatica"
                            string="Sync from Acumatica"
                            type="object"
                            class="btn-secondary"
                            icon="fa-refresh"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="to_unit"/>
                        </group>
                        <group>
                            <field name="unit_mult_div"/>
                            <field name="unit_rate"/>
                            <field name="price_adjustment_multiplier"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ps_sale_item_unit" model="ir.actions.act_window">
        <field name="name">Item Units (Acumatica)</field>
        <field name="res_model">ps.sale.item.unit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ps_sale_item_unit_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <!-- ==================== 3. TAXES ==================== -->
    <record id="view_ps_sale_tax_search" model="ir.ui.view">
        <field name="name">ps.sale.tax.search</field>
        <field name="model">ps.sale.tax</field>
        <field name="arch" type="xml">
            <search string="Search Taxes">
                <field name="tax_id"/>
                <field name="name"/>
                <field name="tax_type"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_ps_sale_tax_tree" model="ir.ui.view">
        <field name="name">ps.sale.tax.list</field>
        <field name="model">ps.sale.tax</field>
        <field name="arch" type="xml">
            <list string="Taxes (Acumatica)">
                <header>
                    <button name="action_sync_from_acumatica"
                            string="Sync from Acumatica"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"/>
                </header>
                <field name="tax_id"/>
                <field name="name"/>
                <field name="tax_rate"/>
                <field name="tax_type" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ps_sale_tax_form" model="ir.ui.view">
        <field name="name">ps.sale.tax.form</field>
        <field name="model">ps.sale.tax</field>
        <field name="arch" type="xml">
            <form string="Tax (Acumatica)">
                <header>
                    <button name="action_sync_from_acumatica"
                            string="Sync from Acumatica"
                            type="object"
                            class="btn-secondary"
                            icon="fa-refresh"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="tax_id"/>
                            <field name="name"/>
                            <field name="tax_rate"/>
                        </group>
                        <group>
                            <field name="tax_type"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ps_sale_tax" model="ir.actions.act_window">
        <field name="name">Taxes (Acumatica)</field>
        <field name="res_model">ps.sale.tax</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ps_sale_tax_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <!-- ==================== MENU ITEMS ==================== -->
    <menuitem id="menu_ps_sale_inventory"
              name="Inventories (Acumatica)"
              parent="sale.menu_sale_config"
              action="action_ps_sale_inventory"
              sequence="41"/>

    <menuitem id="menu_ps_sale_item_unit"
              name="Item Units (Acumatica)"
              parent="sale.menu_sale_config"
              action="action_ps_sale_item_unit"
              sequence="42"/>

    <menuitem id="menu_ps_sale_tax"
              name="Taxes (Acumatica)"
              parent="sale.menu_sale_config"
              action="action_ps_sale_tax"
              sequence="43"/>
</odoo>
