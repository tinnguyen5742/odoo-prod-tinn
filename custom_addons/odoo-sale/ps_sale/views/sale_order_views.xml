<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Quotations / Sales Orders List View -->
    <record id="view_quotation_tree_inherit_ps" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.ps</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_customer_code" string="Customer Code (Acu)" optional="show" readonly="1"/>
                <field name="x_acumatica_so_number" string="Acumatica SO Number" optional="show" readonly="1"/>
                <field name="x_acumatica_so_status"
                       string="Acumatica Sync Status"
                       widget="badge"
                       optional="show"
                       readonly="1"
                       decoration-muted="x_acumatica_so_status == 'not_synced'"
                       decoration-info="x_acumatica_so_status == 'pending'"
                       decoration-success="x_acumatica_so_status == 'synced'"
                       decoration-danger="x_acumatica_so_status == 'failed'"/>
                <field name="x_order_type_id" string="Order Type" optional="show"/>
                <field name="x_inventory_id" string="Inventory" optional="hide"/>
                <field name="x_item_unit_id" string="Item Unit" optional="hide"/>
                <field name="x_tax_id" string="Tax" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Inherit Quotation / Sales Order Form View -->
    <record id="view_order_form_inherit_ps" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ps</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Cảnh báo khi Báo giá ở trạng thái thành công -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0 text-center" role="alert" invisible="state != 'sale'">
                    Quotation is in <b>Successful Quotation</b> status. Order data is locked to prepare for Acumatica sync.
                </div>
            </xpath>

            <!-- Nút gửi yêu cầu đồng bộ SO sang Acumatica: chuyển cờ sang pending để Acumatica pull -->
            <xpath expr="//header" position="inside">
                <!-- Nút Xanh khi chưa đồng bộ: Cho phép bấm gửi yêu cầu -->
                <button name="action_create_acumatica_so"
                        type="object"
                        string="Create SO [Acumatica]"
                        class="btn-success"
                        invisible="state != 'sale' or x_acumatica_so_number or x_acumatica_so_status in ('pending', 'synced')"/>

                <!-- Nút Xám khi đang chờ Acumatica đồng bộ -->
                <button name="action_check_acumatica_so_status"
                        type="object"
                        string="Pending Acumatica Sync..."
                        class="btn-secondary"
                        invisible="state != 'sale' or x_acumatica_so_number or x_acumatica_so_status != 'pending'"/>
            </xpath>

            <!-- Cột trái (partner_details): Khách hàng, Mã KH Acu, Loại SO -->
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="x_customer_code" string="Customer Code (Acu)" readonly="1" invisible="not partner_id"/>
                <field name="x_order_type_id" string="Order Type" options="{'no_create': True}" readonly="state == 'sale'"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">state == 'sale'</attribute>
            </xpath>

            <!-- Cột phải (order_details): Trạng thái đồng bộ Acu, Số SO, Ngày tạo SO -->
            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="before">
                <field name="x_acumatica_so_status"
                       string="Acumatica Sync Status"
                       widget="badge"
                       readonly="1"
                       decoration-muted="x_acumatica_so_status == 'not_synced'"
                       decoration-info="x_acumatica_so_status == 'pending'"
                       decoration-success="x_acumatica_so_status == 'synced'"
                       decoration-danger="x_acumatica_so_status == 'failed'"/>
                <field name="x_acumatica_so_number" string="Acumatica SO Number" readonly="1" invisible="not x_acumatica_so_number"/>
                <field name="x_acumatica_so_date" string="Acumatica SO Date" readonly="1" invisible="not x_acumatica_so_number"/>
            </xpath>

            <!-- Chi tiết đơn hàng: Cấu hình lại các cột theo chuẩn Acumatica -->
            <!-- 1. Ẩn thuế và đơn vị tính gốc Odoo -->
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- 2. Thêm Danh mục VT trước Sản phẩm -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="before">
                <field name="x_inventory_id" string="Acumatica Inventory" options="{'no_create': True}" optional="show"/>
            </xpath>

            <!-- 3. Thêm Danh mục ĐVT sau Số lượng -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="x_item_unit_id" string="Item Unit" options="{'no_create': True}" optional="show"/>
            </xpath>

            <!-- 4. Thêm Thuế Acumatica sau Đơn giá -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="x_tax_id" string="Acumatica Tax" options="{'no_create': True}" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state == 'sale' or state == 'cancel' or locked</attribute>
            </xpath>
        </field>
    </record>

    <!-- Ẩn tab Trình tạo báo giá (Quote Builder) của module sale_pdf_quote_builder -->
    <record id="view_order_form_inherit_quote_builder_ps" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.quote.builder.ps</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_pdf_quote_builder.sale_order_form_inherit_sale_pdf_quote_builder"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pdf_quote_builder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit Sales Order Search View -->
    <record id="view_sales_order_filter_inherit_ps" model="ir.ui.view">
        <field name="name">sale.order.list.select.inherit.ps</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_customer_code" string="Customer Code (Acu)"/>
                <field name="x_order_type_id" string="Order Type"/>
                <field name="x_inventory_id" string="Inventory"/>
            </field>
            <filter name="my_sale_orders_filter" position="after">
                <separator/>
                <filter string="Pending Acumatica Sync" name="filter_acu_pending" domain="[('x_acumatica_so_status', '=', 'pending')]"/>
                <filter string="Acumatica Synced" name="filter_acu_synced" domain="[('x_acumatica_so_status', '=', 'synced')]"/>
            </filter>
            <xpath expr="//group" position="inside">
                <filter string="Order Type" name="group_by_order_type" context="{'group_by': 'x_order_type_id'}"/>
                <filter string="Inventory" name="group_by_inventory" context="{'group_by': 'x_inventory_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
