<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ps_warranty_dashboard_form" model="ir.ui.view">
        <field name="name">ps.warranty.dashboard.form</field>
        <field name="model">ps.warranty.dashboard</field>
        <field name="arch" type="xml">
            <form string="Warranty Management Dashboard">
                <header>
                    <button name="action_new_claim" type="object" string="New Claim"
                            class="oe_highlight" groups="ps_warranty.group_warranty_user"/>
                    <button name="action_new_registration" type="object" string="New Registration"
                            groups="ps_warranty.group_warranty_officer"/>
                    <button name="action_new_rma" type="object" string="New RMA"
                            groups="ps_warranty.group_warranty_officer"/>
                    <button name="action_new_policy" type="object" string="New Policy"
                            groups="ps_warranty.group_warranty_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Warranty Management</h1>
                        <div class="text-muted">Warranty coverage, service requests and return tracking</div>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_registrations" type="object" class="oe_stat_button" icon="fa-id-card-o">
                            <field name="registration_count" widget="statinfo" string="Registrations"/>
                        </button>
                        <button name="action_open_active_registrations" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <field name="active_registration_count" widget="statinfo" string="Active"/>
                        </button>
                        <button name="action_open_expired_registrations" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="expired_registration_count" widget="statinfo" string="Expired"/>
                        </button>
                        <button name="action_open_claims" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                        <button name="action_open_waiting_claims" type="object" class="oe_stat_button" icon="fa-hourglass-half">
                            <field name="waiting_claim_count" widget="statinfo" string="In Process"/>
                        </button>
                        <button name="action_open_rejected_claims" type="object" class="oe_stat_button" icon="fa-ban">
                            <field name="rejected_claim_count" widget="statinfo" string="Rejected"/>
                        </button>
                    </div>
                    <group>
                        <group string="Claim outcomes">
                            <field name="approved_claim_count" readonly="1"/>
                            <field name="rejected_claim_count" readonly="1"/>
                        </group>
                        <group string="Warranty costs">
                            <field name="warranty_cost" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ps_warranty_dashboard" model="ir.actions.act_window">
        <field name="name">Overview</field>
        <field name="res_model">ps.warranty.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ps_warranty_dashboard_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_ps_warranty_root" name="Warranty Management"
              sequence="35" groups="ps_warranty.group_warranty_user"/>
    <menuitem id="menu_ps_warranty_dashboard" name="Overview"
              parent="menu_ps_warranty_root" action="action_ps_warranty_dashboard"
              sequence="5" groups="ps_warranty.group_warranty_user"/>
    <menuitem id="menu_ps_warranty_claims" name="Claims"
              parent="menu_ps_warranty_root" action="action_ps_warranty_claims"
              sequence="10" groups="ps_warranty.group_warranty_user"/>
    <menuitem id="menu_ps_warranty_registrations" name="Registrations"
              parent="menu_ps_warranty_root" action="action_ps_warranty_registrations"
              sequence="20" groups="ps_warranty.group_warranty_user"/>
    <menuitem id="menu_ps_warranty_rmas" name="RMA"
              parent="menu_ps_warranty_root" action="action_ps_warranty_rmas"
              sequence="30" groups="ps_warranty.group_warranty_user"/>
    <menuitem id="menu_ps_warranty_policies" name="Policies"
              parent="menu_ps_warranty_root" action="action_ps_warranty_policies"
              sequence="80" groups="ps_warranty.group_warranty_manager"/>
    <menuitem id="menu_ps_warranty_analysis" name="Reports"
              parent="menu_ps_warranty_root" action="action_ps_warranty_claim_analysis"
              sequence="90" groups="ps_warranty.group_warranty_manager"/>
</odoo>
