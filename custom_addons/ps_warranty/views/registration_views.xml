<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ps_warranty_registration_list" model="ir.ui.view">
        <field name="name">ps.warranty.registration.list</field>
        <field name="model">ps.warranty.registration</field>
        <field name="arch" type="xml">
            <list string="Warranty Registrations" default_order="start_date desc">
                <button name="action_view_claims" type="object" string="Claims" icon="fa-life-ring"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="serial_number"/>
                <field name="policy_id"/>
                <field name="purchase_date"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_remaining" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state in ['draft', 'cancelled']"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ps_warranty_registration_form" model="ir.ui.view">
        <field name="name">ps.warranty.registration.form</field>
        <field name="model">ps.warranty.registration</field>
        <field name="arch" type="xml">
            <form string="Warranty Registration">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="oe_highlight" groups="ps_warranty.group_warranty_officer"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="ps_warranty.group_warranty_manager"
                            invisible="state not in ['draft', 'active']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Customer and product">
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="serial_number"/>
                            <field name="lot_ref"/>
                            <field name="policy_id" domain="[('active', '=', True)]"/>
                            <field name="source_ref"/>
                            <field name="document_ref"/>
                        </group>
                        <group string="Warranty period">
                            <field name="purchase_date"/>
                            <field name="start_date"/>
                            <field name="end_date" readonly="1"/>
                            <field name="days_remaining" readonly="1"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group><field name="notes" placeholder="Warranty notes..."/></group>
                    <notebook>
                        <page string="Claims">
                            <field name="claim_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="claim_date"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="user_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ps_warranty_registration_search" model="ir.ui.view">
        <field name="name">ps.warranty.registration.search</field>
        <field name="model">ps.warranty.registration</field>
        <field name="arch" type="xml">
            <search string="Search Warranty Registrations">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="serial_number"/>
                <field name="policy_id"/>
                <field name="source_ref"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="expiring_soon" string="Expires in 30 days"
                        domain="[('state', '=', 'active'), ('end_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ps_warranty_registrations" model="ir.actions.act_window">
        <field name="name">Warranty Registrations</field>
        <field name="res_model">ps.warranty.registration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ps_warranty_registration_search"/>
    </record>
</odoo>
