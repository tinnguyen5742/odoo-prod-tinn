<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_component_pick_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="comp_req" t-value="o.component_request_ids[:1]"/>
                <t t-set="pick_date" t-value="o.scheduled_date or o.create_date"/>
                <div class="page" style="font-family: 'DejaVu Sans', 'Liberation Sans', 'Noto Sans', Arial, sans-serif; font-size: 13px; color: #000; position: relative;">
                    <!-- Header -->
                    <div style="position: relative; text-align: center; margin-bottom: 8px;">
                        <div style="font-size: 22px; font-weight: bold;">PHIẾU YÊU CẦU LẤY NGUYÊN VẬT LIỆU</div>
                        <div style="font-style: italic; margin-top: 2px;">
                            Ngày <span t-esc="pick_date.day if pick_date else ''"/> Tháng <span t-esc="pick_date.month if pick_date else ''"/> năm <span t-esc="pick_date.year if pick_date else ''"/>
                        </div>
                        <div t-if="o.name" style="position: absolute; top: 0; right: 0;">
                            <img t-att-src="'/report/barcode/QR/%s?width=90&amp;height=90&amp;quiet=0' % o.name" style="width: 90px; height: 90px;" alt="QR"/>
                        </div>
                    </div>

                    <!-- Thông tin chung -->
                    <table style="width: 100%; border: none; border-collapse: collapse; line-height: 1.9;">
                        <tr>
                            <td style="width: 50%;"><strong>Số phiếu kho:</strong> <span t-field="o.name"/></td>
                            <td><strong>YC cấp phát:</strong> <span t-esc="comp_req.code or o.origin or ''"/></td>
                        </tr>
                        <tr>
                            <td><strong>Lệnh SX:</strong> <span t-esc="comp_req.production_id.code or ''"/></td>
                            <td><strong>Xưởng SX:</strong> <span t-esc="'(%s) - %s' % (comp_req.workcenter_id.code, comp_req.workcenter_id.name) if comp_req.workcenter_id else ''"/></td>
                        </tr>
                        <tr>
                            <td><strong>Kho xuất:</strong> <span t-field="o.location_id"/></td>
                            <td><strong>Kho nhận:</strong> <span t-field="o.location_dest_id"/></td>
                        </tr>
                    </table>

                    <!-- Danh sách NVL -->
                    <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                        <thead>
                            <tr style="background-color: #f2f2f2;">
                                <th style="border: 1px solid #000; padding: 4px; width: 6%; text-align: center;">STT</th>
                                <th style="border: 1px solid #000; padding: 4px; width: 18%;">Mã NVL</th>
                                <th style="border: 1px solid #000; padding: 4px;">Tên NVL</th>
                                <th style="border: 1px solid #000; padding: 4px; width: 9%; text-align: center;">ĐVT</th>
                                <th style="border: 1px solid #000; padding: 4px; width: 12%; text-align: right;">SL yêu cầu</th>
                                <th style="border: 1px solid #000; padding: 4px; width: 12%; text-align: right;">SL thực xuất</th>
                                <th style="border: 1px solid #000; padding: 4px; width: 15%;">Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.move_ids" t-as="move">
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;"><span t-esc="move_index + 1"/></td>
                                <td style="border: 1px solid #000; padding: 4px;"><span t-esc="move.product_id.default_code or ''"/></td>
                                <td style="border: 1px solid #000; padding: 4px;"><span t-esc="move.product_id.name"/></td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;"><span t-esc="move.product_uom.name"/></td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;"><span t-field="move.product_uom_qty"/></td>
                                <td style="border: 1px solid #000; padding: 4px;"/>
                                <td style="border: 1px solid #000; padding: 4px;"/>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Chữ ký -->
                    <table style="width: 100%; border: none; margin-top: 24px; text-align: center;">
                        <tr>
                            <td style="width: 33%;"><strong>Người yêu cầu</strong><br/><i>(Ký, họ tên)</i></td>
                            <td style="width: 33%;"><strong>Thủ kho</strong><br/><i>(Ký, họ tên)</i></td>
                            <td style="width: 34%;"><strong>Người nhận</strong><br/><i>(Ký, họ tên)</i></td>
                        </tr>
                    </table>
                </div>
                <!-- Mỗi phiếu 1 trang khi in; đường phân cách khi xem trên màn hình -->
                <div t-if="not o_last" style="page-break-after: always; break-after: page; border-top: 1px dashed #999; margin: 24px 0;"/>
            </t>
        </t>
    </template>

    <record id="action_report_component_pick" model="ir.actions.report">
        <field name="name">Component Pick Request</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">ps_mfg.report_component_pick_document</field>
        <field name="report_file">ps_mfg.report_component_pick_document</field>
        <field name="print_report_name">'Phieu lay NVL - %s' % object.name</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
