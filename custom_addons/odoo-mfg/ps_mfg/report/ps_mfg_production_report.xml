<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_ps_mfg_production_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: 'DejaVu Sans', 'Liberation Sans', 'Noto Sans', Arial, sans-serif; font-size: 13px; color: #000; position: relative;">
                    <!-- Header -->
                    <div style="position: relative; text-align: center; margin-bottom: 8px;">
                        <div style="font-size: 22px; font-weight: bold;">LỆNH SẢN XUẤT</div>
                        <div style="font-style: italic; margin-top: 2px;">
                            Ngày <span t-esc="o.order_date.day if o.order_date else ''"/> Tháng <span t-esc="o.order_date.month if o.order_date else ''"/> năm <span t-esc="o.order_date.year if o.order_date else ''"/>
                        </div>
                        <div t-if="o.code and o.code != 'New'" style="position: absolute; top: 0; right: 0;">
                            <img t-att-src="'/report/barcode/QR/%s?width=90&amp;height=90&amp;quiet=0' % o.code" style="width: 90px; height: 90px;" alt="QR"/>
                        </div>
                    </div>

                    <!-- Thông tin chung -->
                    <table style="width: 100%; border: none; border-collapse: collapse; line-height: 1.9;">
                        <tr>
                            <td style="width: 30%;"><strong>Lệnh SX:</strong> <span t-field="o.code"/></td>
                            <td colspan="3"><strong>Xưởng SX:</strong> <span t-esc="'(%s) - %s' % (o.workcenter_id.code, o.workcenter_id.name) if o.workcenter_id else ''"/></td>
                        </tr>
                        <tr>
                            <td><strong>Ngày đặt hàng:</strong> <span t-field="o.order_date"/></td>
                            <td style="width: 27%;"><strong>Ngày YC Giao:</strong> <span t-field="o.deadline_date"/></td>
                            <td colspan="2"><strong>Nhóm LSX tham chiếu:</strong> <span t-field="o.ref_mo_group"/></td>
                        </tr>
                        <tr>
                            <td colspan="4"><strong>Khách hàng:</strong> <span t-field="o.customer_name"/></td>
                        </tr>
                        <tr>
                            <td><strong>SL YC Sản xuất:</strong> <span t-field="o.product_qty"/> <span t-field="o.product_uom_id" t-options="{'widget': 'many2one'}"/></td>
                            <td><strong>Số lượng SO:</strong> <span t-field="o.product_qty"/></td>
                            <td style="width: 23%;"><strong>Dung sai:</strong> +<span t-field="o.tolerance_plus"/>/-<span t-field="o.tolerance_minus"/></td>
                            <td><strong>Số POKH:</strong> <span t-field="o.pokh_number"/></td>
                        </tr>
                        <tr>
                            <!-- MISSING-DATA: Mã Cũ — chưa có field trên ps.mfg.production / product, để trống chờ bổ sung -->
                            <td><strong>Mã Cũ:</strong></td>
                            <!-- MISSING-DATA: Cấu trúc — chưa có field trên ps.mfg.production / BoM, để trống chờ bổ sung -->
                            <td colspan="2"><strong>Cấu trúc:</strong></td>
                            <td><strong>Số SO:</strong> <span t-field="o.sale_order_id"/></td>
                        </tr>
                        <tr>
                            <td colspan="4"><strong>Tên SP:</strong> <span t-esc="'(%s) %s' % (o.product_id.default_code, o.product_id.name) if o.product_id and o.product_id.default_code else (o.product_id.display_name or '')"/></td>
                        </tr>
                        <tr>
                            <td colspan="4"><strong>Địa điểm GH:</strong> <span t-field="o.delivery_place"/></td>
                        </tr>
                        <tr>
                            <td colspan="4"><strong>Thông tin SP:</strong></td>
                        </tr>
                    </table>

                    <!-- Bảng thông số SP -->
                    <table style="width: 100%; border-collapse: collapse; margin-top: 4px; line-height: 2;" border="1">
                        <tr>
                            <!-- MISSING-DATA: Loại túi — chưa có field, để trống chờ bổ sung -->
                            <td style="width: 20%; padding: 2px 6px;"><strong>Loại túi:</strong></td>
                            <!-- MISSING-DATA: Rộng (mm) — chưa có field, để trống chờ bổ sung -->
                            <td style="width: 20%; padding: 2px 6px;"><strong>Rộng (mm):</strong></td>
                            <!-- MISSING-DATA: Cao (mm) — chưa có field, để trống chờ bổ sung -->
                            <td style="width: 20%; padding: 2px 6px;"><strong>Cao(mm):</strong></td>
                            <!-- MISSING-DATA: Dung sai túi — chưa có field, để trống chờ bổ sung -->
                            <td style="width: 20%; padding: 2px 6px;"><strong>Dung sai:</strong></td>
                            <!-- MISSING-DATA: Xếp hông (mm) — chưa có field, để trống chờ bổ sung -->
                            <td style="width: 20%; padding: 2px 6px;"><strong>Xếp hông (mm):</strong></td>
                        </tr>
                        <tr>
                            <!-- MISSING-DATA: Hàn biên — chưa có field, để trống chờ bổ sung -->
                            <td style="padding: 2px 6px;"><strong>Hàn biên:</strong></td>
                            <!-- MISSING-DATA: giá trị Hàn biên (mm) — chưa có field, để trống chờ bổ sung -->
                            <td colspan="2" style="padding: 2px 6px; text-align: center;">(mm)</td>
                            <!-- MISSING-DATA: Hàn đáy (mm) — chưa có field, để trống chờ bổ sung -->
                            <td style="padding: 2px 6px;"><strong>Hàn đáy (mm):</strong></td>
                            <!-- MISSING-DATA: Hàn đầu (mm) — chưa có field, để trống chờ bổ sung -->
                            <td style="padding: 2px 6px;"><strong>Hàn đầu (mm):</strong></td>
                        </tr>
                        <tr>
                            <!-- MISSING-DATA: Đục lỗ — chưa có field, để trống chờ bổ sung -->
                            <td style="padding: 2px 6px;"><strong>Đục lỗ:</strong></td>
                            <!-- MISSING-DATA: Đục lỗ Cách Miệng (mm) — chưa có field, để trống chờ bổ sung -->
                            <td colspan="2" style="padding: 2px 6px;"><strong>Cách Miệng(mm):</strong></td>
                            <!-- MISSING-DATA: Đục lỗ Cách Đáy (mm) — chưa có field, để trống chờ bổ sung -->
                            <td colspan="2" style="padding: 2px 6px;"><strong>Cách Đáy(mm):</strong></td>
                        </tr>
                        <tr>
                            <!-- MISSING-DATA: Bấm V — chưa có field, để trống chờ bổ sung -->
                            <td style="padding: 2px 6px;"><strong>Bấm V:</strong></td>
                            <!-- MISSING-DATA: Bấm V Cách Miệng (mm) — chưa có field, để trống chờ bổ sung -->
                            <td colspan="2" style="padding: 2px 6px;"><strong>Cách Miệng(mm):</strong></td>
                            <!-- MISSING-DATA: Bấm V Cách Đáy (mm) — chưa có field, để trống chờ bổ sung -->
                            <td colspan="2" style="padding: 2px 6px;"><strong>Cách Đáy(mm):</strong></td>
                        </tr>
                        <tr>
                            <!-- MISSING-DATA: Dây kéo — chưa có field, để trống chờ bổ sung -->
                            <td style="padding: 2px 6px;"><strong>Dây kéo:</strong></td>
                            <!-- MISSING-DATA: Dây kéo Cách Miệng (mm) — chưa có field, để trống chờ bổ sung -->
                            <td colspan="2" style="padding: 2px 6px;"><strong>Cách Miệng(mm):</strong></td>
                            <!-- MISSING-DATA: Dây kéo Cách Đáy (mm) — chưa có field, để trống chờ bổ sung -->
                            <td colspan="2" style="padding: 2px 6px;"><strong>Cách Đáy(mm):</strong></td>
                        </tr>
                        <tr>
                            <td colspan="5" style="padding: 2px 6px;"><strong>Lưu Ý:</strong> <span t-field="o.caution"/></td>
                        </tr>
                        <tr>
                            <td colspan="5" style="padding: 2px 6px;"><strong>Ghi chú:</strong> <span t-field="o.remark"/></td>
                        </tr>
                        <tr>
                            <td colspan="5" style="padding: 2px 6px;"><strong>Lưu ý KT:</strong> <span t-field="o.tech_note"/></td>
                        </tr>
                    </table>

                    <!-- Chữ ký -->
                    <div style="text-align: right; font-style: italic; margin-top: 4px;">
                        Ngày <span t-esc="o.order_date.day if o.order_date else ''"/> Tháng <span t-esc="o.order_date.month if o.order_date else ''"/> năm <span t-esc="o.order_date.year if o.order_date else ''"/>
                    </div>
                    <table style="width: 100%; margin-top: 4px; text-align: center; border: none; font-weight: bold; font-size: 12px;">
                        <tr>
                            <td style="width: 33%;">NHÀ MÁY SẢN XUẤT</td>
                            <td style="width: 33%;">PHÒNG KHVT</td>
                            <td style="width: 33%;">NGƯỜI LẬP</td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_ps_mfg_production" model="ir.actions.report">
        <field name="name">Lệnh Sản Xuất</field>
        <field name="model">ps.mfg.production</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">ps_mfg.report_ps_mfg_production_document</field>
        <field name="report_file">ps_mfg.report_ps_mfg_production_document</field>
        <field name="binding_model_id" ref="model_ps_mfg_production"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
