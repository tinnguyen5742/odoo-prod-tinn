<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ps_mfg.WorkorderStepper">
        <div class="o_ps_workorder_stepper" t-if="progress">
            <t t-foreach="steps" t-as="step" t-key="step_index">
                <div class="o_ps_step"
                     t-att-class="stepClass(step, step_index)"
                     t-att-title="stepTitle(step, step_index)"
                     t-attf-style="--ps-pct: #{stepPercent(step)}%"
                     t-on-click="() => this.onSelect(step, step_index)">
                    <i t-if="isDone(step, step_index)" class="o_ps_step_check fa fa-check" role="img" aria-label="Done"/>
                    <span class="o_ps_step_name" t-esc="step.name"/>
                    <span t-if="step_index > 0" class="o_ps_step_qty" t-esc="stepQty(step)"/>
                </div>
            </t>
        </div>
    </t>
</templates>
