<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_mfg_operation_view_list" model="ir.ui.view">
        <field name="name">ps.mfg.operation.view.list</field>
        <field name="model">ps.mfg.operation</field>
        <field name="arch" type="xml">
            <list string="Operations">
                <field name="code"/>
                <field name="name"/>
                <field name="bom_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ps_mfg_operation_view_form" model="ir.ui.view">
        <field name="name">ps.mfg.operation.view.form</field>
        <field name="model">ps.mfg.operation</field>
        <field name="arch" type="xml">
            <form string="Operation">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_boms" type="object" class="oe_stat_button" icon="fa-flask">
                            <field name="bom_count" widget="statinfo" string="BoMs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Assembly"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="enabled" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resources" name="resources">
                            <field name="resource_ids" nolabel="1">
                                <list string="Operation Resources" editable="bottom">
                                    <field name="resource_id"/>
                                    <field name="resource_code" readonly="1"/>
                                    <field name="resource_name" readonly="1"/>
                                    <field name="cost_item_id" readonly="1"/>
                                    <field name="cost_item_code" readonly="1"/>
                                    <field name="cost_item_name" readonly="1"/>
                                    <field name="account_id" readonly="1"/>
                                    <field name="resource_cost"/>
                                    <field name="currency_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1" placeholder="Work instructions for this operation..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ps_mfg_operation_view_search" model="ir.ui.view">
        <field name="name">ps.mfg.operation.view.search</field>
        <field name="model">ps.mfg.operation</field>
        <field name="arch" type="xml">
            <search string="Search Operation">
                <field name="name" filter_domain="['|', ('code', 'ilike', self), ('name', 'ilike', self)]"/>
                <filter string="Enabled" name="enabled" domain="[('enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('enabled', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="ps_mfg_operation_action" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">ps.mfg.operation</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="ps_mfg_operation_view_list"/>
        <field name="search_view_id" ref="ps_mfg_operation_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first operation</p>
            <p>An operation can be used in many Bills of Materials, with its standard resources and costs.</p>
        </field>
    </record>
</odoo>
