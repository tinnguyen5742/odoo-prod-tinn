<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="ps_mfg_proposal_view_list" model="ir.ui.view">
            <field name="name">ps.mfg.proposal.view.list</field>
            <field name="model">ps.mfg.proposal</field>
            <field name="arch" type="xml">
                <list create="0">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="source_location_id"/>
                    <field name="proposal_date"/>
                    <field name="transfer_state" widget="badge"
                           decoration-info="transfer_state in ('waiting', 'in_transit')"
                           decoration-success="transfer_state == 'done'"
                           decoration-danger="transfer_state == 'cancelled'"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'pending'"
                           decoration-warning="state == 'draft'"
                           decoration-success="state == 'approved'"
                           decoration-danger="state == 'rejected'"/>
                </list>
            </field>
        </record>

        <record id="ps_mfg_proposal_view_form" model="ir.ui.view">
            <field name="name">ps.mfg.proposal.view.form</field>
            <field name="model">ps.mfg.proposal</field>
            <field name="arch" type="xml">
                <form create="0">
                    <header>
                        <button name="action_submit_approval" type="object" string="Submit"
                                invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                                invisible="state not in ('draft', 'pending')"/>
                        <button name="action_reject" type="object" string="Reject"
                                invisible="state not in ('draft', 'pending')"/>
                        <button name="action_load_remaining_lines" type="object" string="Reload Lines"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_picking" type="object" class="oe_stat_button"
                                    icon="fa-truck" invisible="not picking_count">
                                <field name="picking_count" widget="statinfo" string="Transfer"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="proposal_date"/>
                            </group>
                            <group>
                                <field name="source_location_id" readonly="state in ('approved', 'rejected')"/>
                                <field name="transfer_state" widget="badge"
                                       decoration-info="transfer_state in ('waiting', 'in_transit')"
                                       decoration-success="transfer_state == 'done'"
                                       decoration-danger="transfer_state == 'cancelled'"/>
                                <field name="company_id" invisible="1" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Requests">
                                <field name="component_request_ids"
                                       readonly="state in ('approved', 'rejected')"
                                       options="{'no_quick_create': True, 'no_create': True}">
                                    <list>
                                        <field name="code"/>
                                        <field name="production_id"/>
                                        <field name="workcenter_id"/>
                                        <field name="destination_location_id"/>
                                        <field name="request_date"/>
                                        <field name="transfer_status" widget="badge"
                                               decoration-info="transfer_status == 'partial'"
                                               decoration-success="transfer_status == 'full'"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Components">
                                <field name="line_ids" readonly="state in ('approved', 'rejected')">
                                    <list editable="bottom">
                                        <field name="request_id" readonly="1"/>
                                        <field name="product_id" readonly="1"/>
                                        <field name="qty_planned" readonly="1"/>
                                        <field name="qty_transferred" readonly="1"/>
                                        <field name="qty_to_propose" readonly="1"/>
                                        <field name="qty_to_transfer"/>
                                        <field name="product_uom_id" readonly="1" groups="uom.group_uom"/>
                                        <field name="qty_done" readonly="1" optional="show"/>
                                        <field name="qty_open" readonly="1" optional="show"/>
                                        <field name="workorder_id" readonly="1" optional="show"/>
                                        <field name="workcenter_id" readonly="1" optional="show"/>
                                        <field name="destination_location_id" readonly="1" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ps_mfg_proposal_action" model="ir.actions.act_window">
            <field name="name">MFG Proposals</field>
            <field name="res_model">ps.mfg.proposal</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No proposals
                </p>
                <p>
                    Proposals are kept for reference only. Pick components from the
                    component request instead.
                </p>
            </field>
        </record>
    </data>
</odoo>
