<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_mfg_routing_resource_view_list" model="ir.ui.view">
        <field name="name">ps.mfg.routing.resource.view.list</field>
        <field name="model">ps.mfg.routing.resource</field>
        <field name="arch" type="xml">
            <list string="Routing Resources" editable="bottom">
                <field name="resource_id"/>
                <field name="resource_code" readonly="1"/>
                <field name="resource_name" readonly="1"/>
                <field name="cost_item_id" readonly="1"/>
                <field name="cost_item_code" readonly="1"/>
                <field name="cost_item_name" readonly="1"/>
                <field name="account_id" readonly="1"/>
                <field name="resource_cost"/>
                <field name="currency_id" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="ps_mfg_routing_resource_view_form" model="ir.ui.view">
        <field name="name">ps.mfg.routing.resource.view.form</field>
        <field name="model">ps.mfg.routing.resource</field>
        <field name="arch" type="xml">
            <form string="Routing Resource">
                <sheet>
                    <group>
                        <group>
                            <field name="operation_id"/>
                            <field name="resource_id"/>
                            <field name="resource_cost"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="resource_code" readonly="1"/>
                            <field name="resource_name" readonly="1"/>
                            <field name="cost_item_id" readonly="1"/>
                            <field name="cost_item_code" readonly="1"/>
                            <field name="cost_item_name" readonly="1"/>
                            <field name="account_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ps_mfg_routing_resource_view_search" model="ir.ui.view">
        <field name="name">ps.mfg.routing.resource.view.search</field>
        <field name="model">ps.mfg.routing.resource</field>
        <field name="arch" type="xml">
            <search string="Search Routing Resource">
                <field name="operation_id"/>
                <field name="resource_id"/>
                <field name="cost_item_id"/>
            </search>
        </field>
    </record>
</odoo>
