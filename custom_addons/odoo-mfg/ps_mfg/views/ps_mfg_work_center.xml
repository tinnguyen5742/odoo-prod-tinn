<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ps_mfg_work_center_view_list" model="ir.ui.view">
            <field name="name">ps.mfg.work.center.view.list</field>
            <field name="model">ps.mfg.work.center</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="location_id"/>
                    <field name="company_id" optional="hide"/>
                    <field name="description" optional="hide"/>
                    <field name="enabled" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="ps_mfg_work_center_view_form" model="ir.ui.view">
            <field name="name">ps.mfg.work.center.view.form</field>
            <field name="model">ps.mfg.work.center</field>
            <field name="arch" type="xml">
                <form string="Form Title">
                    <field name="company_id" invisible="1"/>
                    <header>
                        <!-- Buttons and statusbar go here -->
                        <field name="enabled" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="location_id"/>
                            </group>
                            <group>
                                <field name="code"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <label for="mo_prefix" string="MO Prefix"/>
                                        <field name="mo_sequence_id" invisible="1"/>
                                        <div class="d-flex gap-2 align-items-center">
                                            <field name="mo_prefix" nolabel="1" readonly="mo_sequence_id != False"
                                                   class="flex-grow-1"/>
                                            <button type="object" name="action_open_mo_sequence" string=""
                                                    icon="fa-external-link" class="btn-link px-1"
                                                    invisible="mo_sequence_id == False" title="Open Sequence"/>
                                        </div>
                                        <label for="comp_request_prefix" string="Component Request Prefix"/>
                                        <field name="comp_request_sequence_id" invisible="1"/>
                                        <div class="d-flex gap-2 align-items-center">
                                            <field name="comp_request_prefix" nolabel="1"
                                                   readonly="comp_request_sequence_id != False" class="flex-grow-1"/>
                                            <button type="object" name="action_open_comp_request_sequence" string=""
                                                    icon="fa-external-link" class="btn-link px-1"
                                                    invisible="comp_request_sequence_id == False" title="Open Sequence"/>
                                        </div>
                                        <label for="receipt_request_prefix" string="Receipt Request Prefix"/>
                                        <field name="receipt_request_sequence_id" invisible="1"/>
                                        <div class="d-flex gap-2 align-items-center">
                                            <field name="receipt_request_prefix" nolabel="1"
                                                   readonly="receipt_request_sequence_id != False" class="flex-grow-1"/>
                                            <button type="object" name="action_open_receipt_request_sequence" string=""
                                                    icon="fa-external-link" class="btn-link px-1"
                                                    invisible="receipt_request_sequence_id == False" title="Open Sequence"/>
                                        </div>
                                    </group>
                                    <group/>
                                </group>
                                <separator string="Description"/>
                                <field name="description" nolabel="1" placeholder="Description of the work center..."/>
                            </page>
                            <page string="Accounting">
                                <group>
                                    <group>
                                        <field name="expense_account_id"/>
                                        <field name="wip_account_id"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ps_mfg_work_center_action" model="ir.actions.act_window">
            <field name="name">Ps Mfg Work Center</field>
            <field name="res_model">ps.mfg.work.center</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>