<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_mfg_resource_view_list" model="ir.ui.view">
        <field name="name">ps.mfg.resource.view.list</field>
        <field name="model">ps.mfg.resource</field>
        <field name="arch" type="xml">
            <list string="Resources" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="cost_item_id"/>
                <field name="account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ps_mfg_resource_view_form" model="ir.ui.view">
        <field name="name">ps.mfg.resource.view.form</field>
        <field name="model">ps.mfg.resource</field>
        <field name="arch" type="xml">
            <form string="Resource">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. CNC Machine 01"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. CNC-01"/>
                            <field name="cost_item_id"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="enabled" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ps_mfg_resource_view_search" model="ir.ui.view">
        <field name="name">ps.mfg.resource.view.search</field>
        <field name="model">ps.mfg.resource</field>
        <field name="arch" type="xml">
            <search string="Search Resource">
                <field name="code"/>
                <field name="name"/>
                <field name="cost_item_id"/>
                <field name="account_id"/>
                <filter string="Enabled" name="enabled" domain="[('enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('enabled', '=', False)]"/>
                <group>
                    <filter string="Cost Item" name="group_cost_item" context="{'group_by': 'cost_item_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ps_mfg_resource_action" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">ps.mfg.resource</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_mfg_resource_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first resource</p>
        </field>
    </record>
</odoo>
