<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="ps_mfg_proposal_finish_view_search" model="ir.ui.view">
            <field name="name">ps.mfg.proposal.finish.view.search</field>
            <field name="model">ps.mfg.proposal.finish</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code"/>
                    <field name="production_ids"/>
                    <field name="transaction_date"/>
                    <field name="state"/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_pending" string="Pending Approval" domain="[('state', '=', 'pending')]"/>
                    <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <group>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_date" string="Transaction Date" context="{'group_by': 'transaction_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ps_mfg_proposal_finish_view_list" model="ir.ui.view">
            <field name="name">ps.mfg.proposal.finish.view.list</field>
            <field name="model">ps.mfg.proposal.finish</field>
            <field name="arch" type="xml">
                <list decoration-muted="state == 'rejected'"
                      decoration-success="state == 'approved'">
                    <field name="code"/>
                    <field name="production_ids" widget="many2many_tags" optional="show"/>
                    <field name="transaction_date"/>
                    <field name="dst_location_id" optional="hide"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="ps_mfg_proposal_finish_view_form" model="ir.ui.view">
            <field name="name">ps.mfg.proposal.finish.view.form</field>
            <field name="model">ps.mfg.proposal.finish</field>
            <field name="arch" type="xml">
                <form string="Proposal Finish">
                    <header>
                        <button name="action_submit_approval" type="object" string="Submit"
                                invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="Approve"
                                class="oe_highlight" invisible="state not in ('draft', 'pending')"/>
<!--                        <button name="action_reject" type="object" string="Reject"-->
<!--                                invisible="state not in ('draft', 'pending')"/>-->
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"
                               options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <field name="move_count" invisible="1"/>
                            <button name="action_view_stock_moves" type="object" class="oe_stat_button"
                                    icon="fa-exchange" invisible="not move_count">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Stock Moves</span>
                                </div>
                            </button>
                            <button name="action_view_picking" type="object" class="oe_stat_button"
                                    icon="fa-truck" invisible="not picking_count">
                                <field name="picking_count" widget="statinfo" string="Receipt"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="transaction_date"/>
                                <label for="from_date" string="Schedule"/>
                                <div class="o_row" name="schedule">
                                    <field name="from_date"/>
                                    <span>–</span>
                                    <field name="to_date"/>
                                </div>
                            </group>
                            <group>
                                <field name="dst_location_id" options="{'no_quick_create': True}"
                                       readonly="state in ('approved', 'rejected')"/>
                                <field name="company_id" invisible="1" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" readonly="state in ('approved', 'rejected')"
                                       context="{'default_dst_location_id': dst_location_id}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="tracking" column_invisible="1"/>
                                        <field name="production_id"
                                               context="{'ps_mfg_mo_show_product_name': 1}"
                                               options="{'no_quick_create': True, 'no_create': True}"/>
                                        <field name="workorder_id" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="workorder_qty" optional="show"/>
                                        <field name="remaining_qty" optional="hide"/>
                                        <field name="finish_qty" optional="show"/>
                                        <field name="product_id" optional="show"/>
                                        <field name="x_product_code"/>
                                        <field name="product_uom_id" groups="uom.group_uom"
                                               widget="many2one_uom"
                                               options="{'no_open': True, 'no_create': True}" optional="hide"/>
                                        <field name="dst_location_id" options="{'no_quick_create': True}"/>
                                        <field name="lot_names"
                                               groups="stock.group_production_lot"
                                               invisible="tracking not in ('lot', 'serial')"/>
                                        <button name="action_show_lot_details" type="object"
                                                icon="fa-list" title="Lot/Serial Numbers"
                                                groups="stock.group_production_lot"
                                                invisible="tracking not in ('lot', 'serial') or parent.state in ('approved', 'rejected')"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <field name="description" nolabel="1" colspan="2" placeholder="Internal notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ps_mfg_proposal_finish_action" model="ir.actions.act_window">
            <field name="name">Ps Mfg Proposal Finish</field>
            <field name="res_model">ps.mfg.proposal.finish</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first record
                </p>
            </field>
        </record>
    </data>
</odoo>
