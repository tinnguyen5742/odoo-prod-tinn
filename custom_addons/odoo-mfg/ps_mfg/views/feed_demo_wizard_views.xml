<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_feed_demo_wizard_form" model="ir.ui.view">
        <field name="name">ps.mfg.feed.demo.wizard.form</field>
        <field name="model">ps.mfg.feed.demo.wizard</field>
        <field name="arch" type="xml">
            <form string="Nạp Dữ Liệu Mẫu Manufacturing">
                <field name="is_demo_db" invisible="1"/>

                <!-- Trường hợp 1: Database CÓ bật demo data (An toàn) -->
                <div class="alert alert-info" role="status" invisible="not is_demo_db">
                    <h5 class="text-info">
                        <i class="fa fa-info-circle me-2"/>Database Demo hợp lệ
                    </h5>
                    <p class="mb-0">Hệ thống sẽ nạp các kịch bản: Lệnh SX (Draft, Chờ duyệt, Đang chạy, Hoàn thành), Đề nghị chuyển kho NVL, Nhập kho TP và Bút toán WIP mẫu.</p>
                </div>

                <!-- Trường hợp 2: Database KHÔNG bật demo data (Cảnh báo) -->
                <div class="alert alert-danger" role="alert" invisible="is_demo_db">
                    <h5 class="text-danger">
                        <i class="fa fa-exclamation-triangle me-2"/>CẢNH BÁO NGUY HIỂM: Database Không Phải Bản Demo!
                    </h5>
                    <p>Database này được khởi tạo <strong>KHÔNG</strong> có cờ Demo Data (rất có thể là môi trường <strong>Production</strong> hoặc DB nghiệp vụ thật).</p>
                    <p class="mb-0">Việc nạp dữ liệu mẫu sẽ tạo thêm sản phẩm, kho mẫu, lô hàng, phiếu kho và bút toán chi phí 154/621/622/627.</p>
                </div>

                <group invisible="is_demo_db">
                    <field name="confirm_force" widget="boolean_toggle"/>
                </group>

                <footer>
                    <button name="action_proceed_seed" 
                            string="Bắt đầu nạp dữ liệu" 
                            type="object" 
                            class="btn-primary" 
                            data-hotkey="q"/>
                    <button string="Hủy bỏ" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action mở wizard -->
    <record id="action_feed_demo_wizard" model="ir.actions.act_window">
        <field name="name">Nạp Dữ Liệu Mẫu</field>
        <field name="res_model">ps.mfg.feed.demo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu đặt trong Cấu hình Sản xuất (CHỈ hiển thị khi bật Chế độ Nhà phát triển - Debug Mode) -->
    <record id="menu_feed_demo_wizard" model="ir.ui.menu">
        <field name="name">Nạp Dữ Liệu Mẫu (Demo)</field>
        <field name="parent_id" ref="menu_ps_mfg_configuration"/>
        <field name="action" ref="action_feed_demo_wizard"/>
        <field name="sequence">999</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_no_one')])]"/>
    </record>
</odoo>
