<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_mfg_cost_item_view_list" model="ir.ui.view">
        <field name="name">ps.mfg.cost.item.view.list</field>
        <field name="model">ps.mfg.cost.item</field>
        <field name="arch" type="xml">
            <list string="Cost Items" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ps_mfg_cost_item_view_form" model="ir.ui.view">
        <field name="name">ps.mfg.cost.item.view.form</field>
        <field name="model">ps.mfg.cost.item</field>
        <field name="arch" type="xml">
            <form string="Cost Item">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Direct Labor"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. LABOR"/>
                        </group>
                        <group>
                            <field name="enabled" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ps_mfg_cost_item_view_search" model="ir.ui.view">
        <field name="name">ps.mfg.cost.item.view.search</field>
        <field name="model">ps.mfg.cost.item</field>
        <field name="arch" type="xml">
            <search string="Search Cost Item">
                <field name="code"/>
                <field name="name"/>
                <filter string="Enabled" name="enabled" domain="[('enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('enabled', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="ps_mfg_cost_item_action" model="ir.actions.act_window">
        <field name="name">Cost Items</field>
        <field name="res_model">ps.mfg.cost.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_mfg_cost_item_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first cost item</p>
        </field>
    </record>
</odoo>
