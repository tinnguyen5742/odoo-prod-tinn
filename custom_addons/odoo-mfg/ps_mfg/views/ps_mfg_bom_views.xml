<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ps_mfg_bom_overview" model="ir.actions.client">
        <field name="name">BoM Overview</field>
        <field name="tag">ps_mfg_bom_overview</field>
    </record>

    <record id="ps_mfg_bom_view_list" model="ir.ui.view">
        <field name="name">ps.mfg.bom.view.list</field>
        <field name="model">ps.mfg.bom</field>
        <field name="arch" type="xml">
            <list string="Bills of Materials" sample="1" multi_edit="1">
                <field name="enabled" column_invisible="True"/>
                <field name="sequence" widget="handle"/>
                <field name="company_id" column_invisible="True"/>
                <field name="product_tmpl_id"/>
                <field name="code" optional="show"/>
                <field name="product_id" groups="product.group_product_variant" optional="hide"/>
                <field name="product_id" groups="!product.group_product_variant" column_invisible="1"/>
                <field name="version" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="product_qty" optional="hide"/>
                <field name="product_uom_id" groups="uom.group_uom" optional="hide" widget="many2one_uom"/>
                <field name="enabled" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ps_mfg_bom_view_form" model="ir.ui.view">
        <field name="name">ps.mfg.bom.view.form</field>
        <field name="model">ps.mfg.bom</field>
        <field name="arch" type="xml">
            <form string="Bill of Materials">
                <header>
                    <button name="action_new_version" string="New Version" type="object" class="oe_highlight"/>
                    <field name="enabled" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(ps_mfg.action_ps_mfg_bom_overview)d" type="action"
                            class="oe_stat_button" icon="fa-bars">
                            <div class="o_stat_info">
                                <span class="o_stat_text">BoM Overview</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger" invisible="enabled"/>
                    <group>
                        <group>
                            <field name="enabled" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="product_tmpl_id" context="{'default_is_storable': True}"/>
                            <field name="product_id" groups="product.group_product_variant" context="{'default_is_storable': True}" options="{'no_create': True}"/>
                            <field name="product_id" groups="!product.group_product_variant" invisible="1"/>
                            <label for="product_qty" string="Quantity"/>
                            <div class="o_row">
                                <field name="product_qty" class="mw-25"/>
                                <field name="product_uom_id" options="{'no_open':True, 'no_create':True, 'product_field': 'product_tmpl_id', 'quantity_field': 'product_qty'}" groups="uom.group_uom" widget="many2one_uom"/>
                            </div>
                            <field name="possible_product_template_attribute_value_ids" invisible="1"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="version"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True, 'no_open': True}" placeholder="Visible to all"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operations" name="operations">
                            <p class="text-muted" invisible="operation_ids.length != 0">Add the operations describing how this product is manufactured, then link each component to an operation. Use "Add an operation" to define a new one, or "Select existing operation" to reuse one from the catalog.</p>
                            <field name="operation_ids"
                                context="{'default_bom_id': id, 'list_view_ref': 'ps_mfg.ps_mfg_routing_bom_list'}"/>
                        </page>
                        <page string="Components" name="components">
                            <field name="bom_line_ids" widget="one2many" context="{'default_parent_product_tmpl_id': product_tmpl_id, 'default_product_id': False, 'default_bom_id': id}">
                                <list string="Components">
                                    <control>
                                        <create string="Add a line"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" context="{'default_is_storable': True}"/>
                                    <field name="product_tmpl_id" column_invisible="True"/>
                                    <field name="possible_bom_product_template_attribute_value_ids" column_invisible="True"/>
                                    <field name="bom_product_template_attribute_value_ids" optional="hide" widget="many2many_tags" options="{'no_create': True}" column_invisible="parent.product_id" groups="product.group_product_variant"/>
                                    <field name="bom_version_id" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="parent_product_tmpl_id" column_invisible="True"/>
                                    <field name="product_uom_id" options="{'no_open': True, 'no_create': True, 'quantity_field': 'quantity'}" groups="uom.group_uom" widget="many2one_uom"/>
                                    <field name="allowed_operation_ids" column_invisible="True"/>
                                    <field name="operation_id" options="{'no_quick_create':True,'no_create_edit':True}"/>
                                    <field name="child_bom_id" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ps_mfg_bom_view_kanban" model="ir.ui.view">
        <field name="name">ps.mfg.bom.view.kanban</field>
        <field name="model">ps.mfg.bom</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <templates>
                    <t t-name="card">
                        <div>
                            <field name="product_tmpl_id" class="fw-medium fs-5"/>
                            <span class="float-end badge rounded-pill"><field name="product_qty"/> <field name="product_uom_id" class="small" groups="uom.group_uom"/></span>
                        </div>
                        <footer class="pt-1">
                            <field name="code"/>
                            <span class="float-end badge rounded-pill">v<field name="version"/></span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ps_mfg_bom_view_search" model="ir.ui.view">
        <field name="name">ps.mfg.bom.view.search</field>
        <field name="model">ps.mfg.bom</field>
        <field name="arch" type="xml">
            <search string="Search Bill of Materials">
                <field name="code" string="Bill of Materials" filter_domain="['|', ('code', 'ilike', self), ('product_tmpl_id', 'ilike', self)]"/>
                <field name="product_tmpl_id" string="Product"/>
                <field name="product_id" groups="product.group_product_variant"/>
                <field name="bom_line_ids" string="Component"/>
                <separator/>
                <filter string="Enabled" name="enabled" domain="[('enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('enabled', '=', False)]"/>
                <group>
                    <filter string="Product" name="product" domain="[]" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Version" name="groupby_version" domain="[]" context="{'group_by': 'version'}"/>
                    <filter string="Unit" name="default_unit_of_measure" domain="[]" context="{'group_by': 'product_uom_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ps_mfg_bom_line_view_form" model="ir.ui.view">
        <field name="name">ps.mfg.bom.line.view.form</field>
        <field name="model">ps.mfg.bom.line</field>
        <field name="arch" type="xml">
            <form string="Bill of Material line" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Component">
                            <field name="product_id"/>
                            <field name="parent_product_tmpl_id" invisible="1"/>
                            <label for="quantity" string="Quantity"/>
                            <div class="o_row">
                                <field name="quantity"/>
                                <field name="product_uom_id" options="{'no_open':True,'no_create':True, 'quantity_field': 'quantity'}" groups="uom.group_uom" widget="many2one_uom"/>
                            </div>
                            <field name="possible_bom_product_template_attribute_value_ids" invisible="1"/>
                            <field name="bom_product_template_attribute_value_ids" widget="many2many_tags" options="{'no_create': True}" groups="product.group_product_variant"/>
                            <field name="bom_version_id"/>
                        </group>
                        <group string="Operation">
                            <field name="sequence" groups="base.group_no_one"/>
                            <field name="allowed_operation_ids" invisible="1"/>
                            <field name="operation_id" required="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ps_mfg_bom_action" model="ir.actions.act_window">
        <field name="name">Bills of Materials</field>
        <field name="res_model">ps.mfg.bom</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="ps_mfg_bom_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bill of materials found. Let's create one!
            </p><p>
                Bills of materials allow you to define the list of required raw
                materials used to make a finished product; through a manufacturing
                order or a pack of products.
            </p>
        </field>
    </record>
</odoo>
