<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_mfg_production_view_list" model="ir.ui.view">
        <field name="name">ps.mfg.production.view.list</field>
        <field name="model">ps.mfg.production</field>
        <field name="arch" type="xml">
            <list string="Manufacturing Orders" sample="1" multi_edit="1">
                <field name="code"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom" optional="hide"/>
                <field name="bom_id" optional="show"/>
                <field name="workcenter_id" optional="show"/>
                <field name="deadline_date" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="ps_mfg_production_view_form" model="ir.ui.view">
        <field name="name">ps.mfg.production.view.form</field>
        <field name="model">ps.mfg.production</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_component_request" string="Create Component Request" type="object"
                            class="oe_highlight" invisible="state != 'confirmed' or has_component_request"/>
                    <button name="action_start" string="Start" type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Done" type="object" class="oe_highlight"
                            invisible="state not in ('confirmed', 'in_progress')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_print_production_order" type="object"
                                class="oe_stat_button" icon="fa-print">
                            <span>Lệnh SX</span>
                        </button>
                        <button name="action_view_component_requests" type="object" class="oe_stat_button"
                                icon="fa-cubes" invisible="not component_request_count">
                            <field name="component_request_count" widget="statinfo" string="Comp. Requests"/>
                        </button>
                        <button name="action_view_workorders" type="object" class="oe_stat_button"
                                icon="fa-cogs" invisible="not workorder_count">
                            <field name="workorder_count" widget="statinfo" string="Work Orders"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="has_component_request" invisible="1"/>
                            <field name="sale_order_id" options="{'no_quick_create': True}"
                                   readonly="state not in ('draft',)"/>
                            <field name="sale_product_ids" invisible="1"/>
                            <field name="sale_product_tmpl_ids" invisible="1"/>
                            <field name="product_id" options="{'no_quick_create': True}"
                                   readonly="state not in ('draft',)"
                                   domain="[('id', 'in', sale_product_ids)] if sale_order_id else []"/>
                            <label for="product_qty" string="Quantity"/>
                            <div class="o_row" name="qty">
                                <field name="product_qty"/>
                                <field name="product_uom_id" options="{'no_open': True, 'no_create': True}"
                                       groups="uom.group_uom" widget="many2one_uom"/>
                            </div>
                            <label for="tolerance_minus" string="Dung sai (%)"/>
                            <div class="o_row" name="tolerance">
                                <span>-</span>
                                <field name="tolerance_minus" class="oe_inline" readonly="state in ('done', 'cancel')"/>
                                <span class="me-2">%</span>
                                <span>+</span>
                                <field name="tolerance_plus" class="oe_inline" readonly="state in ('done', 'cancel')"/>
                                <span>%</span>
                            </div>
                            <label for="qty_tolerance_min" string="Số lượng cho phép"
                                   invisible="tolerance_plus == 0 and tolerance_minus == 0"/>
                            <div class="o_row" name="qty_tolerance_range"
                                 invisible="tolerance_plus == 0 and tolerance_minus == 0">
                                <field name="qty_tolerance_min" class="oe_inline" readonly="1"/>
                                <span>–</span>
                                <field name="qty_tolerance_max" class="oe_inline" readonly="1"/>
                                <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom"
                                       readonly="1" class="oe_inline" options="{'no_open': True, 'no_create': True}"/>
                            </div>
                            <field name="bom_id" options="{'no_quick_create': True}"
                                   readonly="state not in ('draft',)"
                                   domain="['&amp;', '|', ('company_id', '=', False), ('company_id', '=', company_id), '&amp;', ('enabled', '=', True), '|', ('product_id', 'in', sale_product_ids), '&amp;', ('product_id', '=', False), ('product_tmpl_id', 'in', sale_product_tmpl_ids)] if sale_order_id and not product_id else ['&amp;', '|', ('company_id', '=', False), ('company_id', '=', company_id), '&amp;', ('enabled', '=', True), '|', ('product_id', '=', product_id), '&amp;', ('product_tmpl_id.product_variant_ids', '=', product_id), ('product_id', '=', False)]"/>
                        </group>
                        <group>
                            <field name="workcenter_id" options="{'no_quick_create': True}"/>
                            <field name="customer_name" readonly="1"/>
                            <field name="user_id"/>
                            <field name="date_planned"/>
                            <field name="deadline_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="enabled" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components" name="components">
                            <field name="component_ids" context="{'default_production_id': id}"
                                   readonly="state != 'draft'">
                                <list string="Components" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" options="{'no_quick_create': True}"/>
                                    <field name="qty_planned"/>
                                    <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="operation_id" readonly="1" optional="hide"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="workorder_id"
                                           options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Work Orders" name="work_orders">
                            <field name="workorder_ids" context="{'default_production_id': id}"
                                   readonly="state != 'draft'">
                                <list string="Operations" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="routing_id" readonly="1" optional="hide"/>
                                    <field name="total_qty" readonly="1" optional="show"/>
                                    <field name="material_amount" readonly="1" optional="show"/>
                                    <field name="resource_amount" readonly="1" optional="show"/>
                                    <field name="total_amount" readonly="1" optional="show"/>
                                    <field name="transferred_in_cost" readonly="1" optional="hide"/>
                                    <field name="total_cost" readonly="1" optional="show"/>
                                    <field name="unit_cost" readonly="1" optional="show"/>
                                    <field name="consumed_lot_ids" widget="many2many_tags" readonly="1"
                                           optional="hide" groups="stock.group_production_lot"/>
                                    <button name="action_open_workorder" type="object" icon="fa-cogs"
                                            title="Work Order Resources and Details"/>
                                    <button name="action_create_workorder_move" type="object" icon="fa-arrow-right"
                                            title="Move Work Order"
                                            invisible="parent.state != 'in_progress' or not id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Packaging Guidelines" name="packaging_guidelines">
                            <field name="packaging_guideline_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="line_number" readonly="1"/>
                                    <field name="name"/>
                                    <field name="guideline_content"/>
                                </list>
                            </field>
                        </page>
                        <page string="Information" name="print_info">
                            <group>
                                <group string="Order">
                                    <field name="order_date"/>
                                    <field name="ref_mo_group"/>
                                    <field name="pokh_number"/>
                                    <field name="delivery_place"/>
                                </group>
                                <group string="Notes">
                                    <field name="caution"/>
                                    <field name="remark"/>
                                    <field name="tech_note"/>
                                    <field name="note"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ps_mfg_production_view_search" model="ir.ui.view">
        <field name="name">ps.mfg.production.view.search</field>
        <field name="model">ps.mfg.production</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <field name="bom_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="outdated" string="Outdated BoM" domain="[('outdated_bom', '=', True)]"/>
                <group>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_product" string="Product" domain="[]" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ps_mfg_production_action" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">ps.mfg.production</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ps_mfg_workorder_view_list" model="ir.ui.view">
        <field name="name">ps.mfg.workorder.view.list</field>
        <field name="model">ps.mfg.workorder</field>
        <field name="arch" type="xml">
            <list string="Work Orders" create="0">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="production_id" optional="hide"/>
                <field name="routing_id"/>
                <field name="operation_id" optional="hide"/>
                <field name="workcenter_id"/>
                <field name="total_qty"/>
                <field name="material_amount"/>
                <field name="resource_amount"/>
                <field name="total_amount"/>
                <field name="total_cost" optional="show"/>
                <field name="unit_cost" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ps_mfg_workorder_view_form" model="ir.ui.view">
        <field name="name">ps.mfg.workorder.view.form</field>
        <field name="model">ps.mfg.workorder</field>
        <field name="arch" type="xml">
            <form string="Work Order">
                <sheet>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="routing_id" readonly="1"/>
                            <field name="operation_id" readonly="1"/>
                            <field name="workcenter_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="production_id" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="material_amount" readonly="1"/>
                            <field name="resource_amount" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="stage_unit_cost" readonly="1"/>
                            <field name="transferred_in_cost" readonly="1"/>
                            <field name="total_cost" readonly="1"/>
                            <field name="unit_cost" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resources" name="resources">
                            <field name="resource_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="resource_id"/>
                                    <field name="resource_code"/>
                                    <field name="resource_name"/>
                                    <field name="cost_item_id"/>
                                    <field name="planned_cost"/>
                                    <field name="unit_cost"/>
                                    <field name="actual_cost"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
