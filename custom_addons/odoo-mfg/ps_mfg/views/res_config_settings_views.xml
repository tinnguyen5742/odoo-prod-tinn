<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ps_mfg" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ps_mfg</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Patsoft MFG" string="Patsoft MFG" name="ps_mfg">
                    <block title="Sequencing" name="production_sequencing_setting_container">
                        <setting id="production_sequencing_prefix" string="Sequencing Prefix" help="Prefix for Production Sequencing code generation (e.g. SEQ.)">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="mfg_sequencing_prefix" placeholder="e.g. SEQ."/>
                                </div>
                                <div class="mt8">
                                    <button name="action_open_production_sequencing_sequence"
                                            type="object"
                                            string="Configure Sequence"
                                            class="btn-link"
                                            icon="oi-arrow-right"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ps_mfg_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'ps_mfg', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_ps_mfg_settings"
        name="Settings"
        parent="menu_ps_mfg_configuration"
        sequence="0"
        action="action_ps_mfg_configuration"
        groups="base.group_system"/>
</odoo>
