<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cost Items -->
        <record id="demo_cost_item_labor" model="ps.mfg.cost.item">
            <field name="name">Chi phí nhân công trực tiếp</field>
            <field name="code">LABOR_DIR</field>
            <field name="enabled">True</field>
        </record>

        <record id="demo_cost_item_machine" model="ps.mfg.cost.item">
            <field name="name">Chi phí máy móc thiết bị</field>
            <field name="code">MACHINE_MCH</field>
            <field name="enabled">True</field>
        </record>

        <record id="demo_cost_item_overhead" model="ps.mfg.cost.item">
            <field name="name">Chi phí sản xuất chung</field>
            <field name="code">OVERHEAD_GEN</field>
            <field name="enabled">True</field>
        </record>

        <!-- Demo Products -->
        <record id="demo_product_steel_sheet" model="product.product">
            <field name="name">Thép tấm 2mm SS400</field>
            <field name="default_code">NVL-STEEL-01</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="tracking">lot</field>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="standard_price">35000.0</field>
        </record>

        <record id="demo_product_paint_powder" model="product.product">
            <field name="name">Bột sơn tĩnh điện Epoxy</field>
            <field name="default_code">NVL-PAINT-01</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="tracking">lot</field>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="standard_price">85000.0</field>
        </record>

        <record id="demo_product_bolt_m8" model="product.product">
            <field name="name">Bu lông &amp; Đai ốc M8</field>
            <field name="default_code">NVL-BOLT-M8</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="tracking">none</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="standard_price">1500.0</field>
        </record>

        <record id="demo_product_foot_pad" model="product.product">
            <field name="name">Đệm cao su chân bàn</field>
            <field name="default_code">NVL-PAD-01</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="tracking">none</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="standard_price">5000.0</field>
        </record>

        <record id="demo_product_desk_frame" model="product.product">
            <field name="name">Khung bàn thép định hình (BTP)</field>
            <field name="default_code">BTP-FRAME-01</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="tracking">none</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="standard_price">450000.0</field>
        </record>

        <record id="demo_product_metal_desk" model="product.product">
            <field name="name">Bàn làm việc khung thép công nghiệp (TP)</field>
            <field name="default_code">TP-DESK-001</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="tracking">lot</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="standard_price">950000.0</field>
            <field name="list_price">1850000.0</field>
        </record>
    </data>
</odoo>
