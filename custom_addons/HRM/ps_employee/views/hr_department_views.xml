<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa form phòng ban: nhà xưởng, tiền tố, tài khoản, kho -->
    <record id="ps_hr_department_view_form" model="ir.ui.view">
        <field name="name">ps.hr.department.view.form</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="is_operating"/>
                <field name="is_workshop"/>
            </xpath>
            <xpath expr="//group[@col='12']" position="after">
                <group string="Accounts">
                    <group>
                        <field name="material_cost_account_id" options="{'no_create': True}"
                               context="{'show_account_code': True}"/>
                    </group>
                    <group>
                        <field name="wip_account_id" options="{'no_create': True}"
                               context="{'show_account_code': True}"/>
                    </group>
                </group>
                <group string="Warehouses">
                    <group>
                        <field name="material_warehouse_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="finished_warehouse_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <group string="Workshop Prefixes" invisible="not is_workshop">
                    <group>
                        <field name="workshop_code" placeholder="A"/>
                        <field name="lsx_prefix" placeholder="LSXA"/>
                        <field name="yc_prefix" placeholder="YCA"/>
                        <field name="dn_prefix" placeholder="DNA"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="ps_hr_department_view_tree" model="ir.ui.view">
        <field name="name">ps.hr.department.view.list</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_operating"/>
                <field name="is_workshop"/>
                <field name="workshop_code" optional="hide"/>
                <field name="lsx_prefix" optional="hide"/>
                <field name="yc_prefix" optional="hide"/>
                <field name="dn_prefix" optional="hide"/>
                <field name="material_cost_account_id" optional="hide" context="{'show_account_code': True}"/>
                <field name="wip_account_id" optional="hide" context="{'show_account_code': True}"/>
                <field name="material_warehouse_id" optional="hide"/>
                <field name="finished_warehouse_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="ps_hr_department_view_search" model="ir.ui.view">
        <field name="name">ps.hr.department.view.search</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Operating" name="is_operating" domain="[('is_operating', '=', True)]"/>
                <filter string="Workshop" name="is_workshop" domain="[('is_workshop', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
