<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_hr_grade_tree_view" model="ir.ui.view">
        <field name="name">ps.hr.grade.tree</field>
        <field name="model">ps.hr.grade</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="sequence"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="ps_hr_grade_form_view" model="ir.ui.view">
        <field name="name">ps.hr.grade.form</field>
        <field name="model">ps.hr.grade</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ps_hr_grade_search_view" model="ir.ui.view">
        <field name="name">ps.hr.grade.search</field>
        <field name="model">ps.hr.grade</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="ps_hr_grade_action" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">ps.hr.grade</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
