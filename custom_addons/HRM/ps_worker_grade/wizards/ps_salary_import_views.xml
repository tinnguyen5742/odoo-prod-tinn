<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ps_worker_salary_import_view_form" model="ir.ui.view">
        <field name="name">ps.worker.salary.import.view.form</field>
        <field name="model">ps.worker.salary.import</field>
        <field name="arch" type="xml">
            <form string="Import Salary Matrix">
                <group>
                    <field name="x_salary_id" />
                    <field name="x_sheet_name" />
                    <field name="x_file" filename="x_filename" />
                    <field name="x_filename" invisible="1" />
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="ps_worker_salary_import_action" model="ir.actions.act_window">
        <field name="name">Import Salary Matrix</field>
        <field name="res_model">ps.worker.salary.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_ps_worker_salary" />
    </record>

</odoo>
