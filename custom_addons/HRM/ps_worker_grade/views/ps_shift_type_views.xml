<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shift Type List View -->
    <record id="ps_worker_shift_type_view_list" model="ir.ui.view">
        <field name="name">ps.worker.shift.type.view.list</field>
        <field name="model">ps.worker.shift.type</field>
        <field name="arch" type="xml">
            <list string="Shift Types" editable="bottom">
                <field name="x_sequence" widget="handle" />
                <field name="x_code" />
                <field name="x_name" />
                <field name="x_factor" />
                <field name="x_kpi_hours" />
                <field name="x_is_sunday" />
                <field name="x_round" />
                <field name="x_active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Shift Type Form View -->
    <record id="ps_worker_shift_type_view_form" model="ir.ui.view">
        <field name="name">ps.worker.shift.type.view.form</field>
        <field name="model">ps.worker.shift.type</field>
        <field name="arch" type="xml">
            <form string="Shift Type">
                <sheet>
                    <div class="oe_title">
                        <label for="x_name" />
                        <h1>
                            <field name="x_name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_code" />
                            <field name="x_factor" />
                            <field name="x_kpi_hours" />
                            <field name="x_sequence" />
                        </group>
                        <group>
                            <field name="x_is_sunday" />
                            <field name="x_round" />
                            <field name="x_active" widget="boolean_toggle" />
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="x_note" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Shift Type Search View -->
    <record id="ps_worker_shift_type_view_search" model="ir.ui.view">
        <field name="name">ps.worker.shift.type.view.search</field>
        <field name="model">ps.worker.shift.type</field>
        <field name="arch" type="xml">
            <search string="Search Shift Type">
                <field name="x_code" />
                <field name="x_name" />
                <filter string="Active" name="active" domain="[('x_active', '=', True)]" />
                <filter string="Inactive" name="inactive" domain="[('x_active', '=', False)]" />
            </search>
        </field>
    </record>

    <!-- Shift Type Action -->
    <record id="ps_worker_shift_type_action" model="ir.actions.act_window">
        <field name="name">Shift Types</field>
        <field name="res_model">ps.worker.shift.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_worker_shift_type_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first shift type
            </p>
        </field>
    </record>

</odoo>
