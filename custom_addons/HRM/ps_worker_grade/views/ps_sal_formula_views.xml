<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_worker_salary_formula_view_list" model="ir.ui.view">
        <field name="name">ps.worker.salary.formula.view.list</field>
        <field name="model">ps.worker.salary.formula</field>
        <field name="arch" type="xml">
            <list string="Salary Formulas" >
                <field name="x_code" />
                <field name="x_name" />
                <field name="x_profession_id" />
                <field name="x_job_id" />
                <field name="x_kpi_divisor" />
                <field name="x_active" widget="boolean_toggle" />
            </list>
        </field>
    </record>
    <record id="ps_worker_salary_formula_view_form" model="ir.ui.view">
        <field name="name">ps.worker.salary.formula.view.form</field>
        <field name="model">ps.worker.salary.formula</field>
        <field name="arch" type="xml">
            <form string="Salary Formula">
                <sheet>
                    <div class="oe_title">
                        <label for="x_name" />
                        <h1>
                            <field name="x_name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_code" />
                            <field name="x_profession_id" />
                            <field name="x_job_id" />
                            <field name="x_kpi_divisor" />
                        </group>
                        <group>
                            <field name="x_probation_shift_type_id" />
                            <field name="x_round_night" />
                            <field name="x_active" widget="boolean_toggle" />
                        </group>
                    </group>
                    <group>
                        <group string="Default Shift Counts">
                            <field name="x_shift_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="x_shift_type_id" />
                                    <field name="x_count" />
                                </list>
                            </field>
                        </group>
                        <group string="Default Allowances">
                            <field name="x_allowance_ids" nolabel="1" colspan="2" widget="many2many_tags" options="{'no_create': True}" />
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="x_note" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ps_worker_salary_formula_view_search" model="ir.ui.view">
        <field name="name">ps.worker.salary.formula.view.search</field>
        <field name="model">ps.worker.salary.formula</field>
        <field name="arch" type="xml">
            <search string="Search Formula">
                <field name="x_code" />
                <field name="x_name" />
                <field name="x_profession_id" />
                <field name="x_job_id" />
                <filter string="Active" name="active" domain="[('x_active', '=', True)]" />
                <filter string="Inactive" name="inactive" domain="[('x_active', '=', False)]" />
            </search>
        </field>
    </record>
    <record id="ps_worker_salary_formula_action" model="ir.actions.act_window">
        <field name="name">Salary Formulas</field>
        <field name="res_model">ps.worker.salary.formula</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_worker_salary_formula_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first salary formula
            </p>
        </field>
    </record>
</odoo>
