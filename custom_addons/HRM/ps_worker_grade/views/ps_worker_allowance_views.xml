<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="ps_worker_allowance_view_list" model="ir.ui.view">
        <field name="name">ps.worker.allowance.view.list</field>
        <field name="model">ps.worker.allowance</field>
        <field name="arch" type="xml">
            <list string="Worker Allowances" editable="bottom">
                <field name="x_sequence" widget="handle" />
                <field name="x_code" />
                <field name="x_name" />
                <field name="x_amount" />
                <field name="x_employee_type" />
                <field name="x_working_days" />
                <field name="x_probation_days" invisible="x_employee_type != 'probation'" />
                <field name="x_active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="ps_worker_allowance_view_form" model="ir.ui.view">
        <field name="name">ps.worker.allowance.view.form</field>
        <field name="model">ps.worker.allowance</field>
        <field name="arch" type="xml">
            <form string="Worker Allowance">
                <sheet>
                    <div class="oe_title">
                        <label for="x_name" />
                        <h1>
                            <field name="x_name" placeholder="e.g. Phụ cấp nhà ở" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_code" placeholder="e.g. PC_NHA_O" />
                            <field name="x_amount" />
                            <field name="x_employee_type" />
                            <field name="x_working_days" />
                            <field name="x_probation_days" invisible="x_employee_type != 'probation'" required="x_employee_type == 'probation'" />
                            <field name="x_sequence" />
                        </group>
                        <group>
                            <field name="x_active" widget="boolean_toggle" />
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="x_note" nolabel="1" placeholder="Add notes..." />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="ps_worker_allowance_view_search" model="ir.ui.view">
        <field name="name">ps.worker.allowance.view.search</field>
        <field name="model">ps.worker.allowance</field>
        <field name="arch" type="xml">
            <search string="Search Allowance">
                <field name="x_code" />
                <field name="x_name" />
                <filter string="Active" name="active" domain="[('x_active', '=', True)]" />
                <filter string="Inactive" name="inactive" domain="[('x_active', '=', False)]" />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="ps_worker_allowance_action" model="ir.actions.act_window">
        <field name="name">Allowances</field>
        <field name="res_model">ps.worker.allowance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_worker_allowance_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first worker allowance
            </p>
        </field>
    </record>

</odoo>
