<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ps_recruitment_applicant_form_view" model="ir.ui.view">
        <field name="name">ps.recruitment.applicant.form</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='linkedin_profile']" position="after">
                <field name="x_birth_date"/>
                <field name="x_gender"/>
                <field name="x_address"/>
                <field name="x_religion"/>
                <field name="x_employee_code" readonly="1" invisible="not x_employee_code"/>
            </xpath>

            <xpath expr="//field[@name='categ_ids']" position="after">
                <field name="x_ethnicity"/>
            </xpath>

            <xpath expr="//field[@name='type_id']" position="after">
                <field name="professional_level_id"/>
            </xpath>

            <xpath expr="//page[@name='application_note']" position="attributes">
                <attribute name="string">Mô tả công việc</attribute>
            </xpath>

        </field>
    </record>

    <record id="ps_recruitment_job_form_view" model="ir.ui.view">
        <field name="name">ps.recruitment.view_hr_job.form</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">

             <xpath expr="//group[@name='hiring_process']" position="attributes">
                <attribute name="string">Quy trình tuyển dụng</attribute>
            </xpath>

        </field>
    </record>

</odoo>
