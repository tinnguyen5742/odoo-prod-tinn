<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ps_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.ps</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="x_address_old" placeholder="Enter the address before the administrative merger"/>
            </xpath>
        </field>
    </record>
</odoo>
