<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="ps_work_schedule_registration_view_list" model="ir.ui.view">
        <field name="name">ps.work.schedule.registration.view.list</field>
        <field name="model">ps.work.schedule.registration</field>
        <field name="arch" type="xml">
            <list string="Work Schedule Registration">
                <field name="x_name" />
                <field name="x_registration_type" />
                <field name="x_year" options="{'enable_formatting': False}" />
                <field name="x_department_id" optional="show" />
                <field name="x_employee_id" optional="show" />
                <field name="x_registration_date" optional="show" />
                <field name="x_state" widget="badge"
                    decoration-info="x_state == 'draft'"
                    decoration-success="x_state == 'confirmed'" />
                <field name="x_company_id" groups="base.group_multi_company" optional="show" />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="ps_work_schedule_registration_view_form" model="ir.ui.view">
        <field name="name">ps.work.schedule.registration.view.form</field>
        <field name="model">ps.work.schedule.registration</field>
        <field name="arch" type="xml">
            <form string="Work Schedule Registration">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                        class="oe_highlight" invisible="x_state != 'draft'" />
                    <button name="action_draft" type="object" string="Set to Draft"
                        invisible="x_state != 'confirmed'" />
                    <field name="x_state" widget="statusbar" statusbar_visible="draft,confirmed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="x_name" />
                        <h1>
                            <field name="x_name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Registration Info">
                            <field name="x_registration_type" widget="radio" />
                            <field name="x_year" options="{'enable_formatting': False}" readonly="1"/>
                            <field name="x_registration_date" readonly="1" />
                            <field name="x_company_id" />
                            <field name="x_notes" />
                        </group>
                        

                        <group string="SHIFT ASSIGNMENT">
                            <group colspan="2">
                                <field name="x_department_id"
                                    domain="[('company_id', '=', x_company_id)]" />
                                <field name="x_employee_ids" invisible="1" />
                                <field name="x_employee_id"
                                    domain="[('id', 'in', x_employee_ids)]"
                                    context="{'show_address': 0}" />
                            </group>
                            <group colspan="2">
                                <field name="x_assignment_mode" widget="radio" />
                                <field name="x_fixed_shift_id"
                                    invisible="x_assignment_mode != 'static'"
                                    options="{'no_create': True}" />
                                <field name="x_rotation_id"
                                    invisible="x_assignment_mode != 'rotation'"
                                    options="{'no_create': True}" />
                            </group>
                            <group colspan="2">
                            <field name="x_apply_all_week_ids"
                                invisible="x_registration_type != 'week'"
                                options="{'no_create': True}"
                                domain="[('x_year', '=', x_year)]"
                                widget="many2many_tags" />
                                <field name="x_apply_all_month_ids"
                                    invisible="x_registration_type != 'month'"
                                    options="{'no_create': True}"
                                    widget="many2many_tags" />
                                <field name="x_apply_all_date_from"
                                    invisible="x_registration_type != 'day'" />
                                <field name="x_apply_all_date_to"
                                    invisible="x_registration_type != 'day'" />
                            </group>
                        </group>


                    </group>

                    <notebook>
                        <page string="Details">
                            <field name="x_line_ids" nolabel="1">
                                <list string="Registration Lines" editable="bottom" open_form_view="True">
                                    <field name="x_sequence" widget="handle" />
                                    <field name="x_employee_ids" column_invisible="1" />
                                    <field name="x_employee_id"
                                        options="{'no_create': True}"
                                        domain="[('id', 'in', x_employee_ids)]" />
                                    <field name="x_department_id" optional="show" />
                                    <field name="x_registration_type" column_invisible="1" />
                                    <field name="x_week_id" string="Week"
                                        invisible="x_registration_type != 'week'"
                                        options="{'no_create': True}"
                                        domain="[('x_year', '=', x_registration_id.x_year)]" />
                                    <field name="x_month" string="Month"
                                        invisible="x_registration_type != 'month'"
                                        options="{'no_create': True}" />
                                    <field name="x_date_from" string="Date From"
                                        invisible="x_registration_type != 'day'" />
                                    <field name="x_date_to" string="Date To"
                                        invisible="x_registration_type != 'day'" />
                                    <field name="x_notes" />
                                    <field name="x_state" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="ps_work_schedule_registration_view_search" model="ir.ui.view">
        <field name="name">ps.work.schedule.registration.view.search</field>
        <field name="model">ps.work.schedule.registration</field>
        <field name="arch" type="xml">
            <search string="Search Work Schedule Registration">
                <field name="x_name" />
                <field name="x_department_id" />
                <field name="x_employee_id" />
                <field name="x_year" options="{'format': 0}" />
                <filter string="Draft" name="draft" domain="[('x_state', '=', 'draft')]" />
                <filter string="Confirmed" name="confirmed" domain="[('x_state', '=', 'confirmed')]" />
                <filter string="Week Registration" name="week"
                    domain="[('x_registration_type', '=', 'week')]" />
                <filter string="Month Registration" name="month"
                    domain="[('x_registration_type', '=', 'month')]" />
                <filter string="Day Registration" name="day"
                    domain="[('x_registration_type', '=', 'day')]" />
                <group>
                    <filter string="Year" name="group_year" context="{'group_by': 'x_year'}" />
                    <filter string="Department" name="group_department"
                        context="{'group_by': 'x_department_id'}" />
                    <filter string="Type" name="group_type"
                        context="{'group_by': 'x_registration_type'}" />
                    <filter string="Company" name="group_company"
                        context="{'group_by': 'x_company_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="ps_work_schedule_registration_action" model="ir.actions.act_window">
        <field name="name">Work Schedule Registration</field>
        <field name="res_model">ps.work.schedule.registration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_work_schedule_registration_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first work schedule registration
            </p>
        </field>
    </record>

</odoo>