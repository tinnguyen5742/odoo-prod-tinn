<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ps.work.shift.slot -->
    <record id="ps_work_shift_slot_view_list" model="ir.ui.view">
        <field name="name">ps.work.shift.slot.view.list</field>
        <field name="model">ps.work.shift.slot</field>
        <field name="arch" type="xml">
            <list string="Work Shift Slot" editable="bottom" open_form_view="False">
                <field name="x_date" />
                <field name="x_employee_id" />
                <field name="x_shift_id" options="{'no_create': True}"
                    context="{'tree_view_ref': 'ps_attendance_management.ps_shift_view_list_select'}" widget="badge"/>
                <field name="x_shift_start_time" widget="float_time" />
                <field name="x_shift_end_time" widget="float_time" />
                <field name="x_overtime_from" widget="float_time" />
                <field name="x_overtime_to" widget="float_time" />
                <field name="x_overtime_hours" widget="badge"
                    decoration-info="x_overtime_hours > 0" />
                <field name="x_source" widget="badge"
                    decoration-info="x_source == 'auto'"
                    decoration-warning="x_source == 'manual'" />
                <field name="x_old_shift_id" options="{'no_create': True}" widget="badge" optional="show" />
                <field name="x_change_reason" optional="show" />
                <field name="x_change_date" optional="show" widget="badge"/>
                <field name="x_shift_change_id" options="{'no_create': True}" optional="show" widget="badge"/>
                <field name="x_company_id" groups="base.group_multi_company" optional="show" />
            </list>
        </field>
    </record>

    <record id="ps_work_shift_slot_view_form" model="ir.ui.view">
        <field name="name">ps.work.shift.slot.view.form</field>
        <field name="model">ps.work.shift.slot</field>
        <field name="arch" type="xml">
            <form string="Work Shift Slot">
                <sheet>
                    <div class="oe_title">
                        <label for="x_name" />
                        <h1>
                            <field name="x_name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="General Info">
                            <field name="x_employee_id" />
                            <field name="x_date" />
                            <field name="x_shift_id" options="{'no_create': True}" />
                            <field name="x_company_id" groups="base.group_multi_company" />
                        </group>
                        <group string="Shift Change History">
                            <field name="x_old_shift_id" options="{'no_create': True}" />
                            <field name="x_change_reason" />
                            <field name="x_change_date" />
                            <field name="x_shift_change_id" options="{'no_create': True}" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="ps_work_shift_slot_view_search" model="ir.ui.view">
        <field name="name">ps.work.shift.slot.view.search</field>
        <field name="model">ps.work.shift.slot</field>
        <field name="arch" type="xml">
            <search string="Search Work Shift Slot">
                <field name="x_employee_id" />
                <field name="x_shift_id" />
                <field name="x_date" />
                <field name="x_shift_start_time" />
                <field name="x_shift_end_time" />
                <field name="x_overtime_from" />
                <field name="x_overtime_to" />
                <field name="x_old_shift_id" />
                <field name="x_change_reason" />
                <field name="x_change_date" />
                <field name="x_shift_change_id" />
                <field name="x_company_id" groups="base.group_multi_company" />

                <filter string="Today" name="today"
                    domain="[('x_date', '=', context_today())]" />
                <filter string="This Week" name="this_week"
                    domain="[
                        ('x_date', '&gt;=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')),
                        ('x_date', '&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d'))
                    ]" />
                <filter string="This Month" name="this_month"
                    domain="[
                        ('x_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                        ('x_date', '&lt;=', (context_today() + relativedelta(months=1, day=1) - relativedelta(days=1)).strftime('%Y-%m-%d'))
                    ]" />

                <group>
                    <filter string="Employee" name="group_employee"
                        context="{'group_by': 'x_employee_id'}" />
                    <filter string="Shift" name="group_shift"
                        context="{'group_by': 'x_shift_id'}" />
                    <filter string="Date" name="group_date"
                        context="{'group_by': 'x_date'}" />
                    <filter string="Source" name="group_source"
                        context="{'group_by': 'x_source'}" />
                    <filter string="Company" name="group_company"
                        context="{'group_by': 'x_company_id'}"
                        groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>

    <record id="ps_work_shift_slot_view_pivot" model="ir.ui.view">
        <field name="name">ps.work.shift.slot.view.pivot</field>
        <field name="model">ps.work.shift.slot</field>
        <field name="arch" type="xml">
            <pivot string="Shift Schedule">
                <field name="x_employee_id" type="row" />
                <field name="x_date" type="col" />
                <field name="x_shift_id" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="ps_work_shift_slot_view_calendar" model="ir.ui.view">
        <field name="name">ps.work.shift.slot.view.calendar</field>
        <field name="model">ps.work.shift.slot</field>
        <field name="arch" type="xml">
            <calendar string="Shift Schedule" date_start="x_date" color="x_shift_id">
                <field name="x_employee_id" />
                <field name="x_shift_id" />
            </calendar>
        </field>
    </record>

    <!-- Shift Schedule: màn hình lịch phân ca trực quan (pivot/calendar/list) -->
    <record id="ps_work_shift_schedule_action" model="ir.actions.act_window">
        <field name="name">Shift Schedule</field>
        <field name="res_model">ps.work.shift.slot</field>
        <field name="view_mode">list,calendar,pivot,form</field>
        <field name="search_view_id" ref="ps_work_shift_slot_view_search" />
        <!-- Mo danh sach phan ca khong filter mac dinh, hien tat ca ban ghi -->
        <field name="context">{}</field>
    </record>

    <record id="action_generate_shift_slots" model="ir.actions.server">
        <field name="name">Generate Shift Schedule</field>
        <field name="model_id" ref="model_ps_work_shift_slot" />
        <field name="binding_model_id" ref="model_ps_work_shift_slot" />
        <field name="state">code</field>
        <field name="code"><![CDATA[
env['ps.shift.schedule']._cron_generate_shift_slots(30)
action = {'type': 'ir.actions.client', 'tag': 'reload'}
        ]]></field>
    </record>

</odoo>