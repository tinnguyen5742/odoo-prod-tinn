<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ps_hr_attendance_view_list" model="ir.ui.view">
        <field name="name">ps.hr.attendance.list</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='in_location']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='out_location']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="location" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>