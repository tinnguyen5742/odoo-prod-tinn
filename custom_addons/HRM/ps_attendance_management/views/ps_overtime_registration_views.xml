<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="ps_overtime_registration_view_list" model="ir.ui.view">
        <field name="name">ps.overtime.registration.view.list</field>
        <field name="model">ps.overtime.registration</field>
        <field name="arch" type="xml">
            <list string="Overtime Registration">
                <field name="x_name" />
                <field name="x_registration_date" />
                <field name="x_department_id" optional="show" />
                <field name="x_date_from" optional="show" />
                <field name="x_date_to" optional="show" />
                <field name="x_time_from" optional="show" />
                <field name="x_time_to" optional="show" />
                <field name="x_overtime_hours" optional="show" />
                <field name="x_state" widget="badge"
                    decoration-info="x_state == 'draft'"
                    decoration-success="x_state == 'confirmed'" />
                <field name="x_company_id" groups="base.group_multi_company" optional="show" />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="ps_overtime_registration_view_form" model="ir.ui.view">
        <field name="name">ps.overtime.registration.view.form</field>
        <field name="model">ps.overtime.registration</field>
        <field name="arch" type="xml">
            <form string="Overtime Registration">
                <!-- Các nút hành động và trạng thái -->
                <header>
                    <!-- Trạng thái nháp và confirmed -->
                    <button name="action_confirm" type="object" string="Confirm"
                        class="oe_highlight" invisible="x_state != 'draft'" />
                    <button name="action_draft" type="object" string="Set to Draft"
                        invisible="x_state != 'confirmed'"
                        confirm="The overtime registration has been confirmed. Do you want to change the information?" />
                    <field name="x_state" widget="statusbar" statusbar_visible="draft,confirmed" />
                    <!-- Button load lại thông tin nhân viên từ phòng ban và ngày tháng -->
                    <button name="action_load_employees" type="object"
                        string="Load" icon="fa-users"
                        class="btn-secondary"
                        invisible="x_state == 'confirmed'" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="x_name" />
                        <h1>
                            <field name="x_name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <!-- Thông tin chung phiếu đăng ký -->
                        <group string="Registration Info">
                            <field name="x_registration_date" readonly="x_state == 'confirmed'" />
                            <field name="x_department_id"
                                domain="[('company_id', '=', x_company_id)]"
                                readonly="x_state == 'confirmed'" />
                            <field name="x_employee_ids" invisible="1" />
                            <field name="x_employee_id"
                                domain="[('id', 'in', x_employee_ids)]"
                                context="{'show_address': 0}"
                                readonly="x_state == 'confirmed'" />
                            <field name="x_company_id" readonly="x_state == 'confirmed'" />
                            <field name="x_notes" readonly="x_state == 'confirmed'" />
                        </group>
                        <!-- Dữ liệu nhập: ca, ngày, giờ -->
                        <group string="Data Input">
                            <group class="col-lg-12">
                                    <field name="x_shift_id" options="{'no_create': True}" readonly="x_state == 'confirmed'" />
                            </group>
                            <group colspan="2" class="col-lg-12">
                                <group class="col-lg-12">
                                    <label for="x_date_from" string="Ngày tăng ca" />
                                    <div class="o_row">
                                        <field name="x_date_from" widget="daterange" nolabel="1"
                                            class="oe_inline"
                                            options="{'related_end_date': 'x_date_to'}"
                                            readonly="x_state == 'confirmed'" />
                                        <i class="fa fa-long-arrow-right mx-2"
                                            aria-label="Arrow icon" title="Arrow" />
                                        <field name="x_date_to" widget="daterange" nolabel="1"
                                            class="oe_inline"
                                            options="{'related_start_date': 'x_date_from'}"
                                            readonly="x_state == 'confirmed'" />
                                    </div>
                                </group>
                            </group>
                            <group class="col-lg-12">
                                <label for="x_time_from" string="Khung giờ tăng ca" />
                                <div class="o_row">
                                    <field name="x_time_from" widget="float_time" nolabel="1"
                                        class="oe_inline" readonly="x_state == 'confirmed'" />
                                    <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon"
                                        title="Arrow" />
                                    <field name="x_time_to" widget="float_time" nolabel="1"
                                        class="oe_inline" readonly="x_state == 'confirmed'" />
                                </div>
                            </group>
                            <group>
                                <field name="x_overtime_hours" readonly="1" />
                            </group>

                        </group>
                    </group>

                    <notebook>
                        <!-- Tab chi tiết dòng tăng ca -->
                        <page string="Details">
                            <field name="x_line_ids" nolabel="1">
                                <list string="Overtime Registration Lines" editable="bottom" open_form_view="True">
                                    <field name="x_employee_ids" column_invisible="1" />
                                    <field name="x_employee_code" optional="show" />
                                    <field name="x_employee_id"
                                        options="{'no_create': True}"
                                        domain="[('id', 'in', x_employee_ids)]"
                                        readonly="parent.x_state == 'confirmed'" />
                                    <field name="x_department_id" optional="hide" />
                                    <field name="x_date_from" readonly="parent.x_state == 'confirmed'" />
                                    <field name="x_date_to" readonly="parent.x_state == 'confirmed'" />
                                    <field name="x_shift_display" readonly="1" />
                                    <field name="x_time_from" widget="float_time" readonly="parent.x_state == 'confirmed'" />
                                    <field name="x_time_to" widget="float_time" readonly="parent.x_state == 'confirmed'" />
                                    <field name="x_overtime_hours" readonly="1" />
                                    <field name="x_notes" readonly="parent.x_state == 'confirmed'" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="ps_overtime_registration_view_search" model="ir.ui.view">
        <field name="name">ps.overtime.registration.view.search</field>
        <field name="model">ps.overtime.registration</field>
        <field name="arch" type="xml">
            <search string="Search Overtime Registration">
                <!-- Bộ lọc tìm kiếm -->

                <field name="x_name" />
                <field name="x_department_id" />
                <field name="x_employee_id" />
                <field name="x_registration_date" />
                <filter string="Draft" name="draft" domain="[('x_state', '=', 'draft')]" />
                <filter string="Confirmed" name="confirmed" domain="[('x_state', '=', 'confirmed')]" />
                <group>
                    <filter string="Department" name="group_department"
                        context="{'group_by': 'x_department_id'}" />
                    <filter string="Status" name="group_state"
                        context="{'group_by': 'x_state'}" />
                    <filter string="Company" name="group_company"
                        context="{'group_by': 'x_company_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action mở form tăng ca -->
    <record id="ps_overtime_registration_action" model="ir.actions.act_window">
        <field name="name">Overtime Registration</field>
        <field name="res_model">ps.overtime.registration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_overtime_registration_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first overtime registration
            </p>
        </field>
    </record>

</odoo>