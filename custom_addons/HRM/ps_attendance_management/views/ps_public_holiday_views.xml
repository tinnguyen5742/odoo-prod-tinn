<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="ps_holiday_view_list" model="ir.ui.view">
        <field name="name">ps.public.holiday.view.list</field>
        <field name="model">ps.public.holiday</field>
        <field name="arch" type="xml">
            <list string="Public Holiday" editable="bottom" >
                <field name="active" column_invisible="1" />
                <field name="x_year" widget="badge" />
                <field name="x_holiday_date" />
                <field name="x_name" />
                <field name="x_lunar_formula" />
                <field name="x_compensatory" invisible="1" />
                <field name="x_compensatory_date" />
                <field name="x_notes" />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="ps_holiday_view_form" model="ir.ui.view">
        <field name="name">ps.public.holiday.view.form</field>
        <field name="model">ps.public.holiday</field>
        <field name="arch" type="xml">
            <form string="Public Holiday">
                <sheet>
                    <div class="oe_title">
                        <label for="x_name" />
                        <h1>
                            <field name="x_name" placeholder="e.g. Tet Nguyen Dan" />
                        </h1>
                    </div>
                    <group>
                        <group string="General Info">
                            <field name="x_year" />
                            <field name="x_holiday_date" />
                            <field name="x_lunar_formula" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="active" invisible="1" />
                        </group>
                        <group string="Compensatory Leave">
                            <field name="x_compensatory" />
                            <field name="x_compensatory_date" invisible="not x_compensatory" />
                        </group>
                    </group>
                    <group string="Notes">
                        <div colspan="2">
                            <field name="x_notes" nolabel="1"
                                placeholder="Add notes about the holiday..." />
                        </div>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="ps_holiday_view_search" model="ir.ui.view">
        <field name="name">ps.public.holiday.view.search</field>
        <field name="model">ps.public.holiday</field>
        <field name="arch" type="xml">
            <search string="Search Holiday">
                <field name="x_name" />
                <field name="x_year" />
                <field name="x_lunar_formula" />
                <filter string="Active" name="active" domain="[('active', '=', True)]" />
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]" />
                <filter string="Compensatory" name="compensatory"
                    domain="[('x_compensatory', '=', True)]" />
                <group>
                    <filter string="Year" name="group_year" context="{'group_by': 'x_year'}" />
                    <filter string="Company" name="group_company"
                        context="{'group_by': 'company_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="ps_holiday_action" model="ir.actions.act_window">
        <field name="name">Public Holiday</field>
        <field name="res_model">ps.public.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_holiday_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first public holiday
            </p>
        </field>
    </record>

</odoo>