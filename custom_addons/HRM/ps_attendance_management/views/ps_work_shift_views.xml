<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="ps_shift_view_list" model="ir.ui.view">
        <field name="name">ps.work.shift.view.list</field>
        <field name="model">ps.work.shift</field>
        <field name="arch" type="xml">
            <list string="Work Shift" editable="bottom">
                <field name="x_shift_code" />
                <field name="x_shift_name" />
                <field name="x_working_hours" widget="float_time" class="ps_hours_badge"/>
                <field name="x_start_time" widget="float_time" />
                <field name="x_end_time" widget="float_time" />
                <field name="x_has_lunch_break" widget="boolean_toggle"/>
                <field name="x_lunch_break_start" widget="float_time" readonly="not x_has_lunch_break"/>
                <field name="x_lunch_break_end" widget="float_time" readonly="not x_has_lunch_break"/>
                <field name="x_notes" />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="ps_shift_view_form" model="ir.ui.view">
        <field name="name">ps.work.shift.view.form</field>
        <field name="model">ps.work.shift</field>
        <field name="arch" type="xml">
            <form string="Work Shift">
                <sheet>
                    <div class="oe_title">
                        <label for="x_shift_name" />
                        <h1>
                            <field name="x_shift_name" placeholder="e.g. Morning" />
                        </h1>
                    </div>
                    <group>
                        <group string="General Info">
                            <field name="x_shift_code" placeholder="e.g. CA1" />
                            <field name="x_category" />
                            <field name="x_is_rotatable" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="active" invisible="1" />
                        </group>
                        <group string="Working Time">
                            <field name="x_start_time" widget="float_time" />
                            <field name="x_end_time" widget="float_time" />
                            <field name="x_working_hours" widget="float_time" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <group string="Lunch Break">
                            <field name="x_has_lunch_break" widget="boolean_toggle" />
                            <field name="x_lunch_break_start" widget="float_time"
                                readonly="not x_has_lunch_break" />
                            <field name="x_lunch_break_end" widget="float_time"
                                readonly="not x_has_lunch_break" />
                        </group>
                        <group string="Notes">
                            <div colspan="2">
                                <field name="x_notes" nolabel="1"
                                    placeholder="Add notes about the shift..." />
                                </div>
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="ps_shift_view_search" model="ir.ui.view">
        <field name="name">ps.work.shift.view.search</field>
        <field name="model">ps.work.shift</field>
        <field name="arch" type="xml">
            <search string="Search Shift">
                <field name="x_shift_code" />
                <field name="x_shift_name" />
                <filter string="Active" name="active" domain="[('active', '=', True)]" />
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]" />
                <group>
                    <filter string="Company" name="group_company"
                        context="{'group_by': 'company_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="ps_shift_action" model="ir.actions.act_window">
        <field name="name">Work Shift</field>
        <field name="res_model">ps.work.shift</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ps_shift_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first work shift
            </p>
        </field>
    </record>


</odoo>