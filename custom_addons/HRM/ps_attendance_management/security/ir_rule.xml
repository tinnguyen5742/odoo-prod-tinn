<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cho phép nhóm Quản trị chấm công xem tất cả nhân viên mọi công ty -->
    <record id="rule_hr_employee_attendance_manager" model="ir.rule">
        <field name="name">HR Employee: Attendance Manager - All Companies</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Cho phép nhóm Quản trị chấm công xem tất cả bộ phận mọi công ty -->
    <record id="rule_hr_department_attendance_manager" model="ir.rule">
        <field name="name">HR Department: Attendance Manager - All Companies</field>
        <field name="model_id" ref="hr.model_hr_department"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
