<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_appointment" model="ir.module.category">
        <field name="name">Appointment Management</field>
        <field name="sequence">44</field>
    </record>
    <record id="privilege_appointment" model="res.groups.privilege">
        <field name="name">Appointment Management</field>
        <field name="category_id" ref="module_category_appointment"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_appointment_user" model="res.groups">
        <field name="name">Appointment User</field>
        <field name="privilege_id" ref="privilege_appointment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_appointment_receptionist" model="res.groups">
        <field name="name">Appointment Receptionist</field>
        <field name="privilege_id" ref="privilege_appointment"/>
        <field name="implied_ids" eval="[(4, ref('group_appointment_user'))]"/>
    </record>
    <record id="group_appointment_manager" model="res.groups">
        <field name="name">Appointment Manager</field>
        <field name="privilege_id" ref="privilege_appointment"/>
        <field name="implied_ids" eval="[(4, ref('group_appointment_receptionist'))]"/>
    </record>
    <record id="group_appointment_administrator" model="res.groups">
        <field name="name">Appointment Administrator</field>
        <field name="privilege_id" ref="privilege_appointment"/>
        <field name="implied_ids" eval="[(4, ref('group_appointment_manager'))]"/>
    </record>

    <record id="rule_appointment_company" model="ir.rule">
        <field name="name">Appointments: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_appointment_user_own" model="ir.rule">
        <field name="name">Appointment users: created or assigned appointments</field>
        <field name="model_id" ref="model_ps_appointment"/>
        <field name="groups" eval="[(4, ref('group_appointment_user'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_appointment_receptionist_all" model="ir.rule">
        <field name="name">Appointment receptionists: company appointments</field>
        <field name="model_id" ref="model_ps_appointment"/>
        <field name="groups" eval="[(4, ref('group_appointment_receptionist'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_type_company" model="ir.rule">
        <field name="name">Appointment service types: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_type_user_active" model="ir.rule">
        <field name="name">Appointment users: active service types</field>
        <field name="model_id" ref="model_ps_appointment_type"/>
        <field name="groups" eval="[(4, ref('group_appointment_user'))]"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_type_manager_all" model="ir.rule">
        <field name="name">Appointment managers: all service types</field>
        <field name="model_id" ref="model_ps_appointment_type"/>
        <field name="groups" eval="[(4, ref('group_appointment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_resource_company" model="ir.rule">
        <field name="name">Appointment resources: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment_resource"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_schedule_company" model="ir.rule">
        <field name="name">Appointment schedules: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_holiday_company" model="ir.rule">
        <field name="name">Appointment holidays: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment_holiday"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_slot_company" model="ir.rule">
        <field name="name">Appointment slots: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment_slot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_booking_company" model="ir.rule">
        <field name="name">Appointment resource bookings: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment_resource_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_booking_user_own" model="ir.rule">
        <field name="name">Appointment users: own resource bookings</field>
        <field name="model_id" ref="model_ps_appointment_resource_booking"/>
        <field name="groups" eval="[(4, ref('group_appointment_user'))]"/>
        <field name="domain_force">['|', ('appointment_id.create_uid', '=', user.id), ('appointment_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_booking_manager_all" model="ir.rule">
        <field name="name">Appointment managers: all resource bookings</field>
        <field name="model_id" ref="model_ps_appointment_resource_booking"/>
        <field name="groups" eval="[(4, ref('group_appointment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_reminder_company" model="ir.rule">
        <field name="name">Appointment reminders: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment_reminder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_reminder_user_own" model="ir.rule">
        <field name="name">Appointment users: own reminders</field>
        <field name="model_id" ref="model_ps_appointment_reminder"/>
        <field name="groups" eval="[(4, ref('group_appointment_user'))]"/>
        <field name="domain_force">['|', ('appointment_id.create_uid', '=', user.id), ('appointment_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_reminder_manager_all" model="ir.rule">
        <field name="name">Appointment managers: all reminders</field>
        <field name="model_id" ref="model_ps_appointment_reminder"/>
        <field name="groups" eval="[(4, ref('group_appointment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_history_company" model="ir.rule">
        <field name="name">Appointment history: allowed companies</field>
        <field name="model_id" ref="model_ps_appointment_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_history_user_own" model="ir.rule">
        <field name="name">Appointment users: own change history</field>
        <field name="model_id" ref="model_ps_appointment_history"/>
        <field name="groups" eval="[(4, ref('group_appointment_user'))]"/>
        <field name="domain_force">['|', ('appointment_id.create_uid', '=', user.id), ('appointment_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_history_manager_all" model="ir.rule">
        <field name="name">Appointment managers: all change history</field>
        <field name="model_id" ref="model_ps_appointment_history"/>
        <field name="groups" eval="[(4, ref('group_appointment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_schedule_manager" model="ir.rule">
        <field name="name">Appointment managers: all schedules</field>
        <field name="model_id" ref="model_ps_appointment_schedule"/>
        <field name="groups" eval="[(4, ref('group_appointment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_slot_user_active" model="ir.rule">
        <field name="name">Appointment users: available slots</field>
        <field name="model_id" ref="model_ps_appointment_slot"/>
        <field name="groups" eval="[(4, ref('group_appointment_user'))]"/>
        <field name="domain_force">[('state', '=', 'available')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_slot_manager_all" model="ir.rule">
        <field name="name">Appointment managers: all slots</field>
        <field name="model_id" ref="model_ps_appointment_slot"/>
        <field name="groups" eval="[(4, ref('group_appointment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
