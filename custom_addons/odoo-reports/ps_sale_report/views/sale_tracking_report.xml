<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_tracking_pdf" model="ir.actions.report">
        <field name="name">Theo dõi đơn hàng</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_sale_report.sale_tracking_pdf</field>
        <field name="report_file">ps_sale_report.sale_tracking_pdf</field>
        <field name="paperformat_id" ref="paperformat_sale_history"/>
        <field name="print_report_name">'Theo_doi_don_hang_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
    <template id="sale_tracking_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="text-align:center; font-size:8pt">Trang <span class="page"/> / <span class="topage"/></div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_report.sale_preview_styles"/>
                    <style>
                        .ps-tracking {font-family:'Times New Roman','Nimbus Roman','DejaVu Serif',serif; font-size:7pt; color:#111; page-break-after:always;}
                        .ps-tracking:last-child {page-break-after:auto;}
                        .ps-tracking h1 {font-size:18px; text-align:center; margin:6px 0; font-weight:bold;}
                        .ps-tracking .period {text-align:center; margin-bottom:5px;}
                        .ps-tracking .filters {font-size:6.5pt; margin-bottom:5px;}
                        .ps-tracking table {width:100%; table-layout:fixed; border-collapse:collapse; font-size:5.5pt;}
                        .ps-tracking td,.ps-tracking th {border:1px solid #333; padding:3px 1px; line-height:1.2; word-wrap:break-word; vertical-align:middle;}
                        .ps-tracking th {text-align:center; background:#eee;}
                        .ps-tracking tr {page-break-inside:avoid;}
                        .ps-tracking .num {text-align:right;}
                        .ps-tracking .note {font-size:6pt; margin-top:7px;}
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-tracking">
                            <div class="company"><strong t-out="wizard.company_id.name"/></div>
                            <h1>BÁO CÁO THEO DÕI ĐƠN HÀNG</h1>
                            <div class="period">Từ ngày <t t-out="format_date(wizard.date_from)"/> đến ngày <t t-out="format_date(wizard.date_to)"/></div>
                            <div class="filters" t-out="report['filters']"/>
                            <t t-set="columns" t-value="report['columns']"/>
                                <table>
                                    <colgroup><col t-foreach="columns" t-as="col" t-att-style="'width:' + str(100 * col[3] / sum(c[3] for c in columns)) + '%'"/></colgroup>
                                    <thead><tr><th t-foreach="columns" t-as="col" t-out="col[1]"/></tr></thead>
                                    <tbody>
                                        <tr t-foreach="page" t-as="item">
                                            <td t-foreach="columns" t-as="col" t-att-class="'num' if col[2] == 'number' else ''">
                                                <t t-set="value" t-value="item[col[0]]"/>
                                                <t t-if="value is None or value is False or value == ''">&#160;</t>
                                                <t t-elif="col[0] == 'seq'" t-out="value"/>
                                                <t t-elif="col[2] == 'number'" t-out="format_number(value)"/>
                                                <t t-elif="col[2] == 'date'" t-out="format_date(value)"/>
                                                <t t-else="" t-out="value"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            <t t-if="page_last" t-call="ps_sale_report.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
