<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- PHẦN 1: Lịch sử đặt hàng; nguồn: sale_history_views.xml. -->
    <record id="view_sale_history_line_list"
            model="ir.ui.view">
        <field name="name">ps.sale.history.line.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Lịch sử đặt hàng"
                  create="false"
                  edit="false"
                  delete="false"
                  default_order="order_id desc, sequence, id">

                <field name="order_id"
                       string="Số đơn đặt hàng"/>
                <field name="ps_contract_ref"
                       optional="show"/>

                <field name="product_id"
                       string="Mã / Tên vật tư"/>
                <field name="name"
                       string="Diễn giải"
                       optional="hide"/>
                <field name="ps_specification"/>

                <field name="product_uom_id"
                       string="ĐVT"/>
                <field name="price_unit"
                       string="Đơn giá"/>
                <field name="product_uom_qty"
                       string="Số lượng giao dịch"/>

                <field name="ps_base_quantity"/>
                <field name="ps_base_uom_id"/>

                <field name="ps_requested_receipt_date"/>
                <field name="ps_confirmed_receipt_date"/>
                <field name="ps_production_ref"/>
                <field name="ps_production_number"/>
                <field name="ps_customer_po"/>
                <field name="ps_report_note"/>

                <field name="discount"
                       string="Chiết khấu (%)"
                       optional="hide"/>
                <field name="price_subtotal"
                       string="Trước thuế"
                       optional="hide"/>
                <field name="currency_id"
                       column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- PHẦN 3: Tình hình thực hiện hợp đồng; nguồn: sale_contract_views.xml. -->
    <record id="view_sale_contract_line_list"
            model="ir.ui.view">
        <field name="name">ps.sale.contract.line.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Tình hình thực hiện hợp đồng"
                  create="false"
                  edit="false"
                  delete="false"
                  default_order="order_id, sequence, id">

                <field name="ps_contract_customer_id"/>
                <field name="order_id"
                       string="Số SO"/>
                <field name="ps_contract_ref"
                       string="Số hợp đồng"/>

                <field name="product_id"
                       string="Mặt hàng"/>
                <field name="product_uom_id"
                       string="ĐVT"/>
                <field name="currency_id"
                       string="Loại tiền"/>

                <field name="product_uom_qty"
                       string="SL đặt"/>
                <field name="price_unit"
                       string="Đơn giá"/>
                <field name="price_total"
                       string="Trị giá đặt hàng"/>
                <field name="ps_contract_promised_date"/>

                <field name="ps_contract_delivered_qty"/>
                <field name="ps_contract_delivered_value"/>
                <field name="ps_contract_last_delivery_date"/>
                <field name="ps_contract_remaining_qty"/>

                <field name="ps_report_note"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <!-- PHẦN 7: Theo dõi đơn hàng; nguồn: sale_tracking_views.xml. -->
    <record id="view_sale_tracking_line_list" model="ir.ui.view">
        <field name="name">sale.order.line.ps.tracking.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Theo dõi đơn hàng" create="0" edit="0" delete="0">
                <field name="ps_tracking_salesperson_id"/>
                <field name="ps_contract_customer_id"/>
                <field name="order_id"/>
                <field name="ps_customer_po"/>
                <field name="ps_tracking_order_date"/>
                <field name="ps_specification"/>
                <field name="ps_tracking_product_code"/>
                <field name="product_id"/>
                <field name="product_uom_qty" string="SL"/>
                <field name="product_uom_id" string="ĐVT (KH)"/>
                <field name="ps_tracking_quantity_limit"/>
                <field name="ps_tracking_quantity_m2"/>
                <field name="ps_requested_delivery_date"/>
                <field name="ps_actual_receipt_date"/>
                <field name="ps_customer_confirmation_date"/>
                <field name="qty_delivered" string="SL đã giao"/>
                <field name="ps_tracking_stock_qty"/>
                <field name="ps_tracking_has_mrp" optional="hide"/>
                <field name="ps_tracking_unproduced_qty" invisible="not ps_tracking_has_mrp"/>
                <field name="ps_product_structure"/>
                <field name="price_unit"/>
                <field name="price_total"/>
                <field name="currency_id"/>
                <field name="ps_report_note"/>
            </list>
        </field>
    </record>
</odoo>
