<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_finished_pdf" model="ir.actions.report">
        <field name="name">Doanh thu – Số lượng theo thành phẩm xuất bán</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_sale_report.sale_finished_pdf</field>
        <field name="report_file">ps_sale_report.sale_finished_pdf</field>
        <field name="paperformat_id" ref="ps_sale_report.paperformat_sale_history"/>
        <field name="print_report_name">'Doanh_thu_SL_thanh_pham_xuat_ban_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
    <template id="sale_finished_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="font-family:'Times New Roman','DejaVu Serif',serif;text-align:center;font-size:8pt">Trang <span class="page"/> / <span class="topage"/></div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_report.sale_preview_styles"/>
                    <style>
                        .ps-finished {font-family:'Times New Roman','Nimbus Roman','DejaVu Serif',serif;font-size:9pt;page-break-after:always;color:#111;}
                        .ps-finished:last-child {page-break-after:auto;}
                        .ps-finished h1 {text-align:center;font-size:18px;font-weight:bold;margin:8px 0;}
                        .ps-finished .subtitle {text-align:center;font-weight:bold;margin-bottom:8px;}
                        .ps-finished .period {text-align:center;font-style:italic;margin-bottom:10px;}
                        .ps-finished .filters {font-size:8pt;margin-bottom:7px;}
                        .ps-finished .unit {text-align:right;font-size:8pt;margin-bottom:5px;}
                        .ps-finished table {width:100%;table-layout:fixed;border-collapse:collapse;font-size:8pt;}
                        .ps-finished th,.ps-finished td {border:1px solid #444;padding:3px;line-height:1.25;word-wrap:break-word;vertical-align:middle;}
                        .ps-finished th {background:#edf1f6;text-align:center;font-weight:bold;}
                        .ps-finished tr {page-break-inside:avoid;}
                        .ps-finished .num {text-align:right;}
                        .ps-finished .center {text-align:center;}
                        .ps-finished .sales {font-weight:bold;color:#0645AD;}
                        .ps-finished .total {font-weight:bold;background:#edf1f6;}
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-contract ps-finished">
                            <div class="company"><strong t-out="wizard.company_id.name"/></div>
                            <h1>BÁO CÁO DOANH THU – SỐ LƯỢNG XUẤT BÁN</h1>
                            <div class="subtitle">(Thành phẩm)</div>
                            <div class="period">Từ ngày <t t-out="format_date(wizard.date_from)"/> đến ngày <t t-out="format_date(wizard.date_to)"/></div>
                            <div class="filters" t-if="report['sales_filter'] or report['product_filter']">
                                <span t-if="report['sales_filter']">Sales: <t t-out="report['sales_filter']"/>. </span>
                                <span t-if="report['product_filter']">Sản phẩm: <t t-out="report['product_filter']"/></span>
                            </div>
                            <div class="unit">ĐVT tiền: <t t-out="report['currency'].name"/></div>
                            <table>
                                <colgroup><col style="width:4%"/><col style="width:12%"/><col style="width:42%"/><col style="width:13%"/><col style="width:15%"/><col style="width:14%"/></colgroup>
                                <thead><tr><th rowspan="2">STT</th><th rowspan="2">Mã HH</th><th rowspan="2">Tên hàng hóa</th><th colspan="2">Số lượng</th><th rowspan="2">Doanh thu</th></tr><tr><th>M²</th><th>Khác / ĐVT</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="page" t-as="row" t-att-class="row['kind']">
                                        <t t-if="row['kind'] == 'item'"><td class="center" t-out="row['seq']"/><td t-out="row['code'] or '&#160;'"/><td t-out="row['label']"/></t>
                                        <td t-else="" colspan="3"><t t-out="row['label']"/><t t-if="row.get('continued')"> (tiếp)</t></td>
                                        <td class="num"><t t-if="not row.get('continued') and row['m2'] is not None" t-out="format_number(row['m2'])"/></td>
                                        <td class="num"><t t-if="not row.get('continued')"><div t-foreach="row['others']" t-as="other"><t t-out="format_number(other['quantity'])"/> <t t-out="other['uom']"/></div></t></td>
                                        <td class="num"><t t-if="not row.get('continued')" t-out="format_number(row['revenue'], report['currency'].decimal_places)"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <t t-if="page_last" t-call="ps_sale_report.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
