<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_ps_reports"
            model="ir.ui.view">
        <field name="name">sale.order.form.ps.reports</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Thông tin báo cáo"
                      name="ps_report_information">
                    <group>
                        <field name="ps_contract_ref"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_form_ps_history_fields"
            model="ir.ui.view">
        <field name="name">
            sale.order.form.ps.history.fields
        </field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list"
                   position="inside">
                <field name="ps_specification"
                       optional="show"/>
                <field name="ps_requested_receipt_date"
                       optional="hide"/>
                <field name="ps_confirmed_receipt_date"
                       optional="hide"/>
                <field name="ps_production_ref"
                       optional="hide"/>
                <field name="ps_production_number"
                       optional="hide"/>
                <field name="ps_report_note"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
