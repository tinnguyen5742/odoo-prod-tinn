<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_yearly_pdf" model="ir.actions.report">
        <field name="name">Doanh thu trong năm theo KH (xuất bán)</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_sale_report.sale_yearly_pdf</field>
        <field name="report_file">ps_sale_report.sale_yearly_pdf</field>
        <field name="paperformat_id" ref="ps_sale_report.paperformat_sale_history"/>
        <field name="print_report_name">'Doanh_thu_nam_theo_KH_xuat_ban_%s' % object.report_year</field>
    </record>
    <template id="sale_yearly_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="text-align:center;font-size:8pt">Trang <span class="page"/> / <span class="topage"/></div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_report.sale_preview_styles"/>
                    <style>
                        .ps-yearly {font-family:'Times New Roman','Nimbus Roman','DejaVu Serif',serif;font-size:8pt;color:#172536;page-break-after:always;}
                        .ps-yearly:last-child {page-break-after:auto;}
                        .ps-yearly h1 {font-size:18px;text-align:center;font-weight:bold;margin:8px 0;}
                        .ps-yearly .subtitle {font-style:italic;text-align:center;margin-bottom:8px;}
                        .ps-yearly .period {text-align:center;margin-bottom:7px;}
                        .ps-yearly .unit {text-align:right;font-size:7.5pt;margin-bottom:6px;}
                        .ps-yearly .filters {font-size:7pt;margin-bottom:8px;}
                        .ps-yearly table {width:100%;table-layout:fixed;border-collapse:collapse;font-size:7pt;}
                        .ps-yearly th,.ps-yearly td {border:1px solid #444;padding:4px 3px;line-height:1.25;word-wrap:break-word;vertical-align:middle;}
                        .ps-yearly th {background:#edf1f6;text-align:center;font-weight:bold;}
                        .ps-yearly tr {page-break-inside:avoid;}
                        .ps-yearly .num {text-align:right;}
                        .ps-yearly .total {font-weight:bold;background:#edf1f6;}
                        .ps-yearly .signatures {margin-top:18px;}
                        .ps-yearly .department {display:inline-block;width:39%;text-align:center;font-weight:bold;vertical-align:top;}
                        .ps-yearly .signature {display:inline-block;width:59%;text-align:right;vertical-align:top;}
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-contract ps-yearly">
                            <div class="company"><strong t-out="wizard.company_id.name"/></div>
                            <h1>BÁO CÁO DOANH THU BÁN HÀNG TRONG NĂM THEO KHÁCH HÀNG</h1>
                            <div class="subtitle">(THEO XUẤT BÁN)</div>
                            <div class="period">Năm: <t t-out="wizard.report_year"/></div>
                            <div class="filters" t-if="report['sales_filter']">Sales: <t t-out="report['sales_filter']"/></div>
                            <div class="unit">ĐVT: <t t-out="report['unit_label']"/></div>
                            <table>
                                <colgroup><col style="width:30%"/><col t-foreach="range(12)" t-as="month" style="width:5%"/><col style="width:10%"/></colgroup>
                                <thead><tr><th>Khách hàng</th><th t-foreach="range(1, 13)" t-as="month">T<t t-out="month"/></th><th>Cả năm</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="page" t-as="item">
                                        <td t-out="item['label']"/>
                                        <td t-foreach="item['months']" t-as="amount" class="num" t-out="format_amount(amount, report) or '&#160;'"/>
                                        <td class="num" t-out="format_amount(item['total'], report)"/>
                                    </tr>
                                    <tr t-if="page_last" class="total">
                                        <td>TỔNG CỘNG</td>
                                        <td t-foreach="report['totals']" t-as="amount" class="num" t-out="format_amount(amount, report) or '&#160;'"/>
                                        <td class="num" t-out="format_amount(report['grand_total'], report)"/>
                                    </tr>
                                </tbody>
                            </table>
                            <t t-if="page_last" t-call="ps_sale_report.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
