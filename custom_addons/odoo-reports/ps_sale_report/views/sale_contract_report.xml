<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_contract_pdf" model="ir.actions.report">
        <field name="name">Tình hình thực hiện hợp đồng</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_sale_report.sale_contract_pdf</field>
        <field name="report_file">ps_sale_report.sale_contract_pdf</field>
        <field name="paperformat_id" ref="paperformat_sale_history"/>
        <field name="print_report_name">'Tinh_hinh_thuc_hien_hop_dong_%s_%s' % (object.date_from, object.date_to)</field>
    </record>

    <template id="sale_contract_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="font-family: 'Times New Roman', 'Nimbus Roman', 'DejaVu Serif', serif; font-size: 8pt; text-align: center;">
                Trang <span class="page"/> / <span class="topage"/>
            </div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_report.sale_preview_styles"/>
                    <style>
                        .ps-contract { font-family: 'Times New Roman', 'Nimbus Roman', 'DejaVu Serif', serif; font-size: 8pt; color: #111; padding-top: 2mm; page-break-after: always; }
                        .ps-contract:last-child { page-break-after: auto; }
                        .ps-contract .company { font-size: 8pt; font-weight: bold; }
                        .ps-contract h1 { text-align: center; font-size: 18px; font-weight: bold; margin: 8px 0; }
                        .ps-contract .period { text-align: center; margin-bottom: 8px; }
                        .ps-contract .filters { margin: 4px 0 8px; font-size: 7pt; }
                        .ps-contract table { width: 100%; border-collapse: collapse; table-layout: fixed; empty-cells: show; font-size: 7.5pt; }
                        .ps-contract th, .ps-contract td { padding: 4px 3px; line-height: 1.25; vertical-align: middle; border: 1px solid #333; word-wrap: break-word; overflow-wrap: break-word; }
                        .ps-contract th { text-align: center; font-weight: bold; background: #f2f2f2; }
                        .ps-contract tr { page-break-inside: avoid; }
                        .ps-contract .detail td { border-bottom: 1px solid #333; }
                        .ps-contract .customer { color: #0645ad; font-weight: bold; }
                        .ps-contract .order { color: #a51c30; font-weight: bold; }
                        .ps-contract .num { text-align: right; }
                        .ps-contract .center { text-align: center; }
                        .ps-contract .note { font-size: 6.5pt; margin-top: 7px; }
                        .ps-contract .signature { text-align: right; font-size: 7pt; margin-top: 6px; }
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-contract">
                            <div class="company" t-out="wizard.company_id.name"/>
                            <h1>BÁO CÁO TÌNH HÌNH THỰC HIỆN ĐƠN HÀNG</h1>
                            <div class="period">Từ ngày <t t-out="format_date(wizard.date_from)"/> đến ngày <t t-out="format_date(wizard.date_to)"/></div>
                            <div class="filters" t-if="report['filters']" t-out="report['filters']"/>
                            <table>
                                <colgroup>
                                    <col style="width:3%"/><col style="width:27%"/><col style="width:4%"/>
                                    <col style="width:5%"/><col style="width:6%"/><col style="width:7%"/>
                                    <col style="width:10%"/><col style="width:8%"/><col style="width:6%"/>
                                    <col style="width:10%"/><col style="width:8%"/><col style="width:6%"/>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th rowspan="2">STT</th><th rowspan="2">Mặt hàng</th><th rowspan="2">ĐVT</th><th rowspan="2">Loại tiền</th>
                                        <th colspan="4">Đơn hàng</th><th colspan="3">Thực hiện</th><th rowspan="2">Còn lại</th>
                                    </tr>
                                    <tr><th>Số lượng</th><th>Đơn giá</th><th>Trị giá</th><th>Ngày giao</th><th>Số lượng</th><th>Trị giá</th><th>Ngày giao</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="page['sections']" t-as="section">
                                        <tr t-if="section['show_partner']" class="customer"><td colspan="12" t-out="section['partner_label']"/></tr>
                                        <tr class="order">
                                            <td colspan="6">
                                                Số SO: <t t-out="section['order'].name"/>
                                                <t t-if="section['order'].ps_contract_ref"> | Hợp đồng: <t t-out="section['order'].ps_contract_ref"/></t>
                                                | <t t-out="section['currency'].name"/>
                                                <t t-if="section['continued']"> (tiếp)</t>
                                            </td>
                                            <td class="num" t-out="format_number(section['ordered_total']) if not section['continued'] else '&#160;'"/>
                                            <td>&#160;</td><td>&#160;</td>
                                            <td class="num" t-out="format_number(section['delivered_total']) if not section['continued'] else '&#160;'"/>
                                            <td>&#160;</td><td>&#160;</td>
                                        </tr>
                                        <tr t-foreach="section['rows']" t-as="item" class="detail">
                                            <td class="center" t-out="item['seq']"/>
                                            <td t-out="item['product']"/>
                                            <td class="center" t-out="item['uom']"/>
                                            <td class="center" t-out="item['currency']"/>
                                            <td class="num" t-out="format_number(item['ordered_qty'])"/>
                                            <td class="num" t-out="format_number(item['unit_price'])"/>
                                            <td class="num" t-out="format_number(item['ordered_value'])"/>
                                            <td class="center" t-out="format_date(item['promised_date']) or '&#160;'"/>
                                            <td class="num" t-out="format_number(item['delivered_qty'])"/>
                                            <td class="num" t-out="format_number(item['delivered_value'])"/>
                                            <td class="center" t-out="format_date(item['delivery_date']) or '&#160;'"/>
                                            <td class="num" t-out="format_number(item['remaining_qty'])"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div t-if="page_last" class="note">Ngày lọc là ngày SO. Thực hiện lũy kế đến ngày kết thúc. Trị giá gồm thuế, sau chiết khấu; trị giá thực hiện quy đổi theo giá SO.</div>
                            <t t-if="page_last" t-call="ps_sale_report.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
