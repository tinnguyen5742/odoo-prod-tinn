<odoo>
    <record id="action_sale_credit_terms_pdf" model="ir.actions.report">
        <field name="name">Bảng kê thời hạn công nợ bán ra</field><field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">ps_sale_report.sale_credit_terms_pdf</field>
        <field name="report_file">ps_sale_report.sale_credit_terms_pdf</field>
        <field name="paperformat_id" ref="ps_sale_report.paperformat_sale_history"/>
        <field name="print_report_name">'Thoi_han_cong_no_ban_ra_%s' % object.report_date</field>
    </record>
    <template id="sale_credit_terms_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="text-align:center;font-size:8pt">Trang <span class="page"/> / <span class="topage"/></div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_report.sale_preview_styles"/>
                    <style>
                        .ps-credit-terms {font-family:'Times New Roman','Nimbus Roman','DejaVu Serif',serif;font-size:8pt;page-break-after:always;}
                        .ps-credit-terms:last-child {page-break-after:auto;}
                        .ps-credit-terms h1 {text-align:center;font-size:18px;font-weight:bold;margin:8px 0;}
                        .ps-credit-terms .period {text-align:center;margin-bottom:12px;}
                        .ps-credit-terms table {width:100%;border-collapse:collapse;table-layout:fixed;font-size:8pt;}
                        .ps-credit-terms th,.ps-credit-terms td {border:1px solid #444;padding:4px 3px;line-height:1.25;word-wrap:break-word;vertical-align:middle;}
                        .ps-credit-terms th {text-align:center;background:#edf1f6;font-weight:bold;}
                        .ps-credit-terms tr {page-break-inside:avoid;}
                        .ps-credit-terms .num {text-align:right;}
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-contract ps-credit-terms">
                            <div class="company"><strong t-out="wizard.company_id.name"/></div>
                            <h1>BẢNG KÊ THỜI HẠN CÔNG NỢ BÁN RA</h1>
                            <div class="period">Ngày lập: <t t-out="format_date(wizard.report_date)"/> | ĐVT tiền: <t t-out="report['currency'].name"/></div>
                            <table>
                                <colgroup><col style="width:4%"/><col style="width:11%"/><col style="width:31%"/><col style="width:23%"/><col style="width:14%"/><col style="width:17%"/></colgroup>
                                <thead><tr><th t-foreach="report['columns']" t-as="column" t-out="column[0]"/></tr></thead>
                                <tbody><tr t-foreach="page" t-as="row">
                                    <td t-foreach="row" t-as="value" t-att-class="'num' if value_index == 4 else ''">
                                        <t t-if="value_index == 4" t-out="format_limit(value, report['currency'])"/>
                                        <span t-else="" style="white-space:pre-line" t-out="value"/>
                                    </td>
                                </tr></tbody>
                            </table>
                            <t t-if="page_last" t-call="ps_sale_report.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
