<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_ps_execution" model="ir.ui.view">
        <field name="name">stock.picking.form.ps.execution</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list" position="inside">
                <field name="ps_execution_request_ref" optional="show" readonly="state in ('done', 'cancel')"/>
                <field name="ps_execution_request_qty" optional="show" readonly="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
