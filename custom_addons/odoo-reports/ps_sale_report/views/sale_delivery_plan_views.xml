<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PHẦN 15: Kế hoạch giao hàng và liên kết đợt giao trên phiếu kho. -->
    <record id="view_order_form_delivery_plan" model="ir.ui.view">
        <field name="name">sale.order.form.delivery.plan</field><field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Kế hoạch giao hàng" name="ps_delivery_plans" groups="sales_team.group_sale_salesman">
                    <field name="ps_delivery_plan_ids" readonly="state != 'sale'">
                        <list>
                            <field name="sale_line_id" domain="[('order_id', '=', parent.id), ('display_type', '=', False), ('product_id.type', '=', 'consu')]" options="{'no_create': True}"/>
                            <field name="planned_datetime"/><field name="planned_qty"/><field name="uom_id"/>
                            <field name="workshop"/><field name="route"/><field name="vehicle"/><field name="state"/>
                        </list>
                        <form string="Đợt giao hàng">
                            <group><group>
                                <field name="company_id" invisible="True"/>
                                <field name="sale_line_id" domain="[('order_id', '=', parent.id), ('display_type', '=', False), ('product_id.type', '=', 'consu')]" options="{'no_create': True}"/>
                                <field name="planned_datetime"/><field name="planned_qty"/><field name="uom_id"/>
                                <field name="state"/>
                            </group><group><field name="workshop"/><field name="route"/><field name="vehicle"/><field name="address"/><field name="note"/></group></group>
                            <field name="move_ids" readonly="True">
                                <list create="False" delete="False"><field name="picking_id"/><field name="product_id"/><field name="product_uom_qty"/><field name="quantity"/><field name="product_uom"/><field name="state"/></list>
                            </field>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_picking_form_delivery_plan" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.plan</field><field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list" position="inside">
                <field name="sale_line_id" column_invisible="True"/>
                <field name="ps_delivery_plan_id" optional="show" readonly="state in ('done', 'cancel')" domain="[('sale_line_id', '=', sale_line_id), ('state', '!=', 'cancel')]" options="{'no_create': True}" groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

    <!-- PHẦN 17: Vận chuyển; gộp từ sale_transport_views.xml.
         Giữ view kế thừa và external ID để không đổi giao diện khi nâng cấp. -->
    <record id="view_order_form_transport" model="ir.ui.view">
        <field name="name">sale.order.form.transport</field><field name="model">sale.order</field>
        <field name="inherit_id" ref="ps_sale_report.view_order_form_delivery_plan"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ps_delivery_plan_ids']/list" position="inside">
                <field name="transport_owner_id" optional="show"/>
                <field name="transport_reference" optional="hide"/>
                <field name="transport_currency_id" column_invisible="True"/>
                <field name="transport_amount" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='ps_delivery_plan_ids']/form/field[@name='move_ids']" position="before">
                <group string="Thông tin vận chuyển">
                    <group>
                        <field name="transport_owner_id"/>
                        <field name="transport_reference"/>
                        <field name="transport_receiving_name"/>
                        <field name="transport_weight"/>
                        <field name="transport_packages"/>
                    </group>
                    <group>
                        <field name="transport_currency_id" invisible="True"/>
                        <field name="transport_charge_basis"/>
                        <field name="transport_manual_quantity" invisible="transport_charge_basis != 'manual'"/>
                        <field name="transport_manual_unit" invisible="transport_charge_basis != 'manual'" required="transport_charge_basis == 'manual'"/>
                        <field name="transport_charge_quantity"/>
                        <field name="transport_charge_unit"/>
                        <field name="transport_unit_price"/>
                        <field name="transport_transfer_fee"/>
                        <field name="transport_other_fee"/>
                        <field name="transport_amount"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
