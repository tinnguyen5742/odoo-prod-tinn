<odoo>
    <record id="action_sale_delivery_pdf" model="ir.actions.report">
        <field name="name">Kế hoạch giao hàng</field><field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">ps_sale_report.sale_delivery_pdf</field>
        <field name="report_file">ps_sale_report.sale_delivery_pdf</field>
        <field name="paperformat_id" ref="ps_sale_report.paperformat_sale_history"/>
        <field name="print_report_name">'Ke_hoach_giao_hang_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
    <template id="sale_delivery_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="text-align:center;font-size:8pt">Trang <span class="page"/> / <span class="topage"/></div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_report.sale_preview_styles"/>
                    <style>
                        .ps-delivery {font-family:'Times New Roman','Nimbus Roman','DejaVu Serif',serif;font-size:7pt;page-break-after:always;}
                        .ps-delivery:last-child {page-break-after:auto;}
                        .ps-delivery h1 {text-align:center;font-size:18px;font-weight:bold;margin:8px 0;}
                        .ps-delivery .period {text-align:center;margin-bottom:12px;}
                        .ps-delivery table {width:100%;border-collapse:collapse;table-layout:fixed;font-size:6.5pt;}
                        .ps-delivery th,.ps-delivery td {border:1px solid #444;padding:3px 2px;line-height:1.2;word-wrap:break-word;vertical-align:middle;}
                        .ps-delivery th {text-align:center;background:#edf1f6;}
                        .ps-delivery tr {page-break-inside:avoid;}
                        .ps-delivery .num {text-align:right;}
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-contract ps-delivery">
                            <div class="company"><strong t-out="wizard.company_id.name"/></div>
                            <h1>DỰ KIẾN KẾ HOẠCH GIAO HÀNG</h1>
                            <div class="period">Từ ngày <t t-out="format_date(wizard.date_from)"/> đến ngày <t t-out="format_date(wizard.date_to)"/></div>
                            <table>
                                <colgroup><col style="width:6%"/><col style="width:9%"/><col style="width:12%"/><col style="width:4%"/>
                                    <col style="width:4.5%"/><col style="width:4.5%"/><col style="width:4.5%"/><col style="width:4.5%"/><col style="width:4.5%"/>
                                    <col style="width:5%"/><col style="width:5%"/><col style="width:5%"/><col style="width:6%"/><col style="width:5.5%"/><col style="width:4%"/><col style="width:9%"/><col style="width:7%"/></colgroup>
                                <thead><tr>
                                    <th t-foreach="report['columns'][:4]" t-as="column" rowspan="2" t-out="column[0]"/>
                                    <th colspan="5">Số lượng</th>
                                    <th t-foreach="report['columns'][9:12]" t-as="column" rowspan="2" t-out="column[0]"/>
                                    <th colspan="3">Thời gian giao hàng</th><th rowspan="2">Địa chỉ</th><th rowspan="2">Ghi chú</th>
                                </tr><tr>
                                    <th t-foreach="report['columns'][4:9]" t-as="column" t-out="column[0]"/>
                                    <th t-foreach="report['columns'][12:15]" t-as="column" t-out="column[0]"/>
                                </tr></thead>
                                <tbody><tr t-foreach="page" t-as="row">
                                    <td t-foreach="row" t-as="value" t-att-class="'num' if report['columns'][value_index][1] == 'number' else ''">
                                        <t t-if="report['columns'][value_index][1] == 'number'" t-out="format_number(value)"/>
                                        <t t-elif="report['columns'][value_index][1] == 'date'" t-out="format_date(value)"/>
                                        <t t-else="" t-out="value"/>
                                    </td>
                                </tr></tbody>
                            </table>
                            <t t-if="page_last" t-call="ps_sale_report.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
