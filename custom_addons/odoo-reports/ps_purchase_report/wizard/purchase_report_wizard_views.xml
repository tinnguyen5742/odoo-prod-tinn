<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_report_wizard_form" model="ir.ui.view">
        <field name="name">purchase.report.wizard.form</field>
        <field name="model">purchase.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Hệ thống báo cáo Mua hàng">
                <sheet>
                    <!-- Tiêu đề hướng dẫn -->
                    <div class="alert alert-info" role="alert" style="margin-bottom: 15px;">
                        <strong>Hướng dẫn:</strong> Chọn loại báo cáo, phong cách hiển thị và khoảng thời gian mong muốn trước khi xem trước hoặc xuất dữ liệu.
                    </div>

                    <group>
                        <!-- Cột bên trái: Lựa chọn loại báo cáo và phong cách trình bày -->
                        <group string="Cấu hình Báo cáo">
                            <field name="report_type" options="{'no_create': True, 'no_open': True}"/>
                            <field name="report_style" widget="radio" options="{'horizontal': false}"/>
                        </group>

                        <!-- Cột bên phải: Bộ lọc dữ liệu -->
                        <group string="Bộ lọc dữ liệu">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="product_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Xem trước (PDF)" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_excel" string="Xuất Excel" type="object" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button string="Thoát" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action để gọi cửa sổ Wizard này từ Menu -->
    <record id="action_purchase_report_wizard" model="ir.actions.act_window">
        <field name="name">Hệ thống báo cáo Mua hàng</field>
        <field name="res_model">purchase.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Thêm Menu vào phân hệ Purchase -->
    <menuitem id="menu_custom_purchase_reports"
              name="Báo cáo Custom"
              parent="purchase.menu_purchase_root"
              sequence="50"/>

    <menuitem id="menu_purchase_report_wizard"
              name="Hệ thống báo cáo"
              parent="menu_custom_purchase_reports"
              action="action_purchase_report_wizard"
              sequence="10"/>
</odoo>