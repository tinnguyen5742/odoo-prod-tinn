<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Khổ A4 Ngang để chứa đủ 12 cột thông tin -->
    <record id="paperformat_landscape_report_4" model="report.paperformat">
        <field name="name">Khổ A4 Ngang - Tình hình thực hiện PO</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
    </record>

    <!-- Action báo cáo -->
    <record id="action_report_purchase_execution" model="ir.actions.report">
        <field name="name">Bảng Kê Tình Hình Thực Hiện Đơn Hàng</field>
        <field name="model">purchase.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">ps_purchase_report.report_purchase_execution_template</field>
        <field name="report_file">ps_purchase_report.report_purchase_execution_template</field>
        <field name="paperformat_id" ref="ps_purchase_report.paperformat_landscape_report_4"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_purchase_execution_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="ps_purchase_report.report_purchase_shared_styles"/>
                <div class="page">
                    <!-- Tên Công ty -->
                    <div class="company-title">
                        <t t-esc="company.name"/>
                    </div>

                    <!-- Tiêu đề Báo cáo -->
                    <div class="report-title">
                        BÁO CÁO TÌNH HÌNH THỰC HIỆN ĐƠN HÀNG
                    </div>
                    <div class="report-date">
                        <i>Từ ngày <t t-esc="date_from"/> đến ngày <t t-esc="date_to"/></i>
                    </div>

                    <!-- Bảng dữ liệu chuẩn 12 cột -->
                    <table class="tbl-exec">
                        <thead>
                            <tr>
                                <th rowspan="2" style="width: 4%;">ST</th>
                                <th rowspan="2" style="width: 22%;">Tên Sản Phẩm</th>
                                <th rowspan="2" style="width: 6%;">ĐVT</th>
                                <th rowspan="2" style="width: 5%;">Loại tiền</th>
                                <th colspan="4" style="width: 30%;">Đơn hàng</th>
                                <th colspan="3" style="width: 23%;">Thực hiện</th>
                                <th rowspan="2" style="width: 10%;">SL Còn lại</th>
                            </tr>
                            <tr>
                                <th style="width: 7%;">Số lượng</th>
                                <th style="width: 7%;">Đơn giá</th>
                                <th style="width: 8%;">Trị giá</th>
                                <th style="width: 8%;">Ngày giao</th>
                                <th style="width: 7%;">Số lượng</th>
                                <th style="width: 8%;">Trị giá</th>
                                <th style="width: 8%;">Ngày giao</th>
                            </tr>
                            <!-- Dòng đánh số thứ tự cột từ 1 đến 12 -->
                            <tr style="background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                <t t-foreach="range(1, 13)" t-as="i">
                                    <td><t t-esc="i"/></td>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Vòng lặp gom nhóm theo Nhà cung cấp -->
                            <t t-foreach="lines.mapped('order_id.partner_id')" t-as="vendor">
                                <tr class="vendor-row">
                                    <td colspan="12">
                                        Tên khách hàng: <t t-esc="vendor.name.upper() if vendor.name else 'KHÁCH LẺ'"/>
                                    </td>
                                </tr>

                                <!-- Vòng lặp theo các đơn PO của nhà cung cấp đó -->
                                <t t-foreach="lines.mapped('order_id').filtered(lambda o: o.partner_id == vendor)" t-as="po">
                                    <t t-set="po_lines" t-value="lines.filtered(lambda l: l.order_id == po)"/>
                                    <t t-set="po_total_ordered" t-value="sum(po_lines.mapped('price_subtotal'))"/>
                                    <t t-set="po_total_received" t-value="sum(l.qty_received * l.price_unit for l in po_lines)"/>

                                    <tr class="po-row">
                                        <td colspan="6" style="padding-left: 15px;">
                                            Số hợp đồng: — Số PO: <span style="color: #c00000;"><t t-esc="po.name"/></span>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="po_total_ordered" t-options='{"widget": "float", "precision": 0}'/>
                                        </td>
                                        <td colspan="3" class="text-end">
                                            <t t-esc="po_total_received" t-options='{"widget": "float", "precision": 0}'/>
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>

                                    <!-- Chi tiết các dòng sản phẩm trong PO -->
                                    <t t-set="stt" t-value="1"/>
                                    <t t-foreach="po_lines" t-as="line">
                                        <t t-set="qty_ordered" t-value="line.product_qty"/>
                                        <t t-set="qty_received" t-value="line.qty_received"/>
                                        <t t-set="qty_remaining" t-value="qty_ordered - qty_received"/>
                                        <t t-set="amount_ordered" t-value="line.price_subtotal"/>
                                        <t t-set="amount_received" t-value="qty_received * line.price_unit"/>

                                        <tr>
                                            <td class="text-center"><t t-esc="stt"/></td>
                                            <td><t t-esc="line.name"/></td>
                                            <td class="text-center"><t t-esc="line.product_uom_id.name or ''"/></td>
                                            <td class="text-center"><t t-esc="po.currency_id.name or 'VND'"/></td>
                                            <td class="text-end"><t t-esc="qty_ordered" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="text-end"><t t-esc="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="text-end"><t t-esc="amount_ordered" t-options='{"widget": "float", "precision": 0}'/></td>
                                            <td class="text-center"><t t-esc="line.date_planned.strftime('%d/%m/%Y') if line.date_planned else ''"/></td>
                                            <td class="text-end"><t t-esc="qty_received" t-options='{"widget": "float", "precision": 2}'/></td>
                                            <td class="text-end"><t t-esc="amount_received" t-options='{"widget": "float", "precision": 0}'/></td>
                                            <td class="text-center"><t t-esc="po.date_approve.strftime('%d/%m/%Y') if po.date_approve else ''"/></td>
                                            <td class="text-end" style="color: #c00000; font-weight: bold;"><t t-esc="qty_remaining" t-options='{"widget": "float", "precision": 2}'/></td>
                                        </tr>
                                        <t t-set="stt" t-value="stt + 1"/>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Chữ ký người lập -->
                    <div class="row mt-4" style="page-break-inside: avoid; font-family: 'Times New Roman', serif;">
                        <div class="col-8"></div>
                        <div class="col-4 text-center">
                            <i>Ngày ..... tháng ..... năm .....</i><br/>
                            <strong>Người lập</strong><br/><br/><br/>
                            <span>Administrator</span>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>