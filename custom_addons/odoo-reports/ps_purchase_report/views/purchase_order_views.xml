<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_19" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.19</field>
        <field name="model">purchase.order</field>
        <!-- Tham chiếu chính xác đến ID view gốc của Odoo 19.0 -->
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Dùng XPath để tìm trường date_order, sau đó chèn 2 trường mới vào SAU nó -->
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="x_is_urgent" widget="boolean_toggle"/>
                <field name="x_ly_do_mua_hang" invisible="not x_is_urgent"/>
            </xpath>

            <!-- Ví dụ: Chỉnh sửa trạng thái (statusbar) bằng XPath -->
            <!-- Giả sử bạn muốn thêm 1 nút (button) vào thanh header -->
            <!-- <xpath expr="//header" position="inside">
                <button name="action_custom_check" string="Kiểm tra nội bộ" type="object" class="oe_highlight"/>
            </xpath> -->

        </field>
    </record>
</odoo>