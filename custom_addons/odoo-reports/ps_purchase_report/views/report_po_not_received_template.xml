<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_po_not_received_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="ps_purchase_report.report_purchase_shared_styles"/>
                <div class="page">
                    <h2 class="text-center">BÁO CÁO THỐNG KÊ PO CHƯA NHẬN HÀNG</h2>
                    <p class="text-center">Từ ngày đến ngày <t t-esc="date_to"/></p>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã hàng</th>
                                <th>Tên hàng</th>
                                <th>ĐVT</th>
                                <th>Số lượng chưa nhận</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="grouped_data.keys()" t-as="po">
                                <!-- Dòng in đậm tiêu đề PO -->
                                <tr class="bg-light font-weight-bold text-danger">
                                    <td colspan="5">
                                        Số PO: <t t-esc="po.name"/> - <t t-esc="po.date_approve.strftime('%d/%m/%Y') if po.date_approve else ''"/>
                                    </td>
                                </tr>
                                <!-- Lặp qua các dòng chi tiết của PO đó -->
                                <t t-set="stt" t-value="1"/>
                                <t t-foreach="grouped_data[po]" t-as="line">
                                    <tr>
                                        <td><t t-esc="stt"/></td>
                                        <td><t t-esc="line.product_id.default_code"/></td>
                                        <td><t t-esc="line.product_id.name"/></td>
                                        <td><t t-esc="line.product_uom.name"/></td>
                                        <td><t t-esc="line.product_qty - line.qty_received"/></td>
                                    </tr>
                                    <t t-set="stt" t-value="stt + 1"/>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    
                    <div class="row mt32">
                        <div class="col-8"></div>
                        <div class="col-4 text-center">
                            <p>Ngày ..... tháng ..... năm .....</p>
                            <strong>NGƯỜI LẬP</strong>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>