<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Khổ A4 Dọc -->
    <record id="paperformat_portrait_report_6" model="report.paperformat">
        <field name="name">Khổ A4 Dọc - PO chưa nhận hàng</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
    </record>

    <!-- Action báo cáo -->
    <record id="action_report_unreceived_po" model="ir.actions.report">
        <field name="name">Báo Cáo Thống Kê PO Chưa Nhận Hàng</field>
        <field name="model">purchase.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">ps_purchase_report.report_unreceived_po_template</field>
        <field name="report_file">ps_purchase_report.report_unreceived_po_template</field>
        <field name="paperformat_id" ref="ps_purchase_report.paperformat_portrait_report_6"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_unreceived_po_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="ps_purchase_report.report_purchase_shared_styles"/>
                <div class="page">
                    <!-- Tên Công ty -->
                    <div class="company-title">
                        <t t-esc="company.name"/>
                    </div>

                    <!-- Tiêu đề Báo cáo -->
                    <div class="report-title">
                        BÁO CÁO THỐNG KÊ PO CHƯA NHẬN HÀNG
                    </div>
                    <div class="report-date">
                        <i>Từ ngày <t t-esc="date_from or ''"/> đến ngày <t t-esc="date_to or ''"/></i>
                    </div>

                    <!-- Bảng dữ liệu chuẩn mẫu -->
                    <table class="tbl-unrec">
                        <thead>
                            <tr>
                                <th style="width: 7%;">STT</th>
                                <th style="width: 15%;">Mã hàng</th>
                                <th style="width: 43%;">Tên Hàng</th>
                                <th style="width: 10%;">ĐVT</th>
                                <th style="width: 12%;">Số lượng</th>
                                <th style="width: 13%;">Ngày Cần</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="global_stt" t-value="1"/>

                            <!-- Gom nhóm theo Nhà cung cấp -->
                            <t t-foreach="orders.mapped('partner_id')" t-as="vendor">
                                <tr class="vendor-row">
                                    <td colspan="6" style="padding-left: 10px;">
                                        <t t-esc="vendor.ref or 'NCC'"/> - <t t-esc="vendor.name"/>
                                    </td>
                                </tr>

                                <!-- Gom nhóm theo từng Đơn hàng (PO) của NCC đó -->
                                <t t-foreach="orders.filtered(lambda o: o.partner_id == vendor)" t-as="po">
                                    <tr class="po-row">
                                        <td colspan="6" style="padding-left: 20px;">
                                            Số PO : <t t-esc="po.name"/> - <t t-esc="po.date_order.strftime('%d/%m/%Y') if po.date_order else ''"/>
                                        </td>
                                    </tr>

                                    <!-- Chi tiết các dòng sản phẩm chưa nhận đủ -->
                                    <t t-foreach="po.order_line.filtered(lambda l: l.qty_received &lt; l.product_qty)" t-as="line">
                                        <tr>
                                            <td class="text-center"><t t-esc="global_stt"/></td>
                                            <td class="text-center"><t t-esc="line.product_id.default_code or ''"/></td>
                                            <td><t t-esc="line.name"/></td>
                                            <td class="text-center"><t t-esc="line.product_uom_id.name or ''"/></td>
                                            <td class="text-end">
                                                <t t-esc="line.product_qty - line.qty_received" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-center">
                                                <t t-esc="line.date_planned.strftime('%d/%m/%Y') if line.date_planned else ''"/>
                                            </td>
                                        </tr>
                                        <t t-set="global_stt" t-value="global_stt + 1"/>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Chữ ký -->
                    <div class="row mt-4" style="page-break-inside: avoid; font-family: 'Times New Roman', serif;">
                        <div class="col-8"></div>
                        <div class="col-4 text-center">
                            <i>Ngày ..... tháng ..... năm .....</i><br/>
                            <strong>NGƯỜI LẬP</strong>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>