<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Khổ A4 Dọc -->
    <record id="paperformat_portrait_report_3" model="report.paperformat">
        <field name="name">Khổ A4 Dọc - Báo cáo Nhập Kho PO</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
    </record>

    <!-- Action báo cáo -->
    <record id="action_report_purchase_by_po" model="ir.actions.report">
        <field name="name">Bảng Kê Phiếu Nhập Mua Theo PO</field>
        <field name="model">purchase.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">ps_purchase_report.report_purchase_by_po_template</field>
        <field name="report_file">ps_purchase_report.report_purchase_by_po_template</field>
        <field name="paperformat_id" ref="ps_purchase_report.paperformat_portrait_report_3"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_purchase_by_po_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="ps_purchase_report.report_purchase_shared_styles"/>
                <div class="page">
                    <!-- Tên Công ty -->
                    <div class="company-title">
                        <t t-esc="company.name"/>
                    </div>

                    <!-- Tiêu đề -->
                    <div class="report-title">
                        BÁO CÁO NHẬP KHO THEO PN - PO
                    </div>
                    <div class="report-date">
                        <i>Từ ngày <t t-esc="date_from"/> đến ngày <t t-esc="date_to"/></i>
                    </div>

                    <!-- Bảng dữ liệu chuẩn mẫu -->
                    <table class="tbl-po">
                        <thead>
                            <tr>
                                <th style="width: 6%;">STT</th>
                                <th style="width: 14%;">Mã hàng</th>
                                <th style="width: 28%;">Tên hàng hóa</th>
                                <th style="width: 7%;">ĐVT</th>
                                <th style="width: 8%;">Loại tiền</th>
                                <th style="width: 10%;">Số lượng</th>
                                <th style="width: 13%;">Đơn giá</th>
                                <th style="width: 14%;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dòng số thứ tự chú thích cột chuẩn -->
                            <tr style="background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                <td>1</td>
                                <td>2</td>
                                <td>3</td>
                                <td>4</td>
                                <td>5</td>
                                <td>6</td>
                                <td>7</td>
                                <td>8</td>
                            </tr>

                            <t t-set="grand_total" t-value="0"/>

                            <!-- Gom nhóm theo Nhà cung cấp -->
                            <t t-foreach="orders.mapped('partner_id')" t-as="vendor">
                                <!-- Dòng 1: Tên Nhà Cung Cấp -->
                                <tr class="vendor-row">
                                    <td colspan="8">
                                        <t t-esc="vendor.name.upper() if vendor.name else 'KHÁCH LẺ'"/>
                                    </td>
                                </tr>

                                <!-- Lấy các đơn hàng PO của nhà cung cấp này -->
                                <t t-foreach="orders.filtered(lambda o: o.partner_id == vendor)" t-as="po">
                                    <!-- Dòng 2: Thông tin PO và Tổng tiền PO -->
                                    <tr class="po-info-row">
                                        <td colspan="5" style="padding-left: 10px;">
                                            <span style="color: #c00000;">Số PO: <t t-esc="po.name"/></span> - 
                                            Ngày: <t t-esc="po.date_order.strftime('%d/%m/%Y') if po.date_order else ''"/>
                                        </td>
                                        <td colspan="3" class="text-end" style="padding-right: 10px;">
                                            <t t-esc="po.amount_total" t-options='{"widget": "float", "precision": 0}'/>
                                        </td>
                                    </tr>

                                    <!-- Dòng chi tiết sản phẩm trong PO -->
                                    <t t-set="stt_line" t-value="1"/>
                                    <t t-foreach="po.order_line" t-as="line">
                                        <tr>
                                            <td class="text-center"><t t-esc="stt_line"/></td>
                                            <td class="text-center"><t t-esc="line.product_id.default_code or ''"/></td>
                                            <td><t t-esc="line.name"/></td>
                                            <td class="text-center"><t t-esc="line.product_uom_id.name or ''"/></td>
                                            <td class="text-center"><t t-esc="po.currency_id.name or 'VND'"/></td>
                                            <td class="text-end">
                                                <t t-esc="line.product_qty" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="line.price_subtotal" t-options='{"widget": "float", "precision": 0}'/>
                                            </td>
                                        </tr>
                                        <t t-set="stt_line" t-value="stt_line + 1"/>
                                    </t>
                                </t>
                                <t t-set="grand_total" t-value="grand_total + sum(orders.filtered(lambda o: o.partner_id == vendor).mapped('amount_total'))"/>
                            </t>

                            <!-- Dòng Tổng cộng cuối bảng -->
                            <tr class="tr-total">
                                <td colspan="7" class="text-center">Tổng cộng</td>
                                <td class="text-end">
                                    <t t-esc="grand_total" t-options='{"widget": "float", "precision": 0}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Chữ ký -->
                    <div class="row mt-4" style="page-break-inside: avoid; font-family: 'Times New Roman', serif;">
                        <div class="col-8"></div>
                        <div class="col-4 text-center">
                            <i>Ngày ..... tháng ..... năm .....</i><br/>
                            <strong>Người lập</strong>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>