<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Khai báo Action In PDF cho báo cáo số 2 -->
    <record id="action_report_purchase_by_vendor" model="ir.actions.report">
        <field name="name">Bảng Tổng Hợp Mua Hàng Theo NCC</field>
        <field name="model">purchase.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">custom_purchase.report_purchase_by_vendor_template</field>
        <field name="report_file">custom_purchase.report_purchase_by_vendor_template</field>
    </record>

    <!-- 2. Khung thiết kế bản in HTML/QWeb -->
    <template id="report_purchase_by_vendor_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="custom_purchase.report_purchase_shared_styles"/>
                <div class="page">
                    <!-- Tiêu đề báo cáo -->
                    <div class="text-center mb-4">
                        <h2 style="font-weight: bold;">BẢNG TỔNG HỢP MUA HÀNG THEO NCC</h2>
                        <i>Từ ngày <t t-esc="date_from"/> đến ngày <t t-esc="date_to"/></i>
                    </div>

                    <!-- Bảng dữ liệu -->
                    <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; font-size: 13px;">
                        <thead>
                            <tr class="text-center" style="background-color: #f2f2f2;">
                                <!-- Cố định độ rộng cho từng cột (Tổng = 100%) -->
                                <th style="width: 5%; vertical-align: middle;">STT</th>
                                <th style="width: 15%; vertical-align: middle;">Mã VT</th>
                                <th style="width: 25%; vertical-align: middle;">Tên VT</th>
                                <th style="width: 10%; vertical-align: middle;">ĐVT</th>
                                <th style="width: 15%; vertical-align: middle;">Số Lượng</th>
                                <th style="width: 15%; vertical-align: middle;">Đơn Giá</th>
                                <th style="width: 15%; vertical-align: middle;">Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Vòng lặp 1: Lặp qua từng Nhà cung cấp -->
                            <t t-foreach="grouped_data.keys()" t-as="vendor">
                                <!-- Dòng in đậm tên Nhà cung cấp -->
                                <tr style="background-color: #f8f9fa; font-weight: bold; color: #0056b3;">
                                    <td colspan="4"><t t-esc="vendor.name"/></td>
                                    <td class="text-end">
                                        <t t-esc="grouped_data[vendor]['total_qty']" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td></td>
                                    <td class="text-end">
                                        <t t-esc="grouped_data[vendor]['total_amount']" t-options='{"widget": "monetary", "display_currency": vendor.currency_id or res_company.currency_id}'/>
                                    </td>
                                </tr>

                                <!-- Vòng lặp 2: Lặp qua từng vật tư của Nhà cung cấp đó -->
                                <t t-set="stt" t-value="1"/>
                                <t t-foreach="grouped_data[vendor]['lines']" t-as="line">
                                    <tr>
                                        <td class="text-center"><t t-esc="stt"/></td>
                                        <td><t t-esc="line.product_id.default_code"/></td>
                                        <td><t t-esc="line.name"/></td>
                                        <td class="text-center"><t t-esc="line.product_uom_id.name"/></td>
                                        <td class="text-end"><t t-esc="line.product_qty" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end"><t t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": line.order_id.currency_id}'/></td>
                                        <td class="text-end"><t t-esc="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": line.order_id.currency_id}'/></td>
                                    </tr>
                                    <t t-set="stt" t-value="stt + 1"/>
                                </t>
                                
                                <!-- Dòng Tổng cộng cuối mỗi NCC -->
                                <tr style="font-weight: bold;">
                                    <td colspan="4" class="text-center">Tổng cộng</td>
                                    <td class="text-end">
                                        <t t-esc="grouped_data[vendor]['total_qty']" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td></td>
                                    <td class="text-end">
                                        <t t-esc="grouped_data[vendor]['total_amount']" t-options='{"widget": "monetary", "display_currency": vendor.currency_id or res_company.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Chữ ký chân trang -->
                    <div class="row mt-5" style="page-break-inside: avoid;">
                        <div class="col-6 text-center">
                            <strong>NGƯỜI LẬP</strong>
                        </div>
                        <div class="col-6 text-center">
                            <i>Ngày ..... tháng ..... năm .....</i><br/>
                            <strong>TRƯỞNG PHÒNG MUA HÀNG</strong>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>