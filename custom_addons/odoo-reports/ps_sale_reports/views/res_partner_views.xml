<odoo>
    <record id="view_partner_sale_credit_terms" model="ir.ui.view">
        <field name="name">res.partner.form.sale.credit.terms</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Thông tin công nợ bán ra" groups="account.group_account_invoice,account.group_account_readonly" invisible="parent_id">
                    <field name="currency_id" invisible="True"/>
                    <field name="credit_limit" string="Hạn mức công nợ" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="ps_sale_credit_note" placeholder="Ghi chú áp dụng cho công ty đang chọn"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
