<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales targets -->
    <record id="rule_ps_salesperson_plan_company" model="ir.rule">
        <field name="name">Sales plan: allowed companies</field>
        <field name="model_id"
               ref="model_ps_sale_salesperson_plan"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_ps_salesperson_plan_own" model="ir.rule">
        <field name="name">Sales plan: own plans</field>
        <field name="model_id"
               ref="model_ps_sale_salesperson_plan"/>
        <field name="groups"
               eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">
            [('salesperson_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_ps_salesperson_plan_manager" model="ir.rule">
        <field name="name">Sales plan: manager sees all</field>
        <field name="model_id"
               ref="model_ps_sale_salesperson_plan"/>
        <field name="groups"
               eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Delivery plans -->
    <record id="delivery_plan_company_rule" model="ir.rule">
        <field name="name">Delivery plans: allowed companies</field><field name="model_id" ref="model_ps_sale_delivery_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="delivery_plan_own_rule" model="ir.rule">
        <field name="name">Delivery plans: own orders</field><field name="model_id" ref="model_ps_sale_delivery_plan"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.user_id', '=', False)]</field>
    </record>
    <record id="delivery_plan_all_rule" model="ir.rule">
        <field name="name">Delivery plans: all orders</field><field name="model_id" ref="model_ps_sale_delivery_plan"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
