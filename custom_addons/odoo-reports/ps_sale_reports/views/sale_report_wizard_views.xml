<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_history_wizard_form" model="ir.ui.view">
        <field name="name">ps.sale.history.wizard.form</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Hệ thống báo cáo Bán hàng">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="report_year" invisible="report_type != 'yearly'" options="{'format': False}"/>
                        <field name="yearly_display_unit" invisible="report_type != 'yearly'"/>
                        <field name="tracking_order_id" invisible="report_type not in ('tracking', 'execution', 'request', 'inventory', 'delivery')" domain="[('company_id', '=', company_id)] + ([] if report_type == 'inventory' else [('state', 'in', ['draft', 'sent', 'sale'] if report_type == 'request' else ['sale'])])"/>
                        <field name="tracking_so_prefix" invisible="report_type != 'tracking'"/>
                        <field name="tracking_line_status" invisible="report_type != 'tracking'"/>
                        <field name="transport_owner_id" invisible="report_type != 'transport'"/>
                    </group>
                    <group>
                        <field name="date_from" invisible="report_type in ('yearly', 'credit_terms')"/>
                        <field name="date_to" invisible="report_type in ('yearly', 'credit_terms')"/>
                        <field name="partner_id" invisible="report_type in ('salesperson', 'yearly', 'finished', 'request')"/>
                        <field name="product_id" string="Vật tư / Hàng hóa" invisible="report_type in ('salesperson', 'yearly', 'transport', 'receivable', 'collection', 'credit_terms')"/>
                        <field name="company_id"
                               options="{'no_create': True}"/>
                        <field name="inventory_warehouse_id" invisible="report_type != 'inventory'" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                        <field name="quantity_parent_partner_id" invisible="report_type != 'quantity'"/>
                        <field name="quantity_sales_team_id" invisible="report_type != 'quantity'"/>
                        <field name="region_id" invisible="report_type != 'contract'"/>
                        <field name="salesperson_id" invisible="report_type not in ('contract', 'tracking', 'salesperson', 'yearly', 'daily', 'daily_summary', 'quantity', 'finished')"/>
                        <field name="report_date" invisible="report_type not in ('contract', 'tracking', 'salesperson', 'execution', 'yearly', 'daily', 'daily_summary', 'quantity', 'finished', 'request', 'inventory', 'delivery', 'transport', 'receivable', 'collection', 'credit_terms')"/>
                        <field name="include_quotations"
                               invisible="report_type != 'history'"/>
                    </group>
                </group>
                <footer>
                    <button name="action_preview_pdf"
                            string="Xem"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_export_xlsx"
                            string="Xuất Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Thoát"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Keep existing external IDs during upgrades; all filter attributes now
         belong to the shared form above instead of chained inherited views. -->
    <record id="view_sale_history_wizard_salesperson" model="ir.ui.view">
        <field name="name">ps.sale.history.wizard.salesperson</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="inherit_id" ref="view_sale_history_wizard_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><data/></field>
    </record>
    <record id="view_sale_history_wizard_execution" model="ir.ui.view">
        <field name="name">ps.sale.history.wizard.execution</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="inherit_id" ref="view_sale_history_wizard_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><data/></field>
    </record>

    <record id="action_sale_history_wizard"
            model="ir.actions.act_window">
        <field name="name">Hệ thống báo cáo Bán hàng</field>
        <field name="res_model">ps.sale.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="view_sale_history_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- Reporting now contains the shared Sales wizard. Keep the existing
         standard analytics restricted to Sales managers while Sales users
         retain access to the shared report wizard through its new parent. -->
    <record id="sale.menu_sale_report" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="sale.menu_reporting_sales" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="sale.menu_reporting_salespeople" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="sale.menu_reporting_product" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="sale.menu_reporting_customer" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <menuitem id="menu_ps_sale_reports_root"
              name="Sales Reports"
              parent="sale.menu_sale_report"
              action="action_sale_history_wizard"
              sequence="35"
              groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_ps_sale_history"
              name="Lịch sử đặt hàng"
              parent="menu_ps_sale_reports_root"
              action="action_sale_history_wizard"
              sequence="10"/>

    <record id="menu_ps_sale_history" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
