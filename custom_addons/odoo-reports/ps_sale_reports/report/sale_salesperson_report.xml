<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_salesperson_pdf" model="ir.actions.report">
        <field name="name">Doanh thu - Số lượng theo Sales (SO)</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_sale_reports.sale_salesperson_pdf</field>
        <field name="report_file">ps_sale_reports.sale_salesperson_pdf</field>
        <field name="paperformat_id" ref="ps_sale_reports.paperformat_sale_history"/>
        <field name="print_report_name">'Doanh_thu_Sales_SO_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
    <template id="sale_salesperson_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="text-align:center;font-size:8pt">Trang <span class="page"/> / <span class="topage"/></div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_reports.sale_preview_styles"/>
                    <style>
                        .ps-salesperson {font-family:'Times New Roman','Nimbus Roman','DejaVu Serif',serif;font-size:8pt;page-break-after:always;color:#172536;}
                        .ps-salesperson:last-child {page-break-after:auto;}
                        .ps-salesperson h1 {text-align:center;font-weight:bold;font-size:18px;margin:8px 0;}
                        .ps-salesperson .subtitle,.ps-salesperson .period {text-align:center;margin-bottom:8px;}
                        .ps-salesperson table {width:100%;table-layout:fixed;border-collapse:collapse;font-size:7.5pt;}
                        .ps-salesperson th,.ps-salesperson td {border:1px solid #444;padding:5px 3px;line-height:1.25;word-wrap:break-word;vertical-align:middle;}
                        .ps-salesperson th {background:#edf1f6;text-align:center;}
                        .ps-salesperson tr {page-break-inside:avoid;}
                        .ps-salesperson .num {text-align:right;}
                        .ps-salesperson .total {font-weight:bold;background:#edf1f6;}
                        .ps-salesperson .signature {text-align:right;margin-top:16px;}
                        .ps-salesperson .warning {font-size:7pt;margin-top:10px;color:#73541b;}
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-contract ps-salesperson">
                            <div class="company"><strong t-out="wizard.company_id.name"/></div>
                            <h1>BÁO CÁO SẢN LƯỢNG - DOANH THU NHẬN ĐƠN HÀNG</h1>
                            <div class="subtitle">(NHÂN VIÊN SALE)</div>
                            <div class="period">Từ ngày <t t-out="format_date(wizard.date_from)"/> đến ngày <t t-out="format_date(wizard.date_to)"/> | Loại tiền: <t t-out="report['currency'].name"/></div>
                            <table>
                                <colgroup><col style="width:4%"/><col style="width:7%"/><col style="width:19%"/><col style="width:10%"/><col style="width:11%"/><col style="width:9%"/><col style="width:12%"/><col style="width:11%"/><col style="width:8%"/><col style="width:9%"/></colgroup>
                                <thead><tr><th>STT</th><th>Mã NV</th><th>Tên nhân viên</th><th>SL kế hoạch (M²)</th><th>DT kế hoạch</th><th>SL M²</th><th>SL khác / ĐVT</th><th>Doanh thu</th><th>CL SL (M²)</th><th>CL DT</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="page" t-as="item">
                                        <td t-out="item['seq']"/><td t-out="item['code'] or '&#160;'"/><td t-out="item['salesperson']"/>
                                        <td class="num" t-out="format_number(item['planned_m2']) or '&#160;'"/>
                                        <td class="num" t-out="format_number(item['planned_revenue']) or '&#160;'"/>
                                        <td class="num" t-out="format_number(item['m2'])"/>
                                        <td><div t-foreach="item['others']" t-as="qty"><t t-out="format_number(qty['quantity'])"/> <t t-out="qty['uom']"/></div><t t-if="not item['others']">&#160;</t></td>
                                        <td class="num" t-out="format_number(item['revenue'])"/>
                                        <td class="num" t-out="format_number(item['delta_m2']) or '&#160;'"/>
                                        <td class="num" t-out="format_number(item['delta_revenue']) or '&#160;'"/>
                                    </tr>
                                    <tr class="total" t-if="page_last">
                                        <td colspan="3">Tổng cộng</td>
                                        <td class="num" t-out="format_number(report['totals']['planned_m2']) or '&#160;'"/>
                                        <td class="num" t-out="format_number(report['totals']['planned_revenue']) or '&#160;'"/>
                                        <td class="num" t-out="format_number(report['totals']['m2'])"/>
                                        <td><div t-foreach="report['totals']['others']" t-as="qty"><t t-out="format_number(qty['quantity'])"/> <t t-out="qty['uom']"/></div><t t-if="not report['totals']['others']">&#160;</t></td>
                                        <td class="num" t-out="format_number(report['totals']['revenue'])"/>
                                        <td class="num" t-out="format_number(report['totals']['delta_m2']) or '&#160;'"/>
                                        <td class="num" t-out="format_number(report['totals']['delta_revenue']) or '&#160;'"/>
                                    </tr>
                                </tbody>
                            </table>
                            <t t-if="page_last" t-call="ps_sale_reports.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
