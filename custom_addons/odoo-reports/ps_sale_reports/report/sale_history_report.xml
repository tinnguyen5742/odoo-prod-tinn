<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_sale_history" model="report.paperformat">
        <field name="name">Lịch sử đặt hàng A4 ngang</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_sale_history_pdf" model="ir.actions.report">
        <field name="name">Lịch sử đặt hàng</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_sale_reports.sale_history_pdf</field>
        <field name="report_file">ps_sale_reports.sale_history_pdf</field>
        <field name="paperformat_id" ref="paperformat_sale_history"/>
        <field name="print_report_name">'Lich_su_dat_hang_%s_%s' % (object.date_from, object.date_to)</field>
    </record>

    <template id="sale_report_signature">
        <div class="ps-report-signature" style="margin-top:18px;width:100%;page-break-inside:avoid;color:#172536;font-size:9pt;line-height:1.6;">
            <div style="display:inline-block;width:33%;text-align:center;vertical-align:top;padding-top:10px;"><strong t-out="wizard._signature_department()"/></div>
            <div style="display:inline-block;width:33%;margin-left:33%;text-align:center;vertical-align:top;">
                <div style="font-style:italic;" t-out="wizard._signature_date_text()"/>
                <div><strong>Người lập</strong></div>
            </div>
        </div>
    </template>

    <template id="sale_preview_styles">
        <style>
            /* STYLE CHUNG CHO 17 BÁO CÁO (HTML/PDF).
               Chỉ thống nhất hình thức; giữ cỡ chữ bảng, độ rộng cột và
               phân trang riêng của từng mẫu để bảng nhiều cột vẫn vừa A4. */
            .article, .footer {
                font-family: 'Times New Roman', 'Nimbus Roman', 'DejaVu Serif', serif;
            }
            .page.ps-report {
                font-family: 'Times New Roman', 'Nimbus Roman', 'DejaVu Serif', serif;
                font-size: 8pt; color: #263243;
            }
            .page.ps-report .company { font-size: 8pt; font-weight: bold; margin: 0 0 8px; }
            .page.ps-report h1 { text-align: center; font-size: 18px; font-weight: bold; line-height: 1.3; margin: 8px 0; color: #263243; }
            .page.ps-report .period { text-align: center; font-size: 8pt; font-style: normal; line-height: 1.3; margin: 0 0 10px; }
            .page.ps-report .filters { font-size: 7.5pt; line-height: 1.3; margin: 0 0 8px; }
            .page.ps-report .unit, .page.ps-report .currency { text-align: right; font-size: 8pt; margin: 0 0 5px; }
            .page.ps-report table { width: 100%; table-layout: fixed; border-collapse: collapse; empty-cells: show; }
            .page.ps-report table th { color: #33445c; background: #edf1f6; font-weight: bold; text-align: center; border-color: #94a3b8; }
            .page.ps-report table td { border-color: #94a3b8; vertical-align: middle; }
            .page.ps-report table thead { display: table-header-group; }
            .page.ps-report table tr { page-break-inside: avoid; }
            .page.ps-report .num { text-align: right; font-variant-numeric: tabular-nums; }
            .page.ps-report .center { text-align: center; }
            .page.ps-report tr.customer, .page.ps-report tr.day { font-weight: bold; color: #0645ad; }
            .page.ps-report tr.total, .page.ps-report tr.advance_total { font-weight: bold; color: #b91c1c; background: #edf1f6; }
            .page.ps-report tr.total td, .page.ps-report tr.advance_total td { background: #edf1f6; }
            /* The native report viewer adds o_in_iframe after loading.
               These screen styles never apply to the PDF renderer. */
            body.o_in_iframe { background: #edf0f4; padding: 24px !important; margin: 0; }
            body.o_in_iframe main { padding: 0 !important; }
            body.o_in_iframe .footer { display: none !important; }
            body.o_in_iframe .article { margin: 0; padding: 0; }
            body.o_in_iframe .page.ps-report {
                box-sizing: border-box; width: 100%; min-width: 1280px; max-width: 1720px;
                margin: 0 auto 28px !important; padding: 28px 32px 32px !important;
                background: white; border: 1px solid #dce1e8; border-radius: 8px;
                box-shadow: 0 3px 12px rgba(25, 35, 55, .08);
                font-size: 12px; color: #263243;
            }
            body.o_in_iframe .page .company { font-size: 12px; color: #5c687a; margin-bottom: 12px; }
            body.o_in_iframe .page.ps-report h1 { font-size: 20px; line-height: 1.4; margin: 0 0 8px; color: #263243; }
            body.o_in_iframe .page .period { font-size: 12px; color: #687487; margin: 0 0 22px; }
            body.o_in_iframe .page .filters { font-size: 12px; color: #687487; margin-bottom: 16px; }
            body.o_in_iframe .ps-history .meta { margin: 0 0 20px; padding: 14px 0; border-top: 1px solid #e7ebf0; border-bottom: 1px solid #e7ebf0; }
            body.o_in_iframe .ps-history .meta-row { padding: 5px 0; line-height: 1.6; }
            body.o_in_iframe .ps-history .meta strong { font-weight: 600; color: #526075; }
            body.o_in_iframe .page table { font-size: 12px; color: #263243; }
            body.o_in_iframe .page table th { background: #edf1f6; color: #33445c; font-weight: bold; padding: 10px 5px; line-height: 1.5; border-color: #94a3b8; }
            body.o_in_iframe .page table td { padding: 8px 5px; line-height: 1.5; border-color: #d6dde7; }
            body.o_in_iframe .page tbody tr:nth-child(even) td { background: #f8fafc; }
            body.o_in_iframe .page .num { font-variant-numeric: tabular-nums; }
            body.o_in_iframe .page .note,
            body.o_in_iframe .page .signature { font-size: 11px; color: #6c788a; margin-top: 16px; }
            body.o_in_iframe .page.ps-tracking { min-width: 1800px; max-width: 2200px; }
        </style>
    </template>

    <template id="sale_history_styles">
            <style>
                .ps-history { font-family: 'Times New Roman', 'Nimbus Roman', 'DejaVu Serif', serif; color: #111; font-size: 8pt; }
                .ps-history.page { page-break-after: always; padding-top: 2mm; }
                .ps-history.page:last-child { page-break-after: auto; }
                .ps-history h1 { text-align: center; font-size: 18px; font-weight: bold; margin: 8px 0 12px; }
                .ps-history .company { font-size: 8pt; font-weight: bold; }
                .ps-history .period { text-align: center; margin: -4px 0 12px; font-size: 7.5pt; }
                .ps-history .meta { width: 100%; margin-bottom: 12px; }
                .ps-history .meta-row { padding: 3px 0; }
                .ps-history .meta-cell { display: inline-block; vertical-align: top; }
                .ps-history .data { width: 100%; border-collapse: collapse; empty-cells: show; table-layout: fixed; font-size: 7.5pt; }
                .ps-history .data th, .ps-history .data td { border: 1px solid #333; padding: 4px 2px; line-height: 1.2; vertical-align: middle; overflow-wrap: break-word; word-wrap: break-word; }
                .ps-history .multiline { white-space: pre-line; }
                .ps-history .data th { font-weight: bold; text-align: center; background: #f1f1f1; }
                .ps-history .data thead { display: table-header-group; }
                .ps-history .data tr { page-break-inside: avoid; }
                .ps-history .num { text-align: right; }
                .ps-history .center { text-align: center; }
                .ps-history .note { font-size: 7pt; margin-top: 8px; }
            </style>
    </template>

    <template id="sale_history_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="font-family: 'Times New Roman', 'Nimbus Roman', 'DejaVu Serif', serif; font-size: 8pt; text-align: center;">
                Trang <span class="page"/> / <span class="topage"/>
            </div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_reports.sale_history_styles"/>
                    <t t-call="ps_sale_reports.sale_preview_styles"/>
                    <t t-foreach="report['pages']" t-as="group">
                        <t t-set="order" t-value="group['order']"/>
                        <div class="page ps-report ps-history">
                            <div class="company" t-out="wizard.company_id.name"/>
                            <h1>LỊCH SỬ ĐẶT HÀNG</h1>
                            <div class="period">
                                Từ ngày <t t-out="format_date(wizard.date_from)"/> đến ngày <t t-out="format_date(wizard.date_to)"/>
                            </div>
                            <div class="meta">
                                <div class="meta-row">
                                    <span class="meta-cell" style="width: 39%;"><strong>Số đơn đặt hàng: </strong><span t-field="order.name"/></span>
                                    <span class="meta-cell" style="width: 35%;"><strong>Số hợp đồng: </strong><span t-field="order.ps_contract_ref"/></span>
                                    <span class="meta-cell" style="width: 24%;"><strong>Người lập: </strong><span t-out="user.name"/></span>
                                </div>
                                <div class="meta-row"><strong>Tên khách hàng: </strong><span t-field="order.partner_id.name"/></div>
                                <div class="meta-row"><strong>Địa chỉ khách hàng: </strong><span t-out="(order.partner_id.contact_address or '').replace('\n', ', ')"/></div>
                                <div class="meta-row">
                                    <span class="meta-cell" style="width: 39%;"><strong>Điện thoại: </strong><span t-field="order.partner_id.phone"/></span>
                                    <span class="meta-cell" style="width: 35%;"><strong>Loại tiền: </strong><span t-out="order.currency_id.name"/></span>
                                    <span class="meta-cell" style="width: 24%;"><strong>Ngày lập: </strong><span t-out="format_date(print_date)"/></span>
                                </div>
                            </div>
                            <table class="data">
                                <colgroup>
                                    <col style="width:3%"/><col style="width:7%"/><col style="width:16%"/>
                                    <col style="width:7%"/><col style="width:4%"/><col style="width:7%"/>
                                    <col style="width:6%"/><col style="width:6%"/><col style="width:4%"/>
                                    <col style="width:6%"/><col style="width:6%"/><col style="width:7%"/>
                                    <col style="width:6%"/><col style="width:7%"/><col style="width:8%"/>
                                </colgroup>
                                <thead><tr>
                                    <th>STT</th><th>Mã nhập kho</th><th>Tên vật tư</th><th>QCSP</th><th>ĐVT</th>
                                    <th>Đơn giá</th><th>SL giao dịch</th><th>SL gốc</th><th>ĐVT gốc</th>
                                    <th>Ngày YC nhập kho</th><th>Ngày xác nhận nhập kho</th><th>LSX tham chiếu</th>
                                    <th>LSX</th><th>Số PO khách hàng</th><th>Ghi chú</th>
                                </tr></thead>
                                <tbody>
                                    <tr t-foreach="group['lines']" t-as="line">
                                        <td class="center" t-out="group['offset'] + line_index + 1"/>
                                        <td t-out="line.product_id.default_code or '&#160;'"/>
                                        <td t-out="line.product_id.name"/>
                                        <td class="multiline" t-out="line.ps_specification or '&#160;'"/>
                                        <td class="center" t-out="line.product_uom_id.name"/>
                                        <td class="num" t-out="format_number(line.price_unit)"/>
                                        <td class="num" t-out="format_number(line.product_uom_qty)"/>
                                        <td class="num" t-out="format_number(line.ps_base_quantity)"/>
                                        <td class="center" t-out="line.ps_base_uom_id.name"/>
                                        <td class="center" t-out="format_date(line.ps_requested_receipt_date) or '&#160;'"/>
                                        <td class="center" t-out="format_date(line.ps_confirmed_receipt_date) or '&#160;'"/>
                                        <td t-out="line.ps_production_ref or '&#160;'"/>
                                        <td t-out="line.ps_production_number or '&#160;'"/>
                                        <td t-out="line.ps_customer_po or '&#160;'"/>
                                        <td class="multiline" t-out="line.ps_report_note or '&#160;'"/>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="note">Mã nhập kho dùng mã nội bộ sản phẩm. SL gốc quy đổi về ĐVT gốc của sản phẩm.</div>
                            <t t-if="group_last" t-call="ps_sale_reports.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
