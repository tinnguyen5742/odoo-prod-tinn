<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_inventory_pdf" model="ir.actions.report">
        <field name="name">Nhập Xuất Tồn chi tiết theo SO</field>
        <field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ps_sale_reports.sale_inventory_pdf</field>
        <field name="report_file">ps_sale_reports.sale_inventory_pdf</field>
        <field name="paperformat_id" ref="ps_sale_reports.paperformat_sale_history"/>
        <field name="print_report_name">'Nhap_xuat_ton_chi_tiet_theo_SO_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
    <template id="sale_inventory_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="font-family:'Times New Roman','DejaVu Serif',serif;text-align:center;font-size:8pt">Trang <span class="page"/> / <span class="topage"/></div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_reports.sale_preview_styles"/>
                    <style>
                        .ps-inventory {font-family:'Times New Roman','Nimbus Roman','DejaVu Serif',serif;font-size:9pt;page-break-after:always;color:#111;}
                        .ps-inventory:last-child {page-break-after:auto;}
                        .ps-inventory h1 {text-align:center;font-size:18px;font-weight:bold;margin:8px 0;}
                        .ps-inventory .period {text-align:center;font-style:italic;margin-bottom:10px;}
                        .ps-inventory .filters {font-size:8pt;margin-bottom:8px;}
                        .ps-inventory table {width:100%;table-layout:fixed;border-collapse:collapse;font-size:7.5pt;}
                        .ps-inventory th,.ps-inventory td {border:1px solid #444;padding:3px;line-height:1.25;word-wrap:break-word;vertical-align:middle;}
                        .ps-inventory th {background:#edf1f6;text-align:center;font-weight:bold;}
                        .ps-inventory tr {page-break-inside:avoid;}
                        .ps-inventory .num {text-align:right;}
                        .ps-inventory .warehouse,.ps-inventory .product {font-weight:bold;color:#0645AD;}
                        .ps-inventory .order {font-weight:bold;}
                        .ps-inventory .subtotal {font-weight:bold;background:#edf1f6;}
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-contract ps-inventory">
                            <div class="company"><strong t-out="wizard.company_id.name"/></div>
                            <h1>BÁO CÁO NHẬP XUẤT TỒN CHI TIẾT THEO SO</h1>
                            <div class="period">Từ ngày <t t-out="format_date(wizard.date_from)"/> đến ngày <t t-out="format_date(wizard.date_to)"/></div>
                            <div class="filters" t-if="report['filters']" t-out="' | '.join(report['filters'])"/>
                            <table>
                                <colgroup><col style="width:3%"/><col style="width:8%"/><col style="width:8%"/><col style="width:10%"/><col style="width:12%"/><col style="width:14%"/><col style="width:5%"/><col style="width:10%"/><col style="width:10%"/><col style="width:10%"/><col style="width:10%"/></colgroup>
                                <thead><tr><th t-foreach="report['columns']" t-as="column" t-out="column[0]"/></tr></thead>
                                <tbody>
                                    <tr t-foreach="page" t-as="row" t-att-class="row['kind']">
                                        <td t-if="'label' in row" colspan="11"><t t-out="row['label']"/><t t-if="row.get('continued')"> (tiếp)</t></td>
                                        <t t-else="">
                                            <td t-foreach="row['values']" t-as="value" t-att-class="'num' if report['columns'][value_index][1] == 'number' else ''">
                                                <t t-if="value is None or value is False or value == ''">&#160;</t>
                                                <t t-elif="value_index == 0" t-out="value"/>
                                                <t t-elif="value_index == 1" t-out="format_date(value)"/>
                                                <t t-elif="report['columns'][value_index][1] == 'number'" t-out="format_number(value)"/>
                                                <t t-else="" t-out="value"/>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <t t-if="page_last" t-call="ps_sale_reports.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
