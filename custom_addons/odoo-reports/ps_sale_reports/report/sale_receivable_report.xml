<odoo>
    <record id="action_sale_receivable_pdf" model="ir.actions.report">
        <field name="name">Công nợ theo hóa đơn khách hàng</field><field name="model">ps.sale.history.wizard</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">ps_sale_reports.sale_receivable_pdf</field>
        <field name="report_file">ps_sale_reports.sale_receivable_pdf</field>
        <field name="paperformat_id" ref="ps_sale_reports.paperformat_sale_history"/>
        <field name="print_report_name">'Cong_no_hoa_don_KH_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
    <template id="sale_receivable_pdf">
        <t t-call="web.html_container">
            <div class="footer" style="text-align:center;font-size:8pt">Trang <span class="page"/> / <span class="topage"/></div>
            <t t-foreach="reports" t-as="report">
                <t t-set="wizard" t-value="report['wizard']"/>
                <div class="article" t-att-data-oe-model="wizard._name" t-att-data-oe-id="wizard.id">
                    <t t-call="ps_sale_reports.sale_preview_styles"/>
                    <style>
                        .ps-receivable {font-family:'Times New Roman','Nimbus Roman','DejaVu Serif',serif;font-size:8pt;page-break-after:always;}
                        .ps-receivable:last-child {page-break-after:auto;}
                        .ps-receivable h1 {text-align:center;font-size:18px;font-weight:bold;margin:8px 0;}
                        .ps-receivable .period {text-align:center;margin-bottom:12px;}
                        .ps-receivable table {width:100%;border-collapse:collapse;table-layout:fixed;font-size:7pt;}
                        .ps-receivable th,.ps-receivable td {border:1px solid #444;padding:4px 2px;line-height:1.25;word-wrap:break-word;vertical-align:middle;}
                        .ps-receivable th {text-align:center;background:#edf1f6;font-weight:bold;}
                        .ps-receivable tr {page-break-inside:avoid;}
                        .ps-receivable .num {text-align:right;}
                        .ps-receivable .customer {font-weight:bold;color:#0645AD;}
                        .ps-receivable .total {font-weight:bold;color:#B91C1C;background:#edf1f6;}
                    </style>
                    <t t-foreach="report['pages']" t-as="page">
                        <div class="page ps-report ps-contract ps-receivable">
                            <div class="company"><strong t-out="wizard.company_id.name"/></div>
                            <h1>BÁO CÁO CÔNG NỢ THEO HÓA ĐƠN - KHÁCH HÀNG</h1>
                            <div class="period">Từ ngày <t t-out="format_date(wizard.date_from)"/> đến ngày <t t-out="format_date(wizard.date_to)"/></div>
                            <table>
                                <colgroup><col style="width:3%"/><col style="width:10%"/><col style="width:7%"/><col style="width:16%"/><col style="width:9%"/><col style="width:9%"/><col style="width:9%"/><col style="width:9%"/><col style="width:11%"/><col style="width:7%"/><col style="width:10%"/></colgroup>
                                <thead><tr>
                                    <th t-foreach="report['headers'][:4]" t-as="heading" rowspan="2" t-out="heading"/>
                                    <th colspan="2">Giá trị hóa đơn</th>
                                    <th t-foreach="report['headers'][6:]" t-as="heading" rowspan="2" t-out="heading"/>
                                </tr><tr><th>Trước thuế</th><th>Sau thuế</th></tr></thead>
                                <tbody><tr t-foreach="page" t-as="row" t-att-class="row['kind']">
                                    <t t-if="row['kind'] == 'item'">
                                        <td t-foreach="row['values']" t-as="value" t-att-class="'num' if value_index in (4, 5, 6, 7) else ''">
                                            <t t-if="value is None or value == ''">&#160;</t>
                                            <t t-elif="value_index in (2, 9)" t-out="format_date(value)"/>
                                            <t t-elif="value_index in (4, 5, 6, 7)" t-out="format_number(value, row['currency'].decimal_places)"/>
                                            <span t-else="" style="white-space:pre-line" t-out="value"/>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="4"><t t-out="row['label']"/><t t-if="row.get('continued')"> (tiếp)</t></td>
                                        <td t-foreach="row['totals']" t-as="value" class="num"><t t-if="not row.get('continued')" t-out="format_number(value, row['currency'].decimal_places)"/></td>
                                        <td colspan="3">&#160;</td>
                                    </t>
                                </tr></tbody>
                            </table>
                            <t t-if="page_last" t-call="ps_sale_reports.sale_report_signature"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
