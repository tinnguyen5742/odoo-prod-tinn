<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== WIZARD 1: CHI TIẾT TỪNG KHÓA HỌC ==================== -->
    <record id="view_slide_channel_report_wizard_form" model="ir.ui.view">
        <field name="name">slide.channel.report.wizard.form</field>
        <field name="model">slide.channel.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Báo cáo khóa học">
                <group>
                    <field name="channel_id" readonly="1" options="{'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_preview"
                            string="Preview"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_export_pdf"
                            string="Xuất PDF"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Đóng"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Thao tác mở popup từ menu Thao tác (Action / Bánh răng) trên Form Khóa học -->
    <record id="action_slide_channel_report_wizard" model="ir.actions.act_window">
        <field name="name">Báo cáo khóa học</field>
        <field name="res_model">slide.channel.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_slide_channel_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="website_slides.model_slide_channel"/>
        <field name="binding_view_types">form</field>
    </record>

    <!-- ==================== WIZARD 2: BÁO CÁO TỔNG HỢP NHIỀU KHÓA HỌC ==================== -->
    <record id="view_slide_channel_overview_wizard_form" model="ir.ui.view">
        <field name="name">slide.channel.overview.wizard.form</field>
        <field name="model">slide.channel.overview.wizard</field>
        <field name="arch" type="xml">
            <form string="Báo cáo tổng hợp">
                <div class="alert alert-info py-2" role="alert">
                    Số lượng khóa học áp dụng: <strong class="fs-6"><field name="course_count" readonly="1"/> khóa học</strong>
                </div>
                <group>
                    <field name="channel_ids"
                           widget="many2many_tags"
                           readonly="1"
                           options="{'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_preview"
                            string="Preview"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_export_pdf"
                            string="Xuất PDF"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Đóng"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Thao tác mở popup Báo cáo tổng hợp từ menu In / Thao tác trên Danh sách (List) và Kanban -->
    <record id="action_slide_channel_overview_wizard" model="ir.actions.act_window">
        <field name="name">Báo cáo tổng hợp</field>
        <field name="res_model">slide.channel.overview.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_slide_channel_overview_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="website_slides.model_slide_channel"/>
        <field name="binding_view_types">list,kanban</field>
    </record>
</odoo>
