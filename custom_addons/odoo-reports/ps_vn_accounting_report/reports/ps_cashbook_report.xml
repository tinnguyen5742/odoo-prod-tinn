<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Paper format cho Cash Book: căn lề 2 bên 5mm để không bị cắt lề -->
        <record id="paperformat_cashbook" model="report.paperformat">
            <field name="name">Cash Book A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Gán paperformat tùy chỉnh cho report action Cash Book -->
        <record id="om_account_daily_reports.action_report_cash_book" model="ir.actions.report">
            <field name="paperformat_id" ref="ps_vn_accounting_report.paperformat_cashbook"/>
        </record>

        <!-- Template Cash Book custom: có header logo trái, thông tin phải -->
        <template id="report_cashbook_custom" inherit_id="om_account_daily_reports.report_cashbook">
            <xpath expr="." position="replace">
                <t t-call="web.html_container">
                    <t t-set="data_report_margin_top" t-value="12"/>
                    <t t-set="data_report_header_spacing" t-value="0"/>
                    <t t-set="data_report_dpi" t-value="110"/>
                    <t t-call="web.basic_layout">
                        <div class="page" style="font-family: 'Times New Roman', DejaVu, serif; font-size: 12px; padding: 10px !important;">

                            <!-- HEADER: Logo bên trái, Thông tin chi tiết bên phải giống mẫu -->
                            <table class="ps_company_header" style="width: 100%; table-layout: fixed; margin-bottom: 12px; border: none !important; border-collapse: collapse; font-size: 12px; page-break-inside: avoid;">
                                <colgroup><col style="width: 150px;"/><col/></colgroup>
                                <tr>
                                    <td style="width: 150px; vertical-align: middle; text-align: left; padding: 4px 20px 4px 0; border: none !important;">
                                        <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="display: block; max-height: 60px; max-width: 125px; width: auto; height: auto;" alt="Logo"/>
                                    </td>
                                    <td style="vertical-align: middle; text-align: left; padding: 4px 0; border: none !important; line-height: 1.5; overflow-wrap: break-word;">
                                        <div style="font-weight: bold; font-size: 15px; line-height: 1.35; margin-bottom: 3px; text-transform: uppercase;" t-esc="res_company.name"/>
                                        <div><strong>Địa chỉ:</strong> <span t-esc="res_company.street"/></div>
                                        <div><strong>Mã số thuế:</strong> <span t-esc="res_company.vat or ''"/></div>
                                        <div><strong>Điện thoại:</strong> <span t-esc="res_company.phone or ''"/></div>
                                        <div><strong>Email:</strong> <span t-esc="res_company.email or ''"/></div>
                                    </td>
                                </tr>
                            </table>

                            <hr style="border: 0.5px solid #000; margin-bottom: 15px;"/>

                            <!-- Title: centered, bold, uppercase -->
                            <div style="text-align: center; margin-bottom: 10px;">
                                <h2 style="text-align: center; font-weight: bold; margin: 0; font-size: 18px; text-transform: uppercase;">
                                    Sổ Tiền Mặt
                                </h2>
                            </div>

                            <!-- Date range: centered under title -->
                            <div style="text-align: center; margin-bottom: 12px; font-size: 12px;">
                                <strong>Từ ngày:</strong> <span t-esc="data['date_from']"/>
                                &#160;&#160;&#160;&#160;&#160;&#160;
                                <strong>Đến ngày:</strong> <span t-esc="data['date_to']"/>
                            </div>

                            <!-- Filter info: 2 columns -->
                            <table style="width: 100%; margin-bottom: 15px; border: none; font-size: 12px;">
                                <tr>
                                    <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                        <strong>Đơn vị báo cáo:</strong> <span t-esc="res_company.name"/>
                                    </td>
                                    <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                        <strong>Sổ nhật ký:</strong>
                                        <span t-esc="', '.join([ lt or '' for lt in print_journal ])"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                        <strong>Sắp xếp theo:</strong>
                                        <span t-if="data['sortby'] == 'sort_date'">Ngày</span>
                                        <span t-if="data['sortby'] == 'sort_journal_partner'">Sổ nhật ký và đối tác</span>
                                    </td>
                                    <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                        <strong>Bút toán:</strong>
                                        <span t-if="data['target_move'] == 'all'">Tất cả bút toán</span>
                                        <span t-if="data['target_move'] == 'posted'">Chỉ bút toán đã đăng</span>
                                    </td>
                                </tr>
                            </table>

                            <!-- Data table with visible borders and bold header -->
                            <table style="border-collapse: collapse; width: 100%; border: 1px solid #000;">
                                <thead>
                                    <tr style="background-color: #d9d9d9; font-weight: bold;">
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Ngày</th>
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Sổ NK</th>
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Đối tác</th>
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Tham chiếu</th>
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Bút toán</th>
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Diễn giải</th>
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold; width: 9%;">Nợ</th>
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold; width: 9%;">Có</th>
                                        <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold; width: 9%;">Số dư</th>
                                        <th groups="base.group_multi_currency" style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Ngoại tệ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="Accounts" t-as="account">
                                        <tr style="font-weight: bold; background-color: #f2f2f2;">
                                            <td colspan="6" style="border: 1px solid #000 !important; padding: 4px;">
                                                <span style="color: white;" t-esc="'..'"/>
                                                <span t-esc="account['code']"/> -
                                                <span t-esc="account['name']"/>
                                            </td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px; white-space: nowrap;">
                                                <span t-esc="account['debit']" t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                            </td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px; white-space: nowrap;">
                                                <span t-esc="account['credit']" t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                            </td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px; white-space: nowrap;">
                                                <span t-esc="account['balance']" t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                            </td>
                                            <td groups="base.group_multi_currency" style="border: 1px solid #000 !important; padding: 4px;"/>
                                        </tr>
                                        <tr t-foreach="account['move_lines']" t-as="line">
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="line['ldate']"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="line['lcode']"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="line['partner_name']"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-if="line['lref']" t-esc="line['lref']"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="line['move_name']"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="line['lname']"/></td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px; white-space: nowrap;">
                                                <span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                            </td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px; white-space: nowrap;">
                                                <span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                            </td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px; white-space: nowrap;">
                                                <span t-esc="line['balance']" t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                            </td>
                                            <td t-if="line['amount_currency']" class="text-end" style="border: 1px solid #000 !important; padding: 4px; white-space: nowrap;" groups="base.group_multi_currency">
                                                <span t-esc="line['amount_currency'] if line['amount_currency'] > 0.00 else ''"/>
                                                <span t-esc="line['currency_code'] if line['amount_currency'] > 0.00 else ''"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Footer / Signatures -->
                            <div style="margin-top: 30px; font-size: 12px; page-break-inside: avoid;">
                                <div style="text-align: right; font-style: italic; margin-bottom: 40px;">
                                    Lập ngày <span t-esc="time.strftime('%d')"/> tháng <span t-esc="time.strftime('%m')"/> năm <span t-esc="time.strftime('%Y')"/>
                                </div>
                                <table style="width: 100%; border: none;">
                                    <tr>
                                        <td style="width: 33%; text-align: center; vertical-align: top;">
                                            <div style="font-weight: bold; text-transform: uppercase;">Người lập</div>
                                            <div style="font-style: italic;">(Ký, họ tên)</div>
                                        </td>
                                        <td style="width: 33%; text-align: center; vertical-align: top;">
                                            <div style="font-weight: bold; text-transform: uppercase;">Kế toán trưởng</div>
                                            <div style="font-style: italic;">(Ký, họ tên)</div>
                                        </td>
                                        <td style="width: 33%; text-align: center; vertical-align: top;">
                                            <div style="font-weight: bold; text-transform: uppercase;">Tổng giám đốc</div>
                                            <div style="font-style: italic;">(Ký, họ tên, đóng dấu)</div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                        </div>
                    </t>
                </t>
            </xpath>
        </template>

    </data>
</odoo>