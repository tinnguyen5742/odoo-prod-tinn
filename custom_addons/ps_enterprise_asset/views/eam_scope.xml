<odoo>
    <!-- Seven business areas from the supplied EAM requirements. -->
    <menuitem id="menu_preventive" parent="menu_eam" name="Kế hoạch bảo trì" sequence="30"/>
    <menuitem id="menu_condition" parent="menu_eam" name="Giám sát thiết bị" sequence="40"/>
    <menuitem id="menu_analytics" parent="menu_eam" name="Báo cáo &amp; phân tích" sequence="70"/>
    <menuitem id="menu_equipment" parent="menu_eam" name="Hồ sơ thiết bị" action="equipment_action" sequence="10"/>
    <menuitem id="menu_claim" parent="menu_eam" name="Bảo hành" action="claim_action" sequence="20"/>
    <menuitem id="menu_plan" parent="menu_preventive" name="Kế hoạch &amp; quy trình" action="plan_action" sequence="10"/>
    <menuitem id="menu_calendar" parent="menu_preventive" name="Lịch bảo trì" action="calendar_action" sequence="20"/>
    <menuitem
        id="menu_meter"
        parent="menu_condition"
        name="Đồng hồ &amp; cảm biến"
        action="meter_action"
        sequence="10"
    />
    <menuitem
        id="menu_reading"
        parent="menu_condition"
        name="Số đo &amp; cảnh báo"
        action="reading_action"
        sequence="20"
    />
    <menuitem id="menu_request" parent="menu_eam" name="Lệnh bảo trì" action="request_action" sequence="50"/>
    <record id="menu_mro" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <menuitem
        id="menu_operation"
        parent="menu_analytics"
        name="Vận hành &amp; hiệu quả thiết bị"
        action="operation_action"
        sequence="10"
    />
    <menuitem id="menu_cost" parent="menu_analytics" name="Phân tích chi phí" action="cost_action" sequence="30"/>
    <record id="equipment_kpi_list" model="ir.ui.view">
        <field name="name">EAM equipment reliability and cost</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="eam_code"/>
                <field name="name"/>
                <field name="eam_status"/>
                <field name="eam_mtbf_hours" string="Thời gian trung bình giữa sự cố (MTBF, giờ)"/>
                <field name="eam_mttr_hours" string="Thời gian sửa chữa trung bình (MTTR, giờ)"/>
                <field name="eam_oee" string="Hiệu quả thiết bị tổng hợp (OEE, %)"/>
                <field name="eam_maintenance_cost"/>
                <field name="eam_tco" string="Tổng chi phí sở hữu (TCO)"/>
                <field name="currency_id" optional="hide" string="Tiền tệ"/>
                <field name="company_id" string="Công ty"/>
            </list>
        </field>
    </record>
    <record id="equipment_kpi_action" model="ir.actions.act_window">
        <field name="name">Độ tin cậy &amp; chi phí sở hữu</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="equipment_kpi_list"/>
        <field name="search_view_id" ref="equipment_search"/>
    </record>
    <record id="equipment_kpi_list_binding" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="equipment_kpi_list"/>
        <field name="act_window_id" ref="equipment_kpi_action"/>
    </record>
    <record id="equipment_kpi_form_binding" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="equipment_form"/>
        <field name="act_window_id" ref="equipment_kpi_action"/>
    </record>
    <menuitem
        id="menu_reliability"
        parent="menu_analytics"
        name="Độ tin cậy &amp; chi phí sở hữu"
        action="equipment_kpi_action"
        sequence="20"
    />
    <record id="product_template_mro_form" model="ir.ui.view">
        <field name="name">product.template.eam.mro</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="eam_mro" invisible="type != 'consu'"/>
            </field>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">VD: Vòng bi 6205, lọc dầu máy nén khí</attribute>
            </xpath>
        </field>
    </record>
    <record id="product_variant_mro_form" model="ir.ui.view">
        <field name="name">product.product.eam.mro</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='eam_mro']" position="attributes">
                <attribute name="string">Phụ tùng bảo trì (MRO)</attribute>
            </xpath>
        </field>
    </record>
    <record id="request_form_mro_scope" model="ir.ui.view">
        <field name="name">eam.request.mro.scope</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='part_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="domain">[('type','=','consu'),('eam_mro','=',True)]</attribute>
                <attribute name="context">{'default_type':'consu','default_eam_mro':True,'default_is_storable':True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
