<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ps.vn.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']/setting[@id='product_accounts']" position="after">
                <setting id="goods_return_accounts" string="Sales Return:">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="sales_return_debit_account_id" class="col-lg-5 o_light_label" string="Debit"/>
                            <field name="sales_return_debit_account_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="sales_return_credit_account_id" class="col-lg-5 o_light_label" string="Credit"/>
                            <field name="sales_return_credit_account_id"/>
                        </div>
                    </div>
                </setting>
                <setting id="partner_default_accounts" string="Default Customer Accounts:">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="account_default_receivable_id" class="col-lg-5 o_light_label" string="Receivable"/>
                            <field name="account_default_receivable_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="customer_income_account_id" class="col-lg-5 o_light_label" string="Income"/>
                            <field name="customer_income_account_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
