<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Danh sách Transaction All (định dạng nhật ký VN) -->
        <record id="ps_view_gl_transaction_all_list" model="ir.ui.view">
            <field name="name">gl.transaction.all.list</field>
            <field name="model">gl.transaction.all</field>
            <field name="arch" type="xml">
                <list string="Transaction All" create="false" edit="false" delete="false">
                    <header>
                        <button name="action_export_xlsx"
                                type="object"
                                string="Export Excel"
                                class="btn-primary"
                                display="always"/>
                    </header>
                    <field name="date"/>
                    <field name="move_name"/>
                    <field name="partner_id"/>
                    <field name="cost_center_id"/>
                    <field name="debit_account_id"/>
                    <field name="credit_account_id"/>
                    <field name="amount" sum="Total"/>
                    <field name="description"/>
                    <field name="journal_id" optional="hide"/>
                    <field name="move_id" optional="hide"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                    <field name="company_currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Form Transaction All -->
        <record id="ps_view_gl_transaction_all_form" model="ir.ui.view">
            <field name="name">gl.transaction.all.form</field>
            <field name="model">gl.transaction.all</field>
            <field name="arch" type="xml">
                <form string="Transaction All" create="false" edit="false" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="move_name"/>
                                <field name="move_id"/>
                                <field name="journal_id"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="cost_center_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="debit_account_id"/>
                                <field name="debit_move_line_id"/>
                            </group>
                            <group>
                                <field name="credit_account_id"/>
                                <field name="credit_move_line_id"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="amount"/>
                                <field name="company_currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Bộ lọc Transaction All -->
        <record id="ps_view_gl_transaction_all_search" model="ir.ui.view">
            <field name="name">gl.transaction.all.search</field>
            <field name="model">gl.transaction.all</field>
            <field name="arch" type="xml">
                <search string="Transaction All">
                    <field name="move_name"/>
                    <field name="partner_id"/>
                    <field name="cost_center_id"/>
                    <field name="debit_account_id"/>
                    <field name="credit_account_id"/>
                    <field name="description"/>
                    <field name="journal_id"/>
                    <separator/>
                    <filter string="Date" name="filter_date" date="date"/>
                    <separator/>
                    <filter string="Journal Entry" name="group_by_move" context="{'group_by': 'move_id'}"/>
                    <filter string="Customer/Vendor" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Cost Center" name="group_by_cost_center" context="{'group_by': 'cost_center_id'}"/>
                    <filter string="Debit Account" name="group_by_debit_account" context="{'group_by': 'debit_account_id'}"/>
                    <filter string="Credit Account" name="group_by_credit_account" context="{'group_by': 'credit_account_id'}"/>
                    <filter string="Journal" name="group_by_journal" context="{'group_by': 'journal_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                </search>
            </field>
        </record>

        <!-- Action mở Transaction All -->
        <record id="ps_action_gl_transaction_all" model="ir.actions.act_window">
            <field name="name">Transaction All</field>
            <field name="res_model">gl.transaction.all</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('ps_view_gl_transaction_all_list')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('ps_view_gl_transaction_all_form')})]"/>
            <field name="search_view_id" ref="ps_view_gl_transaction_all_search"/>
        </record>

        <!-- Action menu: xuất Excel các dòng đang chọn -->
        <record id="ps_action_export_gl_transaction_all_xlsx" model="ir.actions.server">
            <field name="name">Export Excel</field>
            <field name="model_id" ref="model_gl_transaction_all"/>
            <field name="binding_model_id" ref="model_gl_transaction_all"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_export_xlsx()</field>
        </record>

    </data>
</odoo>
