<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Danh sách mẫu báo cáo tài chính -->
        <record id="ps_view_financial_report_template_list" model="ir.ui.view">
            <field name="name">ps.financial.report.template.list</field>
            <field name="model">ps.financial.report.template</field>
            <field name="arch" type="xml">
                <list string="Financial Report Templates">
                    <field name="x_code"/>
                    <field name="x_name"/>
                    <field name="x_formula_count"/>
                    <field name="x_active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Form mẫu báo cáo tài chính -->
        <record id="ps_view_financial_report_template_form" model="ir.ui.view">
            <field name="name">ps.financial.report.template.form</field>
            <field name="model">ps.financial.report.template</field>
            <field name="arch" type="xml">
                <form string="Financial Report Template">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_preview_report"
                                    type="object"
                                    string="Xem trước"
                                    class="oe_stat_button"
                                    icon="fa-eye"/>
                            <button name="action_open_report_wizard"
                                    type="object"
                                    string="In báo cáo"
                                    class="oe_stat_button"
                                    icon="fa-print"/>
                        </div>
                        <group>
                            <group>
                                <field name="x_code"/>
                                <field name="x_name"/>
                                <field name="x_active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="x_formula_count"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Formulas">
                                <field name="x_formula_ids">
                                    <list string="Formulas" editable="bottom">
                                        <field name="x_sequence" widget="handle"/>
                                        <field name="x_code"/>
                                        <field name="x_label"/>
                                        <field name="x_level"/>
                                        <field name="x_line_type"/>
                                        <field name="x_formula"/>
                                        <field name="x_note"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <field name="x_description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Danh sách công thức báo cáo tài chính -->
        <record id="ps_view_financial_report_formula_list" model="ir.ui.view">
            <field name="name">ps.financial.report.formula.list</field>
            <field name="model">ps.financial.report.formula</field>
            <field name="arch" type="xml">
                <list string="Financial Report Formulas" editable="bottom">
                    <field name="x_sequence" widget="handle"/>
                    <field name="x_template_id"/>
                    <field name="x_code"/>
                    <field name="x_label"/>
                    <field name="x_level"/>
                    <field name="x_line_type"/>
                    <field name="x_formula"/>
                    <field name="x_note"/>
                </list>
            </field>
        </record>

        <!-- Form công thức báo cáo tài chính -->
        <record id="ps_view_financial_report_formula_form" model="ir.ui.view">
            <field name="name">ps.financial.report.formula.form</field>
            <field name="model">ps.financial.report.formula</field>
            <field name="arch" type="xml">
                <form string="Financial Report Formula">
                    <sheet>
                        <group>
                            <field name="x_template_id"/>
                            <field name="x_sequence"/>
                            <field name="x_code"/>
                            <field name="x_label"/>
                            <field name="x_level"/>
                            <field name="x_line_type"/>
                            <field name="x_formula"/>
                            <field name="x_note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Bộ lọc tìm kiếm mẫu báo cáo tài chính -->
        <record id="ps_view_financial_report_template_search" model="ir.ui.view">
            <field name="name">ps.financial.report.template.search</field>
            <field name="model">ps.financial.report.template</field>
            <field name="arch" type="xml">
                <search string="Financial Report Template">
                    <field name="x_code"/>
                    <field name="x_name"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('x_active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('x_active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Action mở danh sách mẫu báo cáo tài chính -->
        <record id="ps_action_financial_report_template" model="ir.actions.act_window">
            <field name="name">Financial Report Formulas</field>
            <field name="res_model">ps.financial.report.template</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('ps_view_financial_report_template_list')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('ps_view_financial_report_template_form')})]"/>
            <field name="search_view_id" ref="ps_view_financial_report_template_search"/>
        </record>

        <!-- Action mở danh sách công thức báo cáo tài chính -->
        <record id="ps_action_financial_report_formula" model="ir.actions.act_window">
            <field name="name">Financial Report Formulas</field>
            <field name="res_model">ps.financial.report.formula</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('ps_view_financial_report_formula_list')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('ps_view_financial_report_formula_form')})]"/>
        </record>

    </data>
</odoo>
