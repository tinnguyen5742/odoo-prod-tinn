<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Danh sách hóa đơn VAT tùy chỉnh -->
        <record id="ps_view_vat_list" model="ir.ui.view">
            <field name="name">ps.vn.accounting.vat.list</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="VAT Invoice List" decoration-muted="state == 'cancel'">
                    <field name="name"/>
                    <field name="invoice_partner_display_name" string="Partner"/>
                    <field name="invoice_date"/>
                    <field name="amount_total_signed" string="Total"/>
                    <field name="x_vn_einvoice_status" optional="show" widget="badge"/>
                    <field name="x_vn_invoice_symbol" optional="show"/>
                    <field name="x_vn_customs_rate" optional="show"/>
                    <field name="x_vn_declaration_no" optional="show"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Bộ lọc tìm kiếm hóa đơn VAT -->
        <record id="ps_view_vat_search" model="ir.ui.view">
            <field name="name">ps.vn.accounting.vat.search</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <search string="VAT Invoice Search">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <separator/>
                    <filter string="Not Issued" name="not_issued" domain="[('x_vn_einvoice_status', '=', 'not_issued')]"/>
                    <filter string="Processing" name="processing" domain="[('x_vn_einvoice_status', '=', 'processing')]"/>
                    <filter string="Issued" name="issued" domain="[('x_vn_einvoice_status', '=', 'issued')]"/>
                    <filter string="Failed" name="failed" domain="[('x_vn_einvoice_status', '=', 'failed')]"/>
                    <separator/>
                    <filter string="E-Invoice Status" name="group_by_x_vn_einvoice_status" context="{'group_by': 'x_vn_einvoice_status'}"/>
                </search>
            </field>
        </record>

        <!-- Kế thừa danh sách hóa đơn bán ra để thêm trạng thái HĐĐT -->
        <record id="ps_view_out_inv_list" model="ir.ui.view">
            <field name="name">ps.account.out.invoice.list.vn.accounting</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="x_vn_einvoice_status" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Kế thừa danh sách hóa đơn mua vào để thêm trạng thái HĐĐT -->
        <record id="ps_view_in_inv_list" model="ir.ui.view">
            <field name="name">ps.account.in.invoice.list.vn.accounting</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="x_vn_einvoice_status" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Kế thừa form hóa đơn để thêm các field HĐĐT -->
        <record id="ps_view_move_form" model="ir.ui.view">
            <field name="name">ps.account.move.form.vn.accounting</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_left_group']" position="inside">
                    <field name="x_vn_invoice_symbol"/>
                    <field name="x_vn_einvoice_status"/>
                    <field name="x_vn_declaration_no"/>
                    <field name="x_vn_customs_rate"/>
                    <field name="cost_center_id" options="{'no_create': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='analytic_distribution']" position="after">
                    <field name="cost_center_id" optional="show" options="{'no_create': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//page[@id='aml_tab']//field[@name='line_ids']/list/field[@name='analytic_distribution']" position="after">
                    <field name="cost_center_id" optional="show" options="{'no_create': True, 'no_open': True}"/>
                </xpath>
            </field>
        </record>

        <!-- General Ledger: fix lại để mở Journal Entry -->
        <record id="ps_view_move_line_tree_grouped_general_open_move" model="ir.ui.view">
            <field name="name">account.move.line.list.grouped.general.open.move</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree_grouped_general"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="action">action_open_business_doc</attribute>
                    <attribute name="type">object</attribute>
                </xpath>
            </field>
        </record>

        <!-- Cost center trên danh sách journal items -->
        <record id="ps_view_move_line_tree_cost_center" model="ir.ui.view">
            <field name="name">account.move.line.list.cost.center</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='analytic_distribution']" position="after">
                    <field name="cost_center_id" optional="show" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Action server: đánh dấu hóa đơn đã xuất HĐĐT -->
        <record id="ps_action_mark_issued" model="ir.actions.server">
            <field name="name">Mark as E-Invoice Issued</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    records.write({'x_vn_einvoice_status': 'issued'})
            </field>
        </record>

    </data>
</odoo>
