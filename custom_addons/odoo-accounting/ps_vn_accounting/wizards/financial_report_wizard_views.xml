<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ps_view_financial_report_wizard_form" model="ir.ui.view">
            <field name="name">ps.financial.report.wizard.form</field>
            <field name="model">ps.financial.report.wizard</field>
            <field name="arch" type="xml">
                <form string="In báo cáo tài chính">
                    <group>
                        <group>
                            <field name="x_template_id"/>
                            <field name="x_company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="x_date_from"/>
                            <field name="x_date_to"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_preview_report"
                                string="Xem trước"
                                type="object"
                                class="btn-secondary"/>
                        <button name="action_print_pdf"
                                string="In PDF"
                                type="object"
                                class="btn-primary"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="ps_action_financial_report_wizard" model="ir.actions.act_window">
            <field name="name">In báo cáo tài chính TT99</field>
            <field name="res_model">ps.financial.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
