<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Trial Balance, General Ledger, Journal Audit, Partner Ledger, P&amp;L, Balance Sheet -->
        <record id="ps_account_common_report_preview_button" model="ir.ui.view">
            <field name="name">account.common.report.preview.button</field>
            <field name="model">account.common.report</field>
            <field name="inherit_id" ref="accounting_pdf_reports.account_common_report_view"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='check_report']" position="before">
                    <button name="action_preview_report"
                            string="Preview"
                            type="object"
                            class="btn-secondary"
                            data-hotkey="v"/>
                </xpath>
            </field>
        </record>

        <!-- Tax Report -->
