<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Paper format cho Financial Report: tắt header line để tránh số trang ở trên cùng -->
        <record id="paperformat_financial_report" model="report.paperformat">
            <field name="name">Financial Report A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Gán paperformat tùy chỉnh cho report action Financial Report -->
        <record id="accounting_pdf_reports.action_report_financial" model="ir.actions.report">
            <field name="paperformat_id" ref="ps_vn_accounting.paperformat_financial_report"/>
        </record>

        <!-- Template Financial Report custom: dùng basic_layout, không header, không số trang -->
        <template id="report_financial_custom" inherit_id="accounting_pdf_reports.report_financial">
            <xpath expr="." position="replace">
                <t t-call="web.html_container">
                    <t t-set="data_report_margin_top" t-value="12"/>
                    <t t-set="data_report_header_spacing" t-value="0"/>
                    <t t-set="data_report_dpi" t-value="110"/>
                    <t t-foreach="docs" t-as="o">
                        <t t-call="web.basic_layout">
                            <div class="page" style="font-family: 'Times New Roman', DejaVu, serif; font-size: 12px; padding:24px !important;">

                                <!-- Title: centered, bold, uppercase, translate common names -->
                                <div style="text-align: center; margin-bottom: 15px;">
                                    <h2 style="text-align: center; font-weight: bold; margin: 0; font-size: 18px; text-transform: uppercase;">
                                        <span t-if="data['account_report_id'][1] == 'Balance Sheet'">Bảng Cân Đối Kế Toán</span>
                                        <span t-if="data['account_report_id'][1] == 'Profit and Loss'">Báo Cáo Kết Quả Hoạt Động Kinh Doanh</span>
                                        <span t-else="" t-esc="data['account_report_id'][1]"/>
                                    </h2>
                                </div>                                <!-- Date range: centered under title -->
                                <div style="text-align: center; margin-bottom: 15px; font-size: 12px;">
                                    <strong>Từ ngày:</strong> <span t-esc="data['date_from']"/>
                                    &#160;&#160;&#160;&#160;&#160;&#160;
                                    <strong>Đến ngày:</strong> <span t-esc="data['date_to']"/>
                                </div>

                                <!-- Filter info: 2 columns -->
                                <table style="width: 100%; margin-bottom: 15px; border: none; font-size: 12px;">
                                    <tr>
                                        <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                            <strong>Công ty:</strong>
                                            <span t-esc="res_company.name"/>
                                        </td>
                                        <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                            <strong>Bút toán:</strong>
                                            <span t-if="data['target_move'] == 'all'">Tất cả bút toán</span>
                                            <span t-if="data['target_move'] == 'posted'">Chỉ bút toán đã đăng</span>
                                        </td>
                                    </tr>
                                    </table>

                                <!-- Table with debit/credit columns -->
                                <table style="border-collapse: collapse; width: 100%; border: 1px solid #000;" t-if="data['debit_credit'] == 1">
                                    <thead>
                                        <tr style="background-color: #d9d9d9; font-weight: bold;">
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Tên</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Nợ</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Có</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Số dư</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="get_account_lines" t-as="a">
                                            <t t-if="a['level'] != 0">
                                                <t t-if="int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: normal;'"/></t>
                                                <t t-if="not int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: bold;'"/></t>

                                                <td style="border: 1px solid #000 !important; padding: 4px;">
                                                    <span style="color: white;" t-esc="'..' * int(a.get('level', 0))"/>
                                                    <span t-att-style="style" t-esc="a.get('name')"/>
                                                </td>
                                                <td class="text-end" style="border: 1px solid #000 !important; text-align: right; padding: 4px; white-space: text-nowrap;">
                                                    <span t-att-style="style" t-esc="a.get('debit')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                </td>
                                                <td class="text-end" style="border: 1px solid #000 !important; text-align: right; padding: 4px; white-space: text-nowrap;">
                                                    <span t-att-style="style" t-esc="a.get('credit')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                </td>
                                                <td class="text-end" style="border: 1px solid #000 !important; text-align: right; padding: 4px; white-space: text-nowrap;">
                                                    <span t-att-style="style" t-esc="a.get('balance')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </tbody>
                                </table>

                                <!-- Table without debit/credit, without filter -->
                                <table style="border-collapse: collapse; width: 100%; border: 1px solid #000;" t-if="not data['enable_filter'] and not data['debit_credit']">
                                    <thead>
                                        <tr style="background-color: #d9d9d9; font-weight: bold;">
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Tên</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Số dư</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="get_account_lines" t-as="a">
                                            <t t-if="a['level'] != 0">
                                                <t t-if="int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: normal;'"/></t>
                                                <t t-if="not int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: bold;'"/></t>

                                                <td style="border: 1px solid #000 !important; padding: 4px;">
                                                    <span style="color: white;" t-esc="'..' * int(a.get('level', 0))"/>
                                                    <span t-att-style="style" t-esc="a.get('name')"/>
                                                </td>
                                                <td class="text-end" style="border: 1px solid #000 !important; text-align: right; padding: 4px;">
                                                    <span t-att-style="style" t-esc="a.get('balance')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </tbody>
                                </table>

                                <!-- Table with filter comparison -->
                                <table style="border-collapse: collapse; width: 100%; border: 1px solid #000;" t-if="data['enable_filter'] == 1 and not data['debit_credit']">
                                    <thead>
                                        <tr style="background-color: #d9d9d9; font-weight: bold;">
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Tên</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Số dư</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;"><span t-esc="data['label_filter']"/></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="get_account_lines" t-as="a">
                                            <t t-if="a['level'] != 0">
                                                <t t-if="int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: normal;'"/></t>
                                                <t t-if="not int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: bold;'"/></t>
                                                <td style="border: 1px solid #000 !important; padding: 4px;">
                                                    <span style="color: white;" t-esc="'..'"/>
                                                    <span t-att-style="style" t-esc="a.get('name')"/>
                                                </td>
                                                <td class="text-end" style="border: 1px solid #000 !important; text-align: right; padding: 4px;">
                                                    <span t-att-style="style" t-esc="a.get('balance')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                </td>
                                                <td class="text-end" style="border: 1px solid #000 !important; text-align: right; padding: 4px;">
                                                    <span t-att-style="style" t-esc="a.get('balance_cmp')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </tbody>
                                </table>
                            <!-- Footer -->
                            <div style="margin-top: 30px; font-size: 12px;">
                                <div style="text-align: right; font-style: italic; margin-bottom: 40px;">
                                    Lập ngày <span t-esc="time.strftime('%d')"/> tháng <span t-esc="time.strftime('%m')"/> năm <span t-esc="time.strftime('%Y')"/>
                                </div>
                                <table style="width: 100%; border: none;">
                                    <tr>
                                        <td style="width: 33%; text-align: center; vertical-align: top;">
                                            <div style="font-weight: bold; text-transform: uppercase;">Người lập</div>
                                            <div style="font-style: italic;">Ký, họ tên</div>
                                        </td>
                                        <td style="width: 33%; text-align: center; vertical-align: top;">
                                            <div style="font-weight: bold; text-transform: uppercase;">Kế toán trưởng</div>
                                            <div style="font-style: italic;">Ký, họ tên</div>
                                        </td>
                                        <td style="width: 33%; text-align: center; vertical-align: top;">
                                            <div style="font-weight: bold; text-transform: uppercase;">Tổng giám đốc</div>
                                            <div style="font-style: italic;">Ký, họ tên, đóng dấu</div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            </div>
                        </t>
                    </t>
                </t>
            </xpath>
        </template>

    </data>
</odoo>
