<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Paper format cho Journal Audit Report: tắt header line để tránh số trang ở trên cùng -->
        <record id="paperformat_journal_audit" model="report.paperformat">
            <field name="name">Journal Audit A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Gán paperformat tùy chỉnh cho report action Journal Audit -->
        <record id="accounting_pdf_reports.action_report_journal" model="ir.actions.report">
            <field name="paperformat_id" ref="ps_vn_accounting.paperformat_journal_audit"/>
        </record>

        <!-- Template Journal Audit custom: dùng basic_layout, không header, không số trang -->
        <template id="report_journal_custom" inherit_id="accounting_pdf_reports.report_journal">
            <xpath expr="." position="replace">
                <t t-call="web.html_container">
                    <t t-set="data_report_margin_top" t-value="12"/>
                    <t t-set="data_report_header_spacing" t-value="0"/>
                    <t t-set="data_report_dpi" t-value="110"/>
                    <t t-foreach="docs" t-as="o">
                        <t t-call="web.basic_layout">
                            <div class="page" style="font-family: 'Times New Roman', DejaVu, serif; font-size: 12px; padding:24px !important;">

                                <!-- Title: centered, bold, uppercase -->
                                <div style="text-align: center; margin-bottom: 15px;">
                                    <h2 style="text-align: center; font-weight: bold; margin: 0; font-size: 18px; text-transform: uppercase;">
                                        Báo Cáo Kiểm Tra Sổ Nhật Ký
                                    </h2>
                                </div>

                                <!-- Filter info: 2 columns -->
                                <table style="width: 100%; margin-bottom: 15px; border: none; font-size: 12px;">
                                    <tr>
                                        <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                            <strong>Công ty:</strong>
                                            <span t-esc="res_company.name"/>
                                        </td>
                                        <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                            <strong>Sắp xếp bút toán theo:</strong>
                                            <span t-if="data['form'].get('sort_selection') != 'l.date'">Số bút toán</span>
                                            <span t-if="data['form'].get('sort_selection') == 'l.date'">Ngày</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                            <strong>Sổ nhật ký:</strong>
                                            <span t-esc="o.name"/>
                                        </td>
                                        <td style="width: 50%; vertical-align: top; padding: 3px 0;">
                                            <strong>Bút toán:</strong>
                                            <span t-if="data['form']['target_move'] == 'all'">Tất cả bút toán</span>
                                            <span t-if="data['form']['target_move'] == 'posted'">Chỉ bút toán đã đăng</span>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Main data table with visible borders and bold header -->
                                <table style="border-collapse: collapse; width: 100%; border: 1px solid #000; margin-bottom: 15px;">
                                    <thead>
                                        <tr style="background-color: #d9d9d9; font-weight: bold;">
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Bút toán</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Ngày</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Tài khoản</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Đối tác</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Diễn giải</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Nợ</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Có</th>
                                            <th t-if="data['form']['amount_currency']" style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Ngoại tệ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="lines[o.id]" t-as="aml">
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="aml.move_id.name != '/' and aml.move_id.name or ('*'+str(aml.move_id.id))"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-field="aml.date"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-field="aml.account_id.code"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="aml.sudo().partner_id and aml.sudo().partner_id.name and aml.sudo().partner_id.name[:23] or ''"/></td>
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="aml.name and aml.name[:35]"/></td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="aml.debit" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="aml.credit" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                            <td t-if="data['form']['amount_currency'] and aml.amount_currency" class="text-end" style="border: 1px solid #000 !important; padding: 4px;">
                                                <span t-esc="aml.amount_currency" t-options="{'widget': 'monetary', 'display_currency': aml.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <!-- Total row -->
                                <table style="border-collapse: collapse; width: auto; margin-left: auto; margin-bottom: 15px; border: 1px solid #000;">
                                    <tr style="font-weight: bold; background-color: #f2f2f2;">
                                        <td style="border: 1px solid #000 !important; padding: 4px;"><strong>Tổng cộng</strong></td>
                                        <td class="text-end" style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="sum_debit(data, o)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                        <td class="text-end" style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="sum_credit(data, o)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                    </tr>
                                </table>

                                <!-- Tax Declaration table -->
                                <table style="border-collapse: collapse; width: auto; border: 1px solid #000;">
                                    <thead>
                                        <tr style="background-color: #d9d9d9; font-weight: bold;">
                                            <th colspan="3" style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Kê khai thuế</th>
                                        </tr>
                                        <tr style="background-color: #d9d9d9; font-weight: bold;">
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Tên thuế</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Tiền hàng</th>
                                            <th style="border: 1px solid #000 !important; text-align: center; padding: 5px; font-weight: bold;">Tiền thuế</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="taxes" t-value="get_taxes(data, o)"/>
                                        <tr t-foreach="taxes" t-as="tax">
                                            <td style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="tax.name"/></td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="taxes[tax]['base_amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                            <td class="text-end" style="border: 1px solid #000 !important; padding: 4px;"><span t-esc="taxes[tax]['tax_amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </t>
                    </t>
                </t>
            </xpath>
        </template>

    </data>
</odoo>
