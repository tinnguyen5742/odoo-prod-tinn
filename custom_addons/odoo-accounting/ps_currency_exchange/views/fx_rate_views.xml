<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ps_currency_exchange_rate_list" model="ir.ui.view">
        <field name="name">ps.currency.exchange.rate.list</field>
        <field name="model">ps.currency.exchange.rate</field>
        <field name="arch" type="xml">
            <list string="Tỷ giá ngoại tệ" decoration-success="status == 'success'" decoration-danger="status == 'failed'">
                <field name="name"/>
                <field name="rate_date"/>
                <field name="fetched_at"/>
                <field name="source_updated_at"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_ps_currency_exchange_rate_form" model="ir.ui.view">
        <field name="name">ps.currency.exchange.rate.form</field>
        <field name="model">ps.currency.exchange.rate</field>
        <field name="arch" type="xml">
            <form string="Tỷ giá ngoại tệ">
                <header>
                    <button name="action_fetch_rates"
                            string="Lấy tỷ giá realtime"
                            type="object"
                            class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,success"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="log_count" widget="statinfo" string="API Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tham số">
                            <field name="rate_date"/>
                            <field name="source_updated_at"/>
                        </group>
                        <group string="Kết quả API">
                            <field name="fetched_at"/>
                            <field name="message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tỷ giá realtime" name="rates">
                            <field name="line_ids" readonly="1" nolabel="1">
                                <list string="Tỷ giá" create="false" delete="false" decoration-info="currency_code == 'USD'">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="currency_code"/>
                                    <field name="currency_name"/>
                                    <field name="cash"/>
                                    <field name="transfer"/>
                                    <field name="sell"/>
                                </list>
                            </field>
                        </page>
                        <page string="Response JSON" name="response">
                            <field name="response_payload" nolabel="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ps_currency_exchange_rate_search" model="ir.ui.view">
        <field name="name">ps.currency.exchange.rate.search</field>
        <field name="model">ps.currency.exchange.rate</field>
        <field name="arch" type="xml">
            <search string="Tìm tỷ giá">
                <field name="name"/>
                <field name="rate_date"/>
                <filter string="Thành công" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Thất bại" name="failed" domain="[('status', '=', 'failed')]"/>
                <group>
                    <filter string="Ngày tỷ giá" name="group_by_rate_date" context="{'group_by': 'rate_date'}"/>
                    <filter string="Kết quả" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ps_currency_exchange_rate" model="ir.actions.act_window">
        <field name="name">Tỷ giá ngoại tệ</field>
        <field name="res_model">ps.currency.exchange.rate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo bảng tỷ giá rồi bấm Lấy tỷ giá realtime để gọi API Vietcombank.
            </p>
        </field>
    </record>
</odoo>
