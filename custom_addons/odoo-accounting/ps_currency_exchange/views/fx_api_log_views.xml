<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ps_currency_exchange_log_list" model="ir.ui.view">
        <field name="name">ps.currency.exchange.log.list</field>
        <field name="model">ps.currency.exchange.log</field>
        <field name="arch" type="xml">
            <list string="Nhật ký API tỷ giá" create="false" edit="false" delete="true"
                  decoration-success="status == 'success'" decoration-danger="status == 'failed'">
                <field name="name"/>
                <field name="create_date" string="Thời gian"/>
                <field name="rate_date"/>
                <field name="rate_id"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
                <field name="execution_time_ms"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_ps_currency_exchange_log_form" model="ir.ui.view">
        <field name="name">ps.currency.exchange.log.form</field>
        <field name="model">ps.currency.exchange.log</field>
        <field name="arch" type="xml">
            <form string="Chi tiết nhật ký API tỷ giá" create="false" edit="false">
                <header>
                    <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="direction"/>
                            <field name="method"/>
                            <field name="endpoint"/>
                            <field name="rate_date"/>
                            <field name="rate_id"/>
                            <field name="create_date" string="Thời gian tạo"/>
                        </group>
                        <group string="Response">
                            <field name="status_code"/>
                            <field name="execution_time_ms"/>
                            <field name="message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request_details">
                            <group string="Headers">
                                <field name="request_headers" nolabel="1" widget="text"/>
                            </group>
                            <group string="Body">
                                <field name="request_payload" nolabel="1" widget="text"/>
                            </group>
                        </page>
                        <page string="Response" name="response_details">
                            <group string="Headers">
                                <field name="response_headers" nolabel="1" widget="text"/>
                            </group>
                            <group string="Body">
                                <field name="response_payload" nolabel="1" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ps_currency_exchange_log_search" model="ir.ui.view">
        <field name="name">ps.currency.exchange.log.search</field>
        <field name="model">ps.currency.exchange.log</field>
        <field name="arch" type="xml">
            <search string="Tìm nhật ký API tỷ giá">
                <field name="name"/>
                <field name="endpoint"/>
                <field name="rate_id"/>
                <filter string="Thành công" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Thất bại" name="failed" domain="[('status', '=', 'failed')]"/>
                <group>
                    <filter string="Kết quả" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Ngày tỷ giá" name="group_by_rate_date" context="{'group_by': 'rate_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ps_currency_exchange_log" model="ir.actions.act_window">
        <field name="name">Nhật ký API tỷ giá</field>
        <field name="res_model">ps.currency.exchange.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
