<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Inherit Form View -->
    <record id="view_account_asset_category_form_inherit_patsoft" model="ir.ui.view">
        <field name="name">account.asset.category.form.inherit.patsoft</field>
        <field name="model">account.asset.category</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_category_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_title')]/*" position="before">
                <label for="code" class="oe_edit_only"/>
                <h1>
                    <field name="code" placeholder="e.g. 001.001.02"/>
                </h1>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group string="Segments">
                    <field name="segment_01_id" domain="[('segment_type_related', '=', 'Segment01')]" />
                    <field name="segment_02_id" domain="[('segment_type_related', '=', 'Segment02')]" />
                    <field name="segment_03_id" domain="[('segment_type_related', '=', 'Segment03')]" />
                </group>
            </xpath>

            <xpath expr="//field[@name='account_depreciation_id']" position="after">
                <field name="ps_account_counterpart_id"/>
                <field name="account_other_income_id"/>
                <field name="account_other_expense_id"/>
            </xpath>


            <xpath expr="//field[@name='account_depreciation_expense_id']" position="after">
                <field name="analytic_plan_id"/>
                <field name="ps_account_evaluation_id"/>
            </xpath>


            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="string">Unit Code</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_category_tree_inherit_patsoft" model="ir.ui.view">
        <field name="name">account.asset.category.tree.inherit.patsoft</field>
        <field name="model">account.asset.category</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_category_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="code" string="Group Code"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="account_asset_id" string="Asset Account"/>
                <field name="account_depreciation_id" string="Depreciation Account"/>
                <field name="ps_account_counterpart_id" string="Counterpart Account"/>
                <field name="account_depreciation_expense_id" string="Expense Account"/>
                <field name="account_other_income_id" string="Other Income Account"/>
                <field name="account_other_expense_id" string="Other Expense Account"/>
                <field name="analytic_plan_id" string="Expense Item"/>
            </xpath>
        </field>
    </record>

    <record id="action_ps_asset_group" model="ir.actions.act_window">
        <field name="name">Asset Group</field>
        <field name="res_model">account.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>