<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_ps_asset_segment_form" model="ir.ui.view">
        <field name="name">ps.asset.segment.form</field>
        <field name="model">ps.asset.segment</field>
        <field name="arch" type="xml">
            <form string="Asset Segment" create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="segment_type"/>
                        </group>
                        <group>
                            <field name="width"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Segment Values">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_ps_asset_segment_list" model="ir.ui.view">
        <field name="name">ps.asset.segment.list</field>
        <field name="model">ps.asset.segment</field>
        <field name="arch" type="xml">
           <list string="Asset Segment" create="0" delete="0">
                <field name="segment_type"/>
                <field name="width"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ps_asset_segment" model="ir.actions.act_window">
        <field name="name">Asset Segment</field>
        <field name="res_model">ps.asset.segment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- List View cho Popup Tìm kiếm Segment Line -->
    <record id="view_ps_asset_segment_line_list" model="ir.ui.view">
        <field name="name">ps.asset.segment.line.list</field>
        <field name="model">ps.asset.segment.line</field>
        <field name="arch" type="xml">
            <list string="Segment Values">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>