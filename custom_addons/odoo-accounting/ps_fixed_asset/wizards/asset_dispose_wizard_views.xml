<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ps_asset_dispose_wizard_form" model="ir.ui.view">
        <field name="name">ps.asset.dispose.wizard.form</field>
        <field name="model">ps.asset.dispose.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel / Dispose / Sell">
                <sheet>
                    <field name="asset_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="ps_code"/>
                            <field name="dispose_date" required="1"/>
                            <field name="notes"/>
                            <field name="change_type" required="1"/>
                            <field name="status" required="1"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="receipt_number"/>
                            <field name="invoice_number"/>
                            <field name="department_id"/>
                            <field name="counterpart_account_id" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ps_asset_dispose_wizard" model="ir.actions.act_window">
        <field name="name">Cancel / Dispose / Sell</field>
        <field name="res_model">ps.asset.dispose.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_asset_id': active_id}</field>
    </record>
</odoo>